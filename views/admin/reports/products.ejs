<%- include("../layouts/header", { title: "Product Report" }) %>

    <%- include("../layouts/navbar") %>

        <%- include("../layouts/sidebar") %>
            <div class="content-body">
                <div class="container-fluid p-4">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <h3>Product Report</h3>

                        <div>
                            <a href="/admin/reports/dashboard" class="btn btn-danger me-2">
                                <i class="fas fa-arrow-left"></i> Report Dashboard
                            </a>
                            <button onclick="window.print()" class="btn btn-primary">

                                <i class="fas fa-print"></i>

                                Print Report

                            </button>
                        </div>
                    </div>

                    <div class="card shadow">

                        <div class="card-body">

                            <table class="table table-bordered table-hover">

                                <thead class="table-dark">

                                    <tr>

                                        <th>#</th>

                                        <th>Image</th>

                                        <th>Product</th>

                                        <th>Category</th>

                                        <th>Brand</th>

                                        <th>Vendor</th>

                                        <th>Price</th>

                                        <th>Stock</th>

                                        <th>Status</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    <% if(products.length> 0){ %>

                                        <% products.forEach((product,index)=>{ %>

                                            <tr>

                                                <td>

                                                    <%= index + 1 %>

                                                </td>

                                                <td>

                                                    <% if(product.thumbnail){ %>

                                                        <img src="<%= product.thumbnail %>" width="60" height="60"
                                                            class="rounded">

                                                        <% }else{ %>

                                                            <img src="/images/no-image.png" width="60" height="60"
                                                                class="rounded">

                                                            <% } %>

                                                </td>

                                                <td>

                                                    <%= product.name %>

                                                </td>

                                                <td>

                                                    <%= product.category ? product.category.name : "-" %>

                                                </td>

                                                <td>

                                                    <%= product.brand ? product.brand.name : "-" %>

                                                </td>

                                                <td>

                                                    <% if(product.vendor){ %>

                                                        <%= product.vendor.storeName || product.vendor.businessName
                                                            || "-" %>

                                                            <% }else{ %>

                                                                -

                                                                <% } %>

                                                </td>

                                                <td>

                                                    ₹ <%= product.price %>

                                                </td>

                                                <td>

                                                    <% if(product.stock <=5){ %>

                                                        <span class="badge bg-danger">

                                                            <%= product.stock %>

                                                        </span>

                                                        <% }else{ %>

                                                            <span class="badge bg-success">

                                                                <%= product.stock %>

                                                            </span>

                                                            <% } %>

                                                </td>

                                                <td>

                                                    <% if(product.status=="Approved" ){ %>

                                                        <span class="badge bg-success">

                                                            Approved

                                                        </span>

                                                        <% }else if(product.status=="Pending" ){ %>

                                                            <span class="badge bg-warning text-dark">

                                                                Pending

                                                            </span>

                                                            <% }else{ %>

                                                                <span class="badge bg-danger">

                                                                    Rejected

                                                                </span>

                                                                <% } %>

                                                </td>

                                            </tr>

                                            <% }) %>

                                                <% }else{ %>

                                                    <tr>

                                                        <td colspan="9" class="text-center">

                                                            No Products Found

                                                        </td>

                                                    </tr>

                                                    <% } %>

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>
            </div>
            <%- include("../layouts/footer") %>

                <%- include("../layouts/scripts") %>