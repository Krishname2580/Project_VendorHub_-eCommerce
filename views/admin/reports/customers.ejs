<%- include("../layouts/header", { title: "Customer Report" }) %>

    <%- include("../layouts/navbar") %>

        <%- include("../layouts/sidebar") %>
            <div class="content-body">
                <div class="container-fluid p-4">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <h3>Customer Report</h3>

                        <div>
                            <a href="/admin/reports/dashboard" class="btn btn-danger me-2">
                                <i class="fas fa-arrow-left"></i> Report Dashboard
                            </a>
                            
                            <button onclick="window.print()" class="btn btn-primary">

                                <i class="fas fa-print"></i>

                                Print Report

                            </button>

                        </div>
                    </div>

                    <div class="card shadow">

                        <div class="card-body">

                            <table class="table table-bordered table-hover">

                                <thead class="table-dark">

                                    <tr>

                                        <th>#</th>

                                        <th>Customer Name</th>

                                        <th>Email</th>

                                        <th>Phone</th>

                                        <th>Total Orders</th>

                                        <th>Total Spent</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    <% if(customers.length> 0){ %>

                                        <% customers.forEach((customer,index)=>{ %>

                                            <tr>

                                                <td>

                                                    <%= index + 1 %>

                                                </td>

                                                <td>

                                                    <%= customer._id ? customer._id.name : "-" %>

                                                </td>

                                                <td>

                                                    <%= customer._id ? customer._id.email : "-" %>

                                                </td>

                                                <td>

                                                    <%= customer._id ? customer._id.phone : "-" %>

                                                </td>

                                                <td>

                                                    <span class="badge bg-primary">

                                                        <%= customer.totalOrders %>

                                                    </span>

                                                </td>

                                                <td>

                                                    <strong>

                                                        ₹ <%= customer.totalSpent %>

                                                    </strong>

                                                </td>

                                            </tr>

                                            <% }) %>

                                                <% } else { %>

                                                    <tr>

                                                        <td colspan="6" class="text-center">

                                                            No Customer Report Available

                                                        </td>

                                                    </tr>

                                                    <% } %>

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>
            </div>
            <%- include("../layouts/footer") %>

                <%- include("../layouts/scripts") %>