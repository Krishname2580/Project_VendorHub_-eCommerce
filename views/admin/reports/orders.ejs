<%- include("../layouts/header", { title: "Order Report" }) %>

    <%- include("../layouts/navbar") %>

        <%- include("../layouts/sidebar") %>
            <div class="content-body">
                <div class="container-fluid p-4">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <h3>Order Report</h3>
                        <div>
                            <a href="/admin/reports/dashboard" class="btn btn-danger me-2">
                                <i class="fas fa-arrow-left"></i> Report Dashboard
                            </a>
                            <button onclick="window.print()" class="btn btn-primary">

                                <i class="fas fa-print"></i>

                                Print Report

                            </button>
                        </div>
                    </div>

                    <div class="card shadow">

                        <div class="card-header">

                            Order Status Summary

                        </div>

                       <div class="card shadow border-0 rounded-4">

    <div class="card-header bg-primary text-white py-3">

        <h5 class="mb-0 fw-bold">
            <i class="fas fa-chart-bar me-2"></i>
            Order Status Summary
        </h5>

    </div>

    <div class="card-body">

        <% let grandOrders = 0; %>
        <% let grandAmount = 0; %>

        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle mb-0">

                <thead class="table-dark">

                    <tr class="text-center">

                        <th>#</th>
                        <th>Order Status</th>
                        <th>Total Orders</th>
                        <th>Total Amount</th>

                    </tr>

                </thead>

                <tbody>

                    <% if (orders && orders.length > 0) { %>

                        <% orders.forEach((item, index) => { %>

                            <% 
                                const orderCount = Number(item.totalOrders || 0);
                                const amount = Number(item.totalAmount || 0);

                                grandOrders += orderCount;
                                grandAmount += amount;
                            %>

                            <tr>

                                <td class="text-center fw-semibold">
                                    <%= index + 1 %>
                                </td>

                                <td class="text-center">

                                    <% if (item._id === "Pending") { %>

                                        <span class="badge bg-warning text-dark px-3 py-2">
                                            <i class="fas fa-clock me-1"></i>
                                            Pending
                                        </span>

                                    <% } else if (item._id === "Confirmed") { %>

                                        <span class="badge bg-info px-3 py-2">
                                            <i class="fas fa-check me-1"></i>
                                            Confirmed
                                        </span>

                                    <% } else if (item._id === "Packed") { %>

                                        <span class="badge bg-secondary px-3 py-2">
                                            <i class="fas fa-box me-1"></i>
                                            Packed
                                        </span>

                                    <% } else if (item._id === "Shipped") { %>

                                        <span class="badge bg-primary px-3 py-2">
                                            <i class="fas fa-truck me-1"></i>
                                            Shipped
                                        </span>

                                    <% } else if (item._id === "Delivered") { %>

                                        <span class="badge bg-success px-3 py-2">
                                            <i class="fas fa-check-circle me-1"></i>
                                            Delivered
                                        </span>

                                    <% } else if (item._id === "Cancelled") { %>

                                        <span class="badge bg-danger px-3 py-2">
                                            <i class="fas fa-times-circle me-1"></i>
                                            Cancelled
                                        </span>

                                    <% } else if (item._id === "Returned") { %>

                                        <span class="badge bg-dark px-3 py-2">
                                            <i class="fas fa-undo me-1"></i>
                                            Returned
                                        </span>

                                    <% } else { %>

                                        <span class="badge bg-secondary px-3 py-2">
                                            <%= item._id || "Unknown" %>
                                        </span>

                                    <% } %>

                                </td>

                                <td class="text-center fw-semibold">

                                    <%= orderCount %>

                                </td>

                                <td class="text-end fw-semibold text-success">

                                    ₹ <%= amount.toLocaleString("en-IN", {
                                        minimumFractionDigits: 2,
                                        maximumFractionDigits: 2
                                    }) %>

                                </td>

                            </tr>

                        <% }) %>

                    <% } else { %>

                        <tr>

                            <td colspan="4" class="text-center py-5">

                                <i class="fas fa-file-invoice fa-3x text-muted mb-3"></i>

                                <h5 class="text-muted">
                                    No Order Report Available
                                </h5>

                            </td>

                        </tr>

                    <% } %>

                </tbody>

                <tfoot>

                    <tr class="table-light">

                        <th colspan="2" class="text-end">
                            Grand Total
                        </th>

                        <th class="text-center">

                            <%= grandOrders %>

                        </th>

                        <th class="text-end text-success">

                            ₹ <%= grandAmount.toLocaleString("en-IN", {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            }) %>

                        </th>

                    </tr>

                </tfoot>

            </table>

        </div>

    </div>

</div>
                    </div>

                </div>
            </div>
            <%- include("../layouts/footer") %>

                <%- include("../layouts/scripts") %>