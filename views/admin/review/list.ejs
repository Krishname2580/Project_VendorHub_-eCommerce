<%- include("../layouts/header", { title: "Review Management" }) %>

    <%- include("../layouts/navbar") %>

        <%- include("../layouts/sidebar") %>

            <div class="container-fluid p-4">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <h3>Review Management</h3>

                </div>

                <div class="card shadow">

                    <div class="card-body">

                        <table class="table table-bordered table-hover">

                            <thead class="table-dark">

                                <tr>

                                    <th>#</th>

                                    <th>Customer</th>

                                    <th>Product</th>

                                    <th>Rating</th>

                                    <th>Review</th>

                                    <th>Status</th>

                                    <th>Date</th>

                                    <th width="220">Action</th>

                                </tr>

                            </thead>

                            <tbody>

                                <% if(reviews.length> 0){ %>

                                    <% reviews.forEach((review,index)=>{ %>

                                        <tr>

                                            <td>
                                                <%= index+1 %>
                                            </td>

                                            <td>
                                                <%= review.customer ? review.customer.name : "-" %>
                                            </td>

                                            <td>
                                                <%= review.product ? review.product.name : "-" %>
                                            </td>

                                            <td>

                                                <% for(let i=1;i<=5;i++){ %>

                                                    <% if(i<=review.rating){ %>

                                                        ⭐

                                                        <% }else{ %>

                                                            ☆

                                                            <% } %>

                                                                <% } %>

                                            </td>

                                            <td>

                                                <%= review.review.length>40 ? review.review.substring(0,40)+"..." :
                                                    review.review %>

                                            </td>

                                            <td>

                                                <% if(review.status){ %>

                                                    <span class="badge bg-success">

                                                        Approved

                                                    </span>

                                                    <% }else{ %>

                                                        <span class="badge bg-danger">

                                                            Pending

                                                        </span>

                                                        <% } %>

                                            </td>

                                            <td>

                                                <%= review.createdAt.toLocaleDateString() %>

                                            </td>

                                            <td>

                                                <a href="/admin/review/details/<%= review._id %>"
                                                    class="btn btn-info btn-sm">

                                                    <i class="fas fa-eye"></i>

                                                </a>

                                                <% if(!review.status){ %>

                                                    <a href="/admin/review/approve/<%= review._id %>"
                                                        class="btn btn-success btn-sm">

                                                        <i class="fas fa-check"></i>

                                                    </a>

                                                    <% }else{ %>

                                                        <a href="/admin/review/reject/<%= review._id %>"
                                                            class="btn btn-warning btn-sm">

                                                            <i class="fas fa-times"></i>

                                                        </a>

                                                        <% } %>

                                                            <a href="/admin/review/delete/<%= review._id %>"
                                                                class="btn btn-danger btn-sm"
                                                                onclick="return confirm('Delete this review?')">

                                                                <i class="fas fa-trash"></i>

                                                            </a>

                                            </td>

                                        </tr>

                                        <% }) %>

                                            <% }else{ %>

                                                <tr>

                                                    <td colspan="8" class="text-center">

                                                        No Reviews Found

                                                    </td>

                                                </tr>

                                                <% } %>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

            <%- include("../layouts/footer") %>

                <%- include("../layouts/scripts") %>