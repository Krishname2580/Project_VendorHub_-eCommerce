<%- include("../layouts/header", { title: "Review Details" }) %>

    <%- include("../layouts/navbar") %>

        <%- include("../layouts/sidebar") %>

            <div class="container-fluid p-4">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <h3>Review Details</h3>

                    <a href="/admin/reviews" class="btn btn-secondary">

                        <i class="fas fa-arrow-left"></i>

                        Back

                    </a>

                </div>

                <div class="row">

                    <!-- Customer Details -->

                    <div class="col-md-6">

                        <div class="card shadow mb-4">

                            <div class="card-header bg-primary text-white">

                                Customer Details

                            </div>

                            <div class="card-body">

                                <table class="table table-bordered">

                                    <tr>

                                        <th width="180">

                                            Name

                                        </th>

                                        <td>

                                            <%= review.customer ? review.customer.name : "-" %>

                                        </td>

                                    </tr>

                                    <tr>

                                        <th>

                                            Email

                                        </th>

                                        <td>

                                            <%= review.customer ? review.customer.email : "-" %>

                                        </td>

                                    </tr>

                                    <tr>

                                        <th>

                                            Phone

                                        </th>

                                        <td>

                                            <%= review.customer ? review.customer.phone : "-" %>

                                        </td>

                                    </tr>

                                </table>

                            </div>

                        </div>

                    </div>

                    <!-- Product Details -->

                    <div class="col-md-6">

                        <div class="card shadow mb-4">

                            <div class="card-header bg-success text-white">

                                Product Details

                            </div>

                            <div class="card-body">

                                <table class="table table-bordered">

                                    <tr>

                                        <th width="180">

                                            Product

                                        </th>

                                        <td>

                                            <%= review.product ? review.product.name : "-" %>

                                        </td>

                                    </tr>

                                    <tr>

                                        <th>

                                            Price

                                        </th>

                                        <td>

                                            ₹ <%= review.product ? review.product.price : 0 %>

                                        </td>

                                    </tr>

                                    <tr>

                                        <th>

                                            Stock

                                        </th>

                                        <td>

                                            <%= review.product ? review.product.stock : 0 %>

                                        </td>

                                    </tr>

                                </table>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Review Information -->

                <div class="card shadow mb-4">

                    <div class="card-header bg-info text-white">

                        Review Information

                    </div>

                    <div class="card-body">

                        <table class="table table-bordered">

                            <tr>

                                <th width="220">

                                    Rating

                                </th>

                                <td>

                                    <% for(let i=1;i<=5;i++){ %>

                                        <% if(i<=review.rating){ %>

                                            ⭐

                                            <% }else{ %>

                                                ☆

                                                <% } %>

                                                    <% } %>

                                                        (<%= review.rating %>/5)

                                </td>

                            </tr>

                            <tr>

                                <th>

                                    Review

                                </th>

                                <td>

                                    <%= review.review %>

                                </td>

                            </tr>

                            <tr>

                                <th>

                                    Status

                                </th>

                                <td>

                                    <% if(review.status){ %>

                                        <span class="badge bg-success">

                                            Approved

                                        </span>

                                        <% }else{ %>

                                            <span class="badge bg-warning text-dark">

                                                Pending

                                            </span>

                                            <% } %>

                                </td>

                            </tr>

                            <tr>

                                <th>

                                    Review Date

                                </th>

                                <td>

                                    <%= review.createdAt.toLocaleString() %>

                                </td>

                            </tr>

                            <% if(review.order){ %>

                                <tr>

                                    <th>

                                        Order Number

                                    </th>

                                    <td>

                                        <%= review.order.orderNumber %>

                                    </td>

                                </tr>

                                <% } %>

                        </table>

                    </div>

                </div>

                <!-- Action Buttons -->

                <div class="mb-4">

                    <% if(!review.status){ %>

                        <a href="/admin/review/approve/<%= review._id %>" class="btn btn-success">

                            <i class="fas fa-check"></i>

                            Approve Review

                        </a>

                        <% }else{ %>

                            <a href="/admin/review/reject/<%= review._id %>" class="btn btn-warning">

                                <i class="fas fa-times"></i>

                                Reject Review

                            </a>

                            <% } %>

                                <a href="/admin/review/delete/<%= review._id %>" class="btn btn-danger"
                                    onclick="return confirm('Are you sure you want to delete this review?')">

                                    <i class="fas fa-trash"></i>

                                    Delete

                                </a>

                </div>

            </div>

            <%- include("../layouts/footer") %>

                <%- include("../layouts/scripts") %>