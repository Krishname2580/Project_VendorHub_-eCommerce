<%- include("../layouts/header", { title: "Edit Brand" }) %>

    <%- include("../layouts/navbar") %>

        <%- include("../layouts/sidebar") %>

            <div class="container-fluid p-4">

                <div class="row">

                    <div class="col-md-8 mx-auto">

                        <div class="card shadow">

                            <div class="card-header bg-warning text-dark">

                                <h4 class="mb-0">

                                    Edit Brand

                                </h4>

                            </div>

                            <div class="card-body">

                                <form action="/admin/brand/update/<%= brand._id %>" method="POST"
                                    enctype="multipart/form-data">

                                    <!-- Brand Name -->

                                    <div class="mb-3">

                                        <label class="form-label">

                                            Brand Name

                                        </label>

                                        <input type="text" name="name" class="form-control" value="<%= brand.name %>"
                                            required>

                                    </div>

                                    <!-- Description -->

                                    <div class="mb-3">

                                        <label class="form-label">

                                            Description

                                        </label>

                                        <textarea name="description" rows="4"
                                            class="form-control"><%= brand.description %></textarea>

                                    </div>

                                    <!-- Current Logo -->

                                    <div class="mb-3">

                                        <label class="form-label">

                                            Current Logo

                                        </label>

                                        <br>

                                        <% if(brand.image){ %>

                                            <img id="preview" src="/uploads/brand/<%= brand.image %>"
                                                class="img-thumbnail" width="180">

                                            <% }else{ %>

                                                <img id="preview" src="/images/no-image.png" class="img-thumbnail"
                                                    width="180">

                                                <% } %>

                                    </div>

                                    <!-- Change Logo -->

                                    <div class="mb-3">

                                        <label class="form-label">

                                            Change Logo

                                        </label>

                                        <input type="file" name="image" class="form-control" accept="image/*"
                                            onchange="previewImage(event)">

                                    </div>

                                    <!-- Status -->

                                    <div class="mb-3">

                                        <label class="form-label">

                                            Status

                                        </label>

                                        <select name="status" class="form-select">

                                            <option value="true" <%=brand.status ? "selected" : "" %>>

                                                Active

                                            </option>

                                            <option value="false" <%=!brand.status ? "selected" : "" %>>

                                                Inactive

                                            </option>

                                        </select>

                                    </div>

                                    <!-- Buttons -->

                                    <div class="d-flex justify-content-between">

                                        <a href="/admin/brand/list" class="btn btn-secondary">

                                            <i class="fas fa-arrow-left"></i>

                                            Cancel

                                        </a>

                                        <button type="submit" class="btn btn-warning">

                                            <i class="fas fa-edit"></i>

                                            Update Brand

                                        </button>

                                    </div>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <script>

                function previewImage(event) {

                    document.getElementById("preview").src =
                        URL.createObjectURL(event.target.files[0]);

                }

            </script>

            <%- include("../layouts/footer") %>

                <%- include("../layouts/scripts") %>