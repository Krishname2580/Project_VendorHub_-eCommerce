<%- include("../layouts/header", { title: "Brand List" }) %>

<%- include("../layouts/navbar") %>

<%- include("../layouts/sidebar") %>

<div class="content-body">

    <div class="container-fluid py-4">

        <!-- ================= PAGE HEADER ================= -->

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <h2 class="fw-bold mb-1">
                    <i class="bi bi-tags-fill text-primary me-2"></i>
                    Brand Management
                </h2>

                <p class="text-muted mb-0">
                    Manage all product brands from one place
                </p>
            </div>

            <a href="/admin/brand/add"
               class="btn btn-primary px-4 shadow-sm">

                <i class="bi bi-plus-lg me-1"></i>
                Add Brand

            </a>

        </div>


        <!-- ================= BRAND CARD ================= -->

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">


            <!-- ================= CARD HEADER ================= -->

            <div class="card-header bg-white border-0 p-4">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <h5 class="fw-bold mb-1">

                            <i class="bi bi-list-ul text-primary me-2"></i>

                            Brand List

                        </h5>

                        <small class="text-muted">

                            View and manage all available brands

                        </small>

                    </div>


                    <!-- Brand Count -->

                    <span class="badge bg-primary rounded-pill px-3 py-2">

                        <i class="bi bi-tags me-1"></i>

                        <%= brands ? brands.length : 0 %> Brands

                    </span>

                </div>

            </div>


            <!-- ================= TABLE ================= -->

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0 brand-table">


                        <!-- ================= TABLE HEADER ================= -->

                        <thead>

                            <tr>

                                <th class="text-center" style="width:70px;">
                                    #
                                </th>

                                <th class="text-center" style="width:110px;">
                                    Image
                                </th>

                                <th>
                                    Brand Name
                                </th>

                                <th>
                                    Description
                                </th>

                                <th class="text-center" style="width:120px;">
                                    Status
                                </th>

                                <th class="text-center" style="width:150px;">
                                    Created
                                </th>

                                <th class="text-center" style="width:230px;">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <!-- ================= TABLE BODY ================= -->

                        <tbody>

                            <% if (brands && brands.length > 0) { %>


                                <% brands.forEach((brand, index) => { %>

                                    <tr>


                                        <!-- NUMBER -->

                                        <td class="text-center">

                                            <span class="fw-bold text-muted">

                                                <%= index + 1 %>

                                            </span>

                                        </td>


                                        <!-- IMAGE -->

                                        <td class="text-center">

                                            <% if (brand.image) { %>

                                                <img
                                                    src="<%= brand.image %>"
                                                    width="55"
                                                    height="55"
                                                    class="rounded-circle brand-image"
                                                    style="object-fit:cover;"
                                                    alt="<%= brand.name %>"
                                                    onerror="this.src='/images/auth/default-product.png'"
                                                >

                                            <% } else { %>

                                                <img
                                                    src="/images/auth/default-product.png"
                                                    width="55"
                                                    height="55"
                                                    class="rounded-circle brand-image"
                                                    style="object-fit:cover;"
                                                    alt="No Image"
                                                >

                                            <% } %>

                                        </td>


                                        <!-- BRAND NAME -->

                                        <td>

                                            <div class="d-flex align-items-center">

                                                <div class="brand-icon me-3">

                                                    <i class="bi bi-bookmark-star-fill"></i>

                                                </div>

                                                <div>

                                                    <h6 class="mb-0 fw-semibold">

                                                        <%= brand.name %>

                                                    </h6>

                                                    <small class="text-muted">

                                                        Brand

                                                    </small>

                                                </div>

                                            </div>

                                        </td>


                                        <!-- DESCRIPTION -->

                                        <td>

                                            <div
                                                class="text-muted"
                                                style="max-width:280px;"
                                            >

                                                <%= brand.description || "No description available" %>

                                            </div>

                                        </td>


                                        <!-- STATUS -->

                                        <td class="text-center">

                                            <% if (brand.status) { %>

                                                <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">

                                                    <i class="bi bi-check-circle-fill me-1"></i>

                                                    Active

                                                </span>

                                            <% } else { %>

                                                <span class="badge rounded-pill bg-danger-subtle text-danger px-3 py-2">

                                                    <i class="bi bi-x-circle-fill me-1"></i>

                                                    Inactive

                                                </span>

                                            <% } %>

                                        </td>


                                        <!-- CREATED DATE -->

                                        <td class="text-center">

                                            <% if (brand.createdAt) { %>

                                                <div>

                                                    <span class="fw-semibold">

                                                        <%= new Date(brand.createdAt).toLocaleDateString("en-IN") %>

                                                    </span>

                                                </div>

                                                <small class="text-muted">

                                                    <%= new Date(brand.createdAt).toLocaleTimeString("en-IN", {
                                                        hour: "2-digit",
                                                        minute: "2-digit"
                                                    }) %>

                                                </small>

                                            <% } else { %>

                                                <span class="text-muted">
                                                    N/A
                                                </span>

                                            <% } %>

                                        </td>


                                        <!-- ================= ACTIONS ================= -->

                                        <td class="text-center">

                                            <div class="d-flex justify-content-center gap-1">


                                                <!-- VIEW -->

                                                <a
                                                    href="/admin/brand/details/<%= brand._id %>"
                                                    class="btn btn-sm btn-outline-info action-btn"
                                                    title="View Brand"
                                                >

                                                    <i class="bi bi-eye-fill"></i>

                                                </a>


                                                <!-- EDIT -->

                                                <a
                                                    href="/admin/brand/edit/<%= brand._id %>"
                                                    class="btn btn-sm btn-outline-warning action-btn"
                                                    title="Edit Brand"
                                                >

                                                    <i class="bi bi-pencil-fill"></i>

                                                </a>


                                                <!-- STATUS -->

                                                <a
                                                    href="/admin/brand/change-status/<%= brand._id %>"
                                                    class="btn btn-sm btn-outline-secondary action-btn"
                                                    title="Change Status"
                                                >

                                                    <i class="bi bi-toggle-on"></i>

                                                </a>


                                                <!-- DELETE -->

                                                <a
                                                    href="/admin/brand/delete/<%= brand._id %>"
                                                    class="btn btn-sm btn-outline-danger action-btn"
                                                    title="Delete Brand"
                                                    onclick="return confirm('Are you sure you want to delete this brand?')"
                                                >

                                                    <i class="bi bi-trash3-fill"></i>

                                                </a>

                                            </div>

                                        </td>

                                    </tr>

                                <% }) %>


                            <% } else { %>


                                <!-- ================= NO DATA ================= -->

                                <tr>

                                    <td colspan="7">

                                        <div class="text-center py-5">

                                            <div class="mb-3">

                                                <i class="bi bi-tags fs-1 text-muted"></i>

                                            </div>

                                            <h5 class="fw-semibold text-muted">

                                                No Brands Found

                                            </h5>

                                            <p class="text-muted mb-3">

                                                You haven't added any brands yet.

                                            </p>

                                            <a
                                                href="/admin/brand/add"
                                                class="btn btn-primary"
                                            >

                                                <i class="bi bi-plus-lg me-1"></i>

                                                Add First Brand

                                            </a>

                                        </div>

                                    </td>

                                </tr>


                            <% } %>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- CUSTOM TABLE CSS -->
<!-- ========================================================= -->

<style>

    /* ================= TABLE ================= */

    .brand-table {
        border-collapse: separate;
        border-spacing: 0;
    }


    /* ================= TABLE HEADER ================= */

    .brand-table thead {
        background: #212529 !important;
    }

    .brand-table thead tr {
        background: #212529 !important;
    }

    .brand-table thead th {
        background: #212529 !important;
        color: #ffffff !important;
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        padding: 16px 14px;
        border: none !important;
        white-space: nowrap;
    }


    /* ================= TABLE BODY ================= */

    .brand-table tbody td {
        padding: 16px 14px;
        border-bottom: 1px solid #eeeeee;
        vertical-align: middle;
    }


    .brand-table tbody tr:last-child td {
        border-bottom: none;
    }


    /* ================= HOVER ================= */

    .brand-table tbody tr {
        transition: all 0.2s ease;
    }

    .brand-table tbody tr:hover {
        background-color: #f8f9fa;
    }


    /* ================= BRAND IMAGE ================= */

    .brand-image {
        border: 2px solid #f1f1f1;
        padding: 2px;
        background: #ffffff;
    }


    /* ================= BRAND ICON ================= */

    .brand-icon {

        width: 38px;
        height: 38px;

        display: flex;

        align-items: center;

        justify-content: center;

        border-radius: 10px;

        background: rgba(13, 110, 253, 0.1);

        color: #0d6efd;

        font-size: 17px;

    }


    /* ================= ACTION BUTTON ================= */

    .action-btn {

        width: 34px;
        height: 34px;

        display: inline-flex;

        align-items: center;

        justify-content: center;

        border-radius: 7px;

        transition: all 0.2s ease;

    }


    .action-btn:hover {

        transform: translateY(-2px);

    }


    /* ================= STATUS ================= */

    .bg-success-subtle {

        background-color: rgba(25, 135, 84, 0.12) !important;

    }


    .bg-danger-subtle {

        background-color: rgba(220, 53, 69, 0.12) !important;

    }


    /* ================= RESPONSIVE ================= */

    @media (max-width: 768px) {

        .brand-table thead th {

            font-size: 11px;

            padding: 12px 8px;

        }

        .brand-table tbody td {

            padding: 12px 8px;

        }

    }

</style>


<!-- ========================================================= -->
<!-- BOOTSTRAP ICONS -->
<!-- ========================================================= -->

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
>


<%- include("../layouts/footer") %>

<%- include("../layouts/scripts") %>