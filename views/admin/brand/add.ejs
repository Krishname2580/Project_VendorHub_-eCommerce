<%- include("../layouts/header", { title: "Add Brand" }) %>

    <%- include("../layouts/navbar") %>

        <%- include("../layouts/sidebar") %>

            <div class="content-body">
                <div class="main-content">

                    <div class="container-fluid">

                        <!-- Heading -->
                        <div class="page-header mb-4">

                            <div>

                                <h2 class="fw-bold">

                                    <i class="ti-tag text-primary mr-2"></i>

                                    Add New Brand

                                </h2>

                                <p class="text-muted">

                                    Create a new brand for your marketplace.

                                </p>

                            </div>

                            <a href="/admin/brand/list" class="btn btn-outline-primary">

                                <i class="ti-arrow-left mr-2"></i>

                                Back to Brand List

                            </a>

                        </div>


                        <!-- Form -->
                        <form action="/admin/brand/create" method="POST" enctype="multipart/form-data">

                            <div class="row">

                                <!-- LEFT SIDE -->
                                <div class="col-lg-8">

                                    <div class="card border-0 shadow-lg rounded-4 mb-4">

                                        <div class="card-header add-header">

                                            <h4 class="mb-0">

                                                <i class="ti-pencil mr-2"></i>

                                                Brand Information

                                            </h4>

                                        </div>


                                        <div class="card-body p-4">

                                            <!-- Brand Name -->
                                            <div class="mb-4">

                                                <label class="form-label fw-semibold">

                                                    Brand Name

                                                </label>

                                                <input type="text" name="name" class="form-control form-control-lg"
                                                    placeholder="Example : Nike" required>

                                            </div>


                                            <!-- Description -->
                                            <div class="mb-4">

                                                <label class="form-label fw-semibold">

                                                    Description

                                                </label>

                                                <textarea name="description" rows="6" class="form-control"
                                                    placeholder="Write brand description..."></textarea>

                                            </div>


                                            <!-- Status -->
                                            <div class="mb-3">

                                                <label class="form-label fw-semibold">

                                                    Status

                                                </label>

                                                <select name="status" class="form-control form-control-lg">

                                                    <option value="true">

                                                        Active

                                                    </option>

                                                    <option value="false">

                                                        Inactive

                                                    </option>

                                                </select>

                                            </div>

                                        </div>

                                    </div>

                                </div>


                                <!-- RIGHT SIDE -->
                                <div class="col-lg-4">

                                    <div class="card border-0 shadow-lg rounded-4">

                                        <div class="card-header upload-header">

                                            <h5 class="mb-0">

                                                <i class="ti-image mr-2"></i>

                                                Brand Logo

                                            </h5>

                                        </div>


                                        <div class="card-body text-center p-4">

                                            <!-- Preview -->
                                            <img src="/images/no-image.png" id="preview" class="preview-img mb-4"
                                                alt="Brand Preview">


                                            <!-- Upload Box -->
                                            <label class="upload-box d-block">

                                                <i class="ti-cloud-up" style="font-size:45px;" class="text-primary"></i>

                                                <h6 class="mt-3">

                                                    Select Brand Logo

                                                </h6>

                                                <p class="text-muted">

                                                    PNG, JPG, WEBP

                                                </p>

                                                <input type="file" name="image" accept="image/*" hidden
                                                    onchange="previewImage(event)">

                                            </label>


                                            <hr>


                                            <!-- Save Button -->
                                            <button type="submit" class="btn btn-primary w-100 py-3">

                                                <i class="ti-save mr-2"></i>

                                                Save Brand

                                            </button>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </form>

                    </div>

                </div>
            </div>


            <!-- Image Preview Script -->
            <script>

                function previewImage(event) {

                    const file = event.target.files[0];

                    if (!file) {
                        return;
                    }

                    const preview = document.getElementById("preview");

                    preview.src = URL.createObjectURL(file);

                }

            </script>


            <%- include("../layouts/footer") %>

                <%- include("../layouts/scripts") %>