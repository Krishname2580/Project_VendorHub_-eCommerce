<!-- =========================================
     HEADER / NAVBAR
========================================= -->

<div class="header-content">

    <nav class="navbar navbar-expand">

        <div class="collapse navbar-collapse justify-content-between">

            <!-- =====================================
                 LEFT SIDE
            ====================================== -->

            <div class="header-left d-flex align-items-center">

                <!-- Sidebar Toggle -->
                <button type="button"
                        id="sidebarToggle"
                        class="sidebar-toggle-btn"
                        title="Toggle Sidebar">

                    <i class="fas fa-bars"></i>

                </button>


                <!-- Search -->
                <div class="input-group icons">

                    <input type="search"
                           id="dashboardSearch"
                           class="form-control"
                           placeholder="Search Dashboard"
                           autocomplete="off">

                    <span class="input-group-text">

                        <i class="fas fa-search"></i>

                    </span>

                </div>

            </div>


            <!-- =====================================
                 RIGHT SIDE
            ====================================== -->

            <ul class="navbar-nav header-right">


                <!-- =================================
                     NOTIFICATION
                ================================== -->

                <li class="nav-item notification_dropdown">

                    <a href="/admin/notification/list"
                       class="nav-link notification-link"
                       title="Notifications">

                        <i class="fa-solid fa-bell"></i>


                        <!-- Notification Count -->

                        <span id="notificationBadge"
                              class="notification-badge"
                              style="display:none;">

                            0

                        </span>

                    </a>

                </li>


                <!-- =================================
                     ADMIN PROFILE
                ================================== -->

                <li class="nav-item dropdown header-profile">

                    <a class="nav-link"
                       href="#"
                       data-toggle="dropdown"
                       aria-expanded="false">


                        <!-- Admin Image -->

                        <img src="<%= admin && admin.image
                            ? admin.image
                            : '/admin/images/avatar/1.jpg' %>"
                             width="40"
                             height="40"
                             class="rounded-circle"
                             alt="Admin">


                        <!-- Admin Name -->

                        <span class="ml-2">

                            <%= admin ? admin.name : "Admin" %>

                        </span>


                        <i class="fa fa-angle-down ml-2"></i>

                    </a>


                    <!-- Profile Dropdown -->

                    <div class="dropdown-menu dropdown-menu-right">


                        <!-- Profile -->

                        <a href="/admin/profile"
                           class="dropdown-item">

                            <i class="icon-user"></i>

                            <span class="ml-2">

                                Profile

                            </span>

                        </a>


                        <!-- Settings -->

                        <a href="/admin/settings/index"
                           class="dropdown-item">

                            <i class="icon-settings"></i>

                            <span class="ml-2">

                                Settings

                            </span>

                        </a>


                        <!-- Divider -->

                        <div class="dropdown-divider"></div>


                        <!-- Logout -->

                        <a href="/auth/logout"
                           class="dropdown-item text-danger">

                            <i class="icon-key"></i>

                            <span class="ml-2">

                                Logout

                            </span>

                        </a>

                    </div>

                </li>

            </ul>

        </div>

    </nav>

</div>


<!-- =========================================
     NAVBAR CSS
========================================= -->

<style>

/* =========================================
   HEADER
========================================= */

.header-content {

    margin-left: 250px !important;

    width: calc(100% - 250px) !important;

    transition:
        margin-left 0.3s ease,
        width 0.3s ease;

    position: relative;

    z-index: 900;

}


/* =========================================
   HEADER WHEN SIDEBAR CLOSED
========================================= */

.header-content.sidebar-expanded {

    margin-left: 0 !important;

    width: 100% !important;

    max-width: 100% !important;

    left: 0 !important;

    right: 0 !important;

}


/* =========================================
   NAVBAR
========================================= */

.header-content .navbar {

    width: 100% !important;

    min-height: 70px;

}


.header-content .navbar-collapse {

    width: 100%;

}


/* =========================================
   LEFT SECTION
========================================= */

.header-left {

    display: flex;

    align-items: center;

}


/* =========================================
   SIDEBAR TOGGLE
========================================= */

.sidebar-toggle-btn {

    width: 42px;

    height: 42px;

    border: none;

    border-radius: 8px;

    background: #f1f4ff;

    color: #4e73df;

    display: flex;

    align-items: center;

    justify-content: center;

    font-size: 18px;

    margin-right: 15px;

    cursor: pointer;

    transition: all 0.25s ease;

}


.sidebar-toggle-btn:hover {

    background: #4e73df;

    color: #ffffff;

    transform: scale(1.05);

}


.sidebar-toggle-btn:focus {

    outline: none;

    box-shadow: none;

}


/* =========================================
   SEARCH
========================================= */

.header-left .icons {

    width: 300px;

}


.header-left .icons .form-control {

    height: 42px;

    border-radius: 8px 0 0 8px;

    border: 1px solid #e1e5eb;

    box-shadow: none;

}


.header-left .icons .form-control:focus {

    border-color: #4e73df;

    box-shadow: 0 0 0 0.15rem rgba(78, 115, 223, 0.12);

}


.header-left .input-group-text {

    height: 42px;

    background: #ffffff;

    border: 1px solid #e1e5eb;

    border-left: 0;

    color: #7b8190;

}


/* =========================================
   RIGHT SECTION
========================================= */

.header-right {

    display: flex;

    align-items: center;

    margin-left: auto;

}


/* =========================================
   NOTIFICATION
========================================= */

.notification_dropdown {

    display: flex;

    align-items: center;

    margin-right: 8px;

}


.notification-link {

    position: relative;

    width: 45px;

    height: 45px;

    display: flex !important;

    align-items: center;

    justify-content: center;

    border-radius: 12px;

    color: #606770 !important;

    text-decoration: none;

    transition: all 0.25s ease;

}


.notification-link:hover {

    background: #eef3ff;

    color: #4776e6 !important;

}


.notification-link i {

    font-size: 19px;

    transition: 0.25s ease;

}


.notification-link:hover i {

    transform: rotate(8deg);

    color: #4776e6;

}


/* =========================================
   NOTIFICATION BADGE
========================================= */

.notification-badge {

    position: absolute;

    top: 3px;

    right: 2px;

    min-width: 18px;

    height: 18px;

    padding: 0 4px;

    display: flex;

    align-items: center;

    justify-content: center;

    background: #dc3545;

    color: #ffffff;

    border-radius: 50%;

    font-size: 9px;

    font-weight: 700;

    line-height: 1;

    border: 2px solid #ffffff;

}


/* =========================================
   PROFILE
========================================= */

.header-profile {

    display: flex;

    align-items: center;

}


.header-profile .nav-link {

    display: flex;

    align-items: center;

    color: #4c5870;

    text-decoration: none;

}


.header-profile .nav-link:hover {

    color: #4776e6;

}


.header-profile img {

    width: 40px;

    height: 40px;

    object-fit: cover;

    border: 2px solid #eeeeee;

}


.header-profile .fa-angle-down {

    font-size: 12px;

}


/* =========================================
   DROPDOWN
========================================= */

.header-profile .dropdown-menu {

    min-width: 190px;

    border: none;

    border-radius: 10px;

    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);

}


.header-profile .dropdown-item {

    padding: 10px 15px;

    font-size: 14px;

    transition: all 0.2s ease;

}


.header-profile .dropdown-item:hover {

    background: #f2f5ff;

    color: #4776e6;

}


.header-profile .dropdown-item i {

    width: 20px;

}


/* =========================================
   SIDEBAR COLLAPSED
========================================= */

.admin-sidebar.sidebar-collapsed {

    width: 0 !important;

    min-width: 0 !important;

    overflow: hidden !important;

}


/* =========================================
   CONTENT COLLAPSED
========================================= */

.content-body.sidebar-expanded {

    margin-left: 0 !important;

    width: 100% !important;

}


/* =========================================
   MOBILE
========================================= */

@media (max-width: 991px) {

    .header-content {

        margin-left: 230px !important;

        width: calc(100% - 230px) !important;

    }

    .header-left .icons {

        width: 240px;

    }

}


@media (max-width: 767px) {

    .header-content {

        margin-left: 0 !important;

        width: 100% !important;

    }

    .header-left .icons {

        width: 180px;

    }

    .header-profile .ml-2 {

        display: none;

    }

    .header-profile .fa-angle-down {

        display: none;

    }

}


/* =========================================
   PRINT
========================================= */

@media print {

    .header-content {

        display: none !important;

    }

}

</style>


<!-- =========================================
     SIDEBAR TOGGLE JAVASCRIPT
========================================= -->

<script>

document.addEventListener("DOMContentLoaded", function () {

    const toggleButton =
        document.getElementById("sidebarToggle");

    const sidebar =
        document.querySelector(".admin-sidebar");

    const content =
        document.querySelector(".content-body");

    const header =
        document.querySelector(".header-content");


    if (!toggleButton) {

        console.log("Sidebar toggle button not found");

        return;

    }


    toggleButton.addEventListener("click", function () {

        /* Sidebar */

        if (sidebar) {

            sidebar.classList.toggle("sidebar-collapsed");

        }


        /* Content */

        if (content) {

            content.classList.toggle("sidebar-expanded");

        }


        /* Navbar */

        if (header) {

            header.classList.toggle("sidebar-expanded");

        }

    });

});

</script>