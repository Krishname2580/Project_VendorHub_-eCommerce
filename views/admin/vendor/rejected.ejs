<%- include("../layouts/header", { title: "Rejected Vendors" }) %>

    <%- include("../layouts/navbar") %>

        <%- include("../layouts/sidebar") %>

            <div class="content-body">

                <div class="container-fluid py-4">

                    <!-- Page Heading -->
                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div>

                            <h2 class="fw-bold text-danger">

                                <i class="bi bi-person-x-fill me-2"></i>

                                Rejected Vendors

                            </h2>

                            <p class="text-muted">

                                Vendors rejected by the administrator.

                            </p>

                        </div>


                        <a href="/admin/vendor/list" class="btn btn-primary rounded-pill">

                            <i class="bi bi-arrow-left me-2"></i>

                            Back to Vendor List

                        </a>

                    </div>


                    <!-- Rejected Vendor Card -->
                    <div class="card shadow border-0 rounded-4">

                        <div class="card-header bg-danger text-white py-3">

                            <h5 class="mb-0">

                                <i class="bi bi-person-x-fill me-2"></i>

                                Rejected Vendor List

                            </h5>

                        </div>


                        <div class="card-body">

                            <% if(vendors && vendors.length> 0){ %>

                                <div class="table-responsive">

                                    <table class="table table-hover align-middle">

                                        <thead class="table-dark">

                                            <tr>

                                                <th>#</th>

                                                <th>Vendor</th>

                                                <th>Email</th>

                                                <th>Shop</th>

                                                <th>Phone</th>

                                                <th>Status</th>

                                                <th class="text-center">Action</th>

                                            </tr>

                                        </thead>


                                        <tbody>

                                            <% vendors.forEach((vendor,index)=>{ %>

                                                <tr>

                                                    <!-- Number -->
                                                    <td>

                                                        <strong>
                                                            <%= index + 1 %>
                                                        </strong>

                                                    </td>


                                                    <!-- Vendor -->
                                                    <td>

                                                        <div class="d-flex align-items-center">

                                                            <img src="<%= vendor.user && vendor.user.image ? vendor.user.image : '/images/default-user.png' %>"
                                                                width="55" height="55"
                                                                class="rounded-circle border shadow-sm"
                                                                style="object-fit:cover;">

                                                            <div class="ms-3">

                                                                <h6 class="mb-0">

                                                                    <%= vendor.user ? vendor.user.name : "N/A" %>

                                                                </h6>

                                                                <small class="text-muted">

                                                                    <i class="bi bi-person-badge me-1"></i>

                                                                    Vendor

                                                                </small>

                                                            </div>

                                                        </div>

                                                    </td>


                                                    <!-- Email -->
                                                    <td>

                                                        <% if(vendor.user && vendor.user.email){ %>

                                                            <i class="bi bi-envelope me-1 text-muted"></i>

                                                            <%= vendor.user.email %>

                                                                <% } else { %>

                                                                    N/A

                                                                    <% } %>

                                                    </td>


                                                    <!-- Shop -->
                                                    <td>

                                                        <i class="bi bi-shop me-1 text-muted"></i>

                                                        <%= vendor.shopName || "N/A" %>

                                                    </td>


                                                    <!-- Phone -->
                                                    <td>

                                                        <% if(vendor.user && vendor.user.phone){ %>

                                                            <i class="bi bi-telephone me-1 text-muted"></i>

                                                            <%= vendor.user.phone %>

                                                                <% } else { %>

                                                                    N/A

                                                                    <% } %>

                                                    </td>


                                                    <!-- Status -->
                                                    <td>

                                                        <span class="badge bg-danger px-3 py-2">

                                                            <i class="bi bi-x-circle-fill me-1"></i>

                                                            Rejected

                                                        </span>

                                                    </td>


                                                    <!-- Actions -->
                                                    <td class="text-center">

                                                        <div class="d-flex justify-content-center gap-2">

                                                            <!-- View -->
                                                            <a href="/admin/vendor/details/<%= vendor._id %>"
                                                                class="btn btn-info btn-sm" title="View Vendor">

                                                                <i class="bi bi-eye-fill"></i>

                                                            </a>


                                                            <!-- Approve -->
                                                            <a href="/admin/vendor/approved/<%= vendor._id %>"
                                                                class="btn btn-success btn-sm"
                                                                onclick="return confirm('Approve this vendor?')"
                                                                title="Approve Vendor">

                                                                <i class="bi bi-check-lg"></i>

                                                            </a>

                                                        </div>

                                                    </td>

                                                </tr>

                                                <% }) %>

                                        </tbody>

                                    </table>

                                </div>


                                <% } else { %>


                                    <!-- Empty State -->
                                    <div class="text-center py-5">

                                        <i class="bi bi-person-x-fill text-danger" style="font-size:70px;"></i>

                                        <h4 class="mt-3">

                                            No Rejected Vendors Found

                                        </h4>

                                        <p class="text-muted">

                                            There are currently no rejected vendors.

                                        </p>


                                        <a href="/admin/vendor/list" class="btn btn-primary mt-3 rounded-pill">

                                            <i class="bi bi-arrow-left me-2"></i>

                                            Back to Vendor List

                                        </a>

                                    </div>


                                    <% } %>

                        </div>

                    </div>

                </div>

            </div>


            <%- include("../layouts/footer") %>

                <%- include("../layouts/scripts") %>