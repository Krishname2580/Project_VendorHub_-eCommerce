<%- include("../layouts/header") %>

    <div class="container-fluid mt-4">

        <div class="card shadow border-0">

            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">

                <h4 class="mb-0">
                    <i class="fas fa-store"></i> Vendor Details
                </h4>

                <a href="/admin/vendor/list" class="btn btn-light btn-sm">
                    <i class="fas fa-arrow-left"></i> Back
                </a>

            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-4 text-center">

                        <img src="<%= vendor.user.image ? vendor.user.image : '/images/auth/user.png' %>"
                            class="rounded-circle shadow" style="width:180px;height:180px;object-fit:cover;">

                        <h4 class="mt-3">
                            <%= vendor.user.name %>
                        </h4>

                        <span class="badge
                        <% if(vendor.approvalStatus==='Approved'){ %>
                            bg-success
                        <% }else if(vendor.approvalStatus==='Pending'){ %>
                            bg-warning text-dark
                        <% }else{ %>
                            bg-danger
                        <% } %>">

                            <%= vendor.approvalStatus %>

                        </span>

                    </div>

                    <div class="col-md-8">

                        <table class="table table-bordered">

                            <tr>
                                <th width="35%">Vendor Name</th>
                                <td>
                                    <%= vendor.user.name %>
                                </td>
                            </tr>

                            <tr>
                                <th>Email</th>
                                <td>
                                    <%= vendor.user.email %>
                                </td>
                            </tr>

                            <tr>
                                <th>Phone</th>
                                <td>
                                    <%= vendor.user.phone %>
                                </td>
                            </tr>

                            <tr>
                                <th>Role</th>
                                <td>
                                    <%= vendor.user.role.roleName %>
                                </td>
                            </tr>

                            <tr>
                                <th>Approval Status</th>
                                <td>
                                    <%= vendor.approvalStatus %>
                                </td>
                            </tr>

                            <tr>
                                <th>Account Status</th>
                                <td>
                                    <%= vendor.status ? "Active" : "Inactive" %>
                                </td>
                            </tr>

                            <tr>
                                <th>Commission</th>
                                <td>
                                    <%= vendor.commission %> %
                                </td>
                            </tr>

                            <tr>
                                <th>Wallet Balance</th>
                                <td>
                                    ₹ <%= vendor.walletBalance %>
                                </td>
                            </tr>

                            <tr>
                                <th>Registered On</th>
                                <td>
                                    <%= vendor.createdAt.toDateString() %>
                                </td>
                            </tr>

                        </table>

                        <div class="mt-4">

                            <% if(vendor.approvalStatus==="Pending" ){ %>

                                <a href="/admin/vendor/approved/<%= vendor._id %>" class="btn btn-success">

                                    <i class="fas fa-check"></i>
                                    Approve

                                </a>

                                <a href="/admin/vendor/rejected/<%= vendor._id %>" class="btn btn-danger">

                                    <i class="fas fa-times"></i>
                                    Reject

                                </a>

                                <% } %>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <%- include("../layouts/footer") %>