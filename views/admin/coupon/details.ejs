<%- include("../layouts/header", { title: "Coupon Details" }) %>

    <%- include("../layouts/navbar") %>

        <%- include("../layouts/sidebar") %>

            <div class="container-fluid p-4">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <h3>Coupon Details</h3>

                    <a href="/admin/coupon/list" class="btn btn-secondary">

                        <i class="fas fa-arrow-left"></i>

                        Back

                    </a>

                </div>

                <div class="card shadow">

                    <div class="card-header bg-info text-white">

                        Coupon Information

                    </div>

                    <div class="card-body">

                        <table class="table table-bordered">

                            <tr>

                                <th width="250">

                                    Coupon Code

                                </th>

                                <td>

                                    <strong>
                                        <%= coupon.code %>
                                    </strong>

                                </td>

                            </tr>

                            <tr>

                                <th>

                                    Discount Type

                                </th>

                                <td>

                                    <%= coupon.discountType %>

                                </td>

                            </tr>

                            <tr>

                                <th>

                                    Discount Value

                                </th>

                                <td>

                                    <%= coupon.discount %>

                                        <%= coupon.discountType=="Percentage" ? "%" : "₹" %>

                                </td>

                            </tr>

                            <tr>

                                <th>

                                    Minimum Order Amount

                                </th>

                                <td>

                                    ₹ <%= coupon.minimumOrderAmount %>

                                </td>

                            </tr>

                            <tr>

                                <th>

                                    Maximum Discount

                                </th>

                                <td>

                                    ₹ <%= coupon.maximumDiscount %>

                                </td>

                            </tr>

                            <tr>

                                <th>

                                    Expiry Date

                                </th>

                                <td>

                                    <%= new Date(coupon.expiryDate).toLocaleDateString() %>

                                </td>

                            </tr>

                            <tr>

                                <th>

                                    Status

                                </th>

                                <td>

                                    <% if(coupon.isActive){ %>

                                        <span class="badge bg-success">

                                            Active

                                        </span>

                                        <% }else{ %>

                                            <span class="badge bg-danger">

                                                Inactive

                                            </span>

                                            <% } %>

                                </td>

                            </tr>

                            <tr>

                                <th>

                                    Created On

                                </th>

                                <td>

                                    <%= coupon.createdAt.toLocaleString() %>

                                </td>

                            </tr>

                            <tr>

                                <th>

                                    Last Updated

                                </th>

                                <td>

                                    <%= coupon.updatedAt.toLocaleString() %>

                                </td>

                            </tr>

                        </table>

                    </div>

                </div>

                <div class="mt-3">

                    <a href="/admin/coupon/edit/<%= coupon._id %>" class="btn btn-warning">

                        <i class="fas fa-edit"></i>

                        Edit Coupon

                    </a>

                    <a href="/admin/coupon/list" class="btn btn-secondary">

                        Back to List

                    </a>

                </div>

            </div>

            <%- include("../layouts/footer") %>

                <%- include("../layouts/scripts") %>