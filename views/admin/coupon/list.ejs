<%- include("../layouts/header", { title: "Coupon List" }) %>

    <%- include("../layouts/navbar") %>

        <%- include("../layouts/sidebar") %>
            <div class="content-body">

                <div class="main-content">

                    <div class="container-fluid py-4">

                        <div class="d-flex justify-content-between align-items-center mb-4">

                            <div>
                                <h2 class="fw-bold">
                                    <i class="fas fa-tags text-primary me-2"></i>
                                    Coupon Management
                                </h2>
                                <p class="text-muted mb-0">
                                    Manage all discount coupons.
                                </p>
                            </div>

                            <a href="/admin/coupon/add" class="btn btn-primary">
                                <i class="fas fa-plus"></i>
                                Add Coupon
                            </a>

                        </div>

                        <div class="card shadow border-0">

                            <div class="card-header bg-primary text-white">

                                <h5 class="mb-0">
                                    Coupon List
                                </h5>

                            </div>

                            <div class="card-body">

                                <% if(coupons && coupons.length> 0){ %>

                                    <div class="table-responsive">

                                        <table class="table table-bordered table-hover align-middle">

                                            <thead class="table-dark">

                                                <tr>

                                                    <th>#</th>

                                                    <th>Code</th>

                                                    <th>Title</th>

                                                    <th>Type</th>

                                                    <th>Discount</th>

                                                    <th>Minimum Purchase</th>

                                                    <th>Maximum Discount</th>

                                                    <th>Usage</th>

                                                    <th>Expiry</th>

                                                    <th>Status</th>

                                                    <th width="180">Action</th>

                                                </tr>

                                            </thead>

                                            <tbody>

                                                <% coupons.forEach((coupon,index)=>{ %>

                                                    <tr>

                                                        <td>
                                                            <%= index+1 %>
                                                        </td>

                                                        <td>
                                                            <strong>
                                                                <%= coupon.code %>
                                                            </strong>
                                                        </td>

                                                        <td>
                                                            <%= coupon.title %>
                                                        </td>

                                                        <td>

                                                            <% if(coupon.discountType=="Flat" ){ %>

                                                                <span class="badge bg-success">

                                                                    Flat

                                                                </span>

                                                                <% }else{ %>

                                                                    <span class="badge bg-info">

                                                                        Percentage

                                                                    </span>

                                                                    <% } %>

                                                        </td>

                                                        <td>

                                                            <% if(coupon.discountType=="Flat" ){ %>

                                                                ₹ <%= coupon.discountValue %>

                                                                    <% }else{ %>

                                                                        <%= coupon.discountValue %> %

                                                                            <% } %>

                                                        </td>

                                                        <td>

                                                            ₹ <%= coupon.minimumPurchase %>

                                                        </td>

                                                        <td>

                                                            ₹ <%= coupon.maximumDiscount %>

                                                        </td>

                                                        <td>

                                                            <%= coupon.usedCount %> / <%= coupon.usageLimit %>

                                                        </td>

                                                        <td>

                                                            <%= new Date(coupon.expiryDate).toLocaleDateString() %>

                                                        </td>

                                                        <td>

                                                            <% if(coupon.status){ %>

                                                                <span class="badge bg-success">

                                                                    Active

                                                                </span>

                                                                <% }else{ %>

                                                                    <span class="badge bg-danger">

                                                                        Inactive

                                                                    </span>

                                                                    <% } %>

                                                        </td>

                                                        <td>

                                                            <a href="/admin/coupon/edit/<%= coupon._id %>"
                                                                class="btn btn-warning btn-sm">

                                                                <i class="fas fa-edit"></i>

                                                            </a>

                                                            <a href="/admin/coupon/status/<%= coupon._id %>"
                                                                class="btn btn-secondary btn-sm">

                                                                <i class="fas fa-sync-alt"></i>

                                                            </a>

                                                            <a href="/admin/coupon/delete/<%= coupon._id %>"
                                                                class="btn btn-danger btn-sm"
                                                                onclick="return confirm('Delete this coupon?')">

                                                                <i class="fas fa-trash"></i>

                                                            </a>

                                                        </td>

                                                    </tr>

                                                    <% }) %>

                                            </tbody>

                                        </table>

                                    </div>

                                    <% }else{ %>

                                        <div class="text-center py-5">

                                            <i class="fas fa-tags fa-5x text-muted mb-3"></i>

                                            <h3>No Coupons Found</h3>

                                            <p class="text-muted">

                                                There are no coupons available.

                                            </p>

                                            <a href="/admin/coupon/add" class="btn btn-primary">

                                                <i class="fas fa-plus"></i>

                                                Add Coupon

                                            </a>

                                        </div>

                                        <% } %>

                            </div>

                        </div>

                    </div>

                </div>
            </div>
            <%- include("../layouts/footer") %>

                <%- include("../layouts/scripts") %>