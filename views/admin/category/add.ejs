<%- include("../layouts/header", { title: "Add Category" }) %>
    <%- include("../layouts/navbar") %>
        <%- include("../layouts/sidebar") %>

            <div class="main-content">

                <div class="container-fluid">

                    <!-- Page Header -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h2 class="fw-bold mb-1">Add New Category</h2>
                            <p class="text-muted mb-0">
                                Create a new product category for your marketplace.
                            </p>
                        </div>

                        <a href="/admin/category/list" class="btn btn-outline-primary">
                            <i class="fas fa-arrow-left me-2"></i>
                            Back to List
                        </a>
                    </div>

                    <!-- Card -->
                    <div class="card border-0 shadow-lg rounded-4">

                        <div class="card-header bg-primary text-white py-3 rounded-top-4">
                            <h4 class="mb-0">
                                <i class="fas fa-folder-plus me-2"></i>
                                Category Information
                            </h4>
                        </div>

                        <div class="card-body p-4">

                            <form action="/admin/category/create" method="POST" enctype="multipart/form-data">

                                <div class="row">

                                    <!-- Left Side -->
                                    <div class="col-lg-8">

                                        <!-- Category Name -->
                                        <div class="mb-4">

                                            <label class="form-label fw-semibold">
                                                Category Name
                                            </label>

                                            <input type="text" name="name" class="form-control form-control-lg"
                                                placeholder="Enter Category Name" required>

                                        </div>

                                        <!-- Description -->

                                        <div class="mb-4">

                                            <label class="form-label fw-semibold">
                                                Description
                                            </label>

                                            <textarea name="description" rows="6" class="form-control"
                                                placeholder="Write category description..."></textarea>

                                        </div>

                                        <!-- Status -->

                                        <div class="mb-4">

                                            <label class="form-label fw-semibold">
                                                Status
                                            </label>

                                            <select name="status" class="form-select form-select-lg">

                                                <option value="true">
                                                    Active
                                                </option>

                                                <option value="false">
                                                    Inactive
                                                </option>

                                            </select>

                                        </div>

                                    </div>

                                    <!-- Right Side -->

                                    <div class="col-lg-4">

                                        <div class="border rounded-4 p-4 text-center bg-light">

                                            <img src="/images/no-image.png" id="preview"
                                                class="img-fluid rounded shadow mb-3"
                                                style="height:220px;object-fit:cover;">

                                            <div class="mb-3">

                                                <input type="file" name="image" class="form-control" accept="image/*"
                                                    onchange="previewImage(event)">

                                            </div>

                                            <small class="text-muted">
                                                JPG, PNG, WEBP supported
                                            </small>

                                        </div>

                                    </div>

                                </div>

                                <hr class="my-4">

                                <div class="d-flex justify-content-end gap-2">

                                    <a href="/admin/category/list" class="btn btn-secondary btn-lg">

                                        Cancel

                                    </a>

                                    <button type="submit" class="btn btn-primary btn-lg">

                                        <i class="fas fa-save me-2"></i>

                                        Save Category

                                    </button>

                                </div>

                            </form>

                        </div>

                    </div>

                </div>

            </div>

            <script>

                function previewImage(event) {

                    const preview = document.getElementById("preview");

                    preview.src = URL.createObjectURL(event.target.files[0]);

                }

            </script>

            <%- include("../layouts/footer") %>
                <%- include("../layouts/scripts") %>