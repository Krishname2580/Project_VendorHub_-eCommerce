<%- include("../layouts/header", { title: "Add Notification" }) %>

    <%- include("../layouts/navbar") %>

        <%- include("../layouts/sidebar") %>

            <div class="main-content">

                <div class="container-fluid py-4">

                    <div class="row justify-content-center">

                        <div class="col-lg-8">

                            <div class="card shadow">

                                <div class="card-header bg-primary text-white">

                                    <h4 class="mb-0">

                                        <i class="fas fa-bell"></i>

                                        Add Notification

                                    </h4>

                                </div>

                                <div class="card-body">

                                    <form action="/admin/notification/create" method="POST">

                                        <div class="mb-3">

                                            <label class="form-label">

                                                Notification Title

                                            </label>

                                            <input type="text" name="title" class="form-control"
                                                placeholder="Enter notification title" required>

                                        </div>

                                        <div class="mb-3">

                                            <label class="form-label">

                                                Notification Message

                                            </label>

                                            <textarea name="message" class="form-control" rows="5"
                                                placeholder="Enter notification message" required></textarea>

                                        </div>

                                        <div class="row">

                                            <div class="col-md-6 mb-3">

                                                <label class="form-label">

                                                    Notification Type

                                                </label>

                                                <select name="type" class="form-select" required>

                                                    <option value="General">

                                                        General

                                                    </option>

                                                    <option value="Order">

                                                        Order

                                                    </option>

                                                    <option value="Offer">

                                                        Offer

                                                    </option>

                                                    <option value="Payment">

                                                        Payment

                                                    </option>

                                                    <option value="System">

                                                        System

                                                    </option>

                                                </select>

                                            </div>

                                            <div class="col-md-6 mb-3">

                                                <label class="form-label">

                                                    Send To

                                                </label>

                                                <select name="user" class="form-select">

                                                    <option value="">

                                                        All Users

                                                    </option>

                                                    <% users.forEach(user=> { %>

                                                        <option value="<%= user._id %>">

                                                            <%= user.name %> (<%= user.email %>)

                                                        </option>

                                                        <% }) %>

                                                </select>

                                            </div>

                                        </div>

                                        <div class="text-end">

                                            <a href="/admin/notification/list" class="btn btn-secondary">

                                                <i class="fas fa-arrow-left"></i>

                                                Back

                                            </a>

                                            <button type="submit" class="btn btn-primary">

                                                <i class="fas fa-save"></i>

                                                Save Notification

                                            </button>

                                        </div>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <%- include("../layouts/footer") %>

                <%- include("../layouts/scripts") %>