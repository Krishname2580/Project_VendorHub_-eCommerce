<%- include("../layouts/header", { title: "Approved Stores" }) %>

    <%- include("../layouts/navbar") %>

        <%- include("../layouts/sidebar") %>


            <div class="main-content">

                <div class="container-fluid">


                    <div class="d-flex justify-content-between align-items-center mb-4">


                        <h2>
                            <i class="fas fa-store text-success"></i>
                            Approved Stores
                        </h2>


                        <a href="/admin/store/list" class="btn btn-secondary">

                            <i class="fas fa-arrow-left"></i>
                            Back

                        </a>


                    </div>



                    <div class="card shadow border-0 rounded-4">


                        <div class="card-header bg-success text-white">

                            <h5 class="mb-0">

                                <i class="fas fa-check-circle"></i>

                                Approved Store List

                            </h5>

                        </div>



                        <div class="card-body">


                            <div class="table-responsive">


                                <table class="table table-hover align-middle">


                                    <thead class="table-dark">

                                        <tr>

                                            <th>#</th>

                                            <th>Store</th>

                                            <th>Vendor</th>

                                            <th>Email</th>

                                            <th>City</th>

                                            <th>Status</th>

                                            <th>Action</th>


                                        </tr>

                                    </thead>



                                    <tbody>


                                        <% if(stores.length> 0){ %>


                                            <% stores.forEach((store,index)=>{ %>


                                                <tr>


                                                    <td>
                                                        <%= index+1 %>
                                                    </td>



                                                    <td>


                                                        <div class="d-flex align-items-center">


                                                            <img src="<%= store.logo 
? '/uploads/stores/'+store.logo 
: '/images/no-image.png' %>" width="50" height="50" class="rounded-circle me-3">


                                                            <strong>

                                                                <%= store.storeName %>

                                                            </strong>


                                                        </div>


                                                    </td>




                                                    <td>

                                                        <%= store.vendor && store.vendor.user ? store.vendor.user.name
                                                            : "N/A" %>


                                                    </td>



                                                    <td>

                                                        <%= store.email || "N/A" %>

                                                    </td>




                                                    <td>

                                                        <%= store.city || "N/A" %>

                                                    </td>




                                                    <td>


                                                        <span class="badge bg-success px-3 py-2">

                                                            Approved

                                                        </span>


                                                    </td>



                                                    <td>


                                                        <a href="/admin/store/details/<%= store._id %>"
                                                            class="btn btn-info btn-sm rounded-circle">

                                                            <i class="fas fa-eye"></i>

                                                        </a>



                                                        <a href="/admin/store/reject/<%= store._id %>"
                                                            class="btn btn-danger btn-sm rounded-circle">

                                                            <i class="fas fa-times"></i>

                                                        </a>


                                                    </td>



                                                </tr>


                                                <% }) %>



                                                    <% } else { %>


                                                        <tr>

                                                            <td colspan="7" class="text-center py-5">


                                                                <img src="/images/no-data.png" width="120">


                                                                <h5 class="text-muted mt-3">

                                                                    No Approved Stores Found

                                                                </h5>


                                                            </td>

                                                        </tr>


                                                        <% } %>


                                    </tbody>


                                </table>


                            </div>


                        </div>


                    </div>


                </div>

            </div>


            <%- include("../layouts/footer") %>

                <%- include("../layouts/scripts") %>