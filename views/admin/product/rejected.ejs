<%- include("../layouts/header", { title: "Rejected Products" }) %>

    <%- include("../layouts/navbar") %>

        <%- include("../layouts/sidebar") %>

            <div class="content-body">

                <div class="container-fluid p-4">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <h2>

                            <i class="fas fa-times-circle text-danger"></i>

                            Rejected Products

                        </h2>

                        <a href="/admin/product/list" class="btn btn-primary">

                            <i class="fas fa-box"></i>

                            All Products

                        </a>

                    </div>

                    <div class="card shadow border-0">

                        <div class="card-body">

                            <div class="table-responsive">

                                <table class="table table-hover align-middle">

                                    <thead class="table-dark">

                                        <tr>

                                            <th>#</th>
                                            <th>Image</th>
                                            <th>Product</th>
                                            <th>Category</th>
                                            <th>Brand</th>
                                            <th>Vendor</th>
                                            <th>Store</th>
                                            <th>Price</th>
                                            <th>Stock</th>
                                            <th>Status</th>
                                            <th>Action</th>

                                        </tr>

                                    </thead>

                                    <tbody>

                                        <% if(products.length){ %>

                                            <% products.forEach((product,index)=>{ %>

                                                <tr>

                                                    <td>
                                                        <%= index+1 %>
                                                    </td>

                                                    <td>

                                                        <% if(product.thumbnail){ %>

                                                            <img src="<%= product.thumbnail %>" width="60" height="60"
                                                                class="rounded shadow" style="object-fit:cover;">

                                                            <% }else{ %>

                                                                <img src="/images/no-image.png" width="60"
                                                                    class="rounded">

                                                                <% } %>

                                                    </td>

                                                    <td>
                                                        <%= product.name %>
                                                    </td>

                                                    <td>
                                                        <%= product.category ? product.category.name : "-" %>
                                                    </td>

                                                    <td>
                                                        <%= product.brand ? product.brand.name : "-" %>
                                                    </td>

                                                    <td>
                                                        <%= product.vendor ? product.vendor.storeName : "-" %>
                                                    </td>

                                                    <td>
                                                        <%= product.store ? product.store.storeName : "-" %>
                                                    </td>

                                                    <td>₹ <%= product.price %>
                                                    </td>

                                                    <td>

                                                        <% if(product.stock <=5){ %>

                                                            <span class="badge bg-danger">
                                                                <%= product.stock %>
                                                            </span>

                                                            <% }else{ %>

                                                                <span class="badge bg-success">
                                                                    <%= product.stock %>
                                                                </span>

                                                                <% } %>

                                                    </td>

                                                    <td>

                                                        <span class="badge bg-danger">

                                                            Rejected

                                                        </span>

                                                    </td>

                                                    <td>

                                                        <a href="/admin/product/details/<%= product._id %>"
                                                            class="btn btn-info btn-sm">

                                                            <i class="fas fa-eye"></i>

                                                        </a>

                                                        <a href="/admin/product/approve/<%= product._id %>"
                                                            class="btn btn-success btn-sm">

                                                            <i class="fas fa-check"></i>

                                                        </a>

                                                        <a href="/admin/product/delete/<%= product._id %>"
                                                            onclick="return confirm('Delete this product?')"
                                                            class="btn btn-danger btn-sm">

                                                            <i class="fas fa-trash"></i>

                                                        </a>

                                                    </td>

                                                </tr>

                                                <% }) %>

                                                    <% }else{ %>

                                                        <tr>

                                                            <td colspan="11" class="text-center py-4">

                                                                No Rejected Products Found

                                                            </td>

                                                        </tr>

                                                        <% } %>

                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <%- include("../layouts/footer") %>

                <%- include("../layouts/scripts") %>