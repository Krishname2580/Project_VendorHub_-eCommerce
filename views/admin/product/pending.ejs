<%- include("../layouts/header", { title: "Pending Products" }) %>

    <%- include("../layouts/navbar") %>

        <%- include("../layouts/sidebar") %>

            <div class="content-body">

                <div class="container-fluid p-4">

                    <!-- PAGE HEADER -->
                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div>

                            <h2 class="mb-1">

                                <i class="fa fa-clock-o text-warning mr-2"></i>

                                Pending Products

                            </h2>

                            <p class="text-muted mb-0">
                                Products waiting for admin approval
                            </p>

                        </div>


                        <a href="/admin/product/list" class="btn btn-primary">

                            <i class="fa fa-cubes mr-2"></i>

                            All Products

                        </a>

                    </div>


                    <!-- TABLE CARD -->

                    <div class="card shadow border-0">

                        <div class="card-body p-4">

                            <div class="table-responsive">

                                <table class="table table-hover align-middle pending-product-table">


                                    <!-- COLUMN WIDTH -->

                                    <colgroup>

                                        <col style="width: 4%;">

                                        <col style="width: 9%;">

                                        <col style="width: 24%;">

                                        <col style="width: 11%;">

                                        <col style="width: 9%;">

                                        <col style="width: 10%;">

                                        <col style="width: 11%;">

                                        <col style="width: 8%;">

                                        <col style="width: 6%;">

                                        <col style="width: 8%;">

                                    </colgroup>


                                    <!-- HEADER -->

                                    <thead class="table-dark">

                                        <tr>

                                            <th class="text-center">
                                                #
                                            </th>


                                            <th class="text-center">

                                                <i class="fa fa-picture-o"></i>

                                                <br>

                                                Image

                                            </th>


                                            <th>

                                                <i class="fa fa-shopping-cart mr-1"></i>

                                                Product

                                            </th>


                                            <th>

                                                <i class="fa fa-th-large mr-1"></i>

                                                Category

                                            </th>


                                            <th>

                                                <i class="fa fa-tag mr-1"></i>

                                                Brand

                                            </th>


                                            <th>

                                                <i class="fa fa-user mr-1"></i>

                                                Vendor

                                            </th>


                                            <th>

                                                <i class="fa fa-home mr-1"></i>

                                                Store

                                            </th>


                                            <th class="text-center">

                                                <i class="fa fa-inr"></i>

                                                <br>

                                                Price

                                            </th>


                                            <th class="text-center">

                                                <i class="fa fa-cubes"></i>

                                                <br>

                                                Stock

                                            </th>


                                            <th class="text-center">

                                                <i class="fa fa-cog"></i>

                                                <br>

                                                Action

                                            </th>

                                        </tr>

                                    </thead>


                                    <!-- BODY -->

                                    <tbody>

                                        <% if(products && products.length> 0){ %>


                                            <% products.forEach((product,index)=>{ %>

                                                <tr>


                                                    <!-- NUMBER -->

                                                    <td class="text-center fw-semibold">

                                                        <%= index + 1 %>

                                                    </td>


                                                    <!-- IMAGE -->

                                                    <td class="text-center">

                                                        <% if(product.thumbnail){ %>

                                                            <img src="<%= product.thumbnail %>"
                                                                alt="<%= product.name %>" class="product-thumb">

                                                            <% } else { %>

                                                                <div class="no-image">

                                                                    <i class="fa fa-picture-o"></i>

                                                                </div>

                                                                <% } %>

                                                    </td>


                                                    <!-- PRODUCT -->

                                                    <td>

                                                        <div class="product-name">

                                                            <%= product.name %>

                                                        </div>

                                                    </td>


                                                    <!-- CATEGORY -->

                                                    <td>

                                                        <span class="text-muted">

                                                            <%= product.category?.name || "-" %>

                                                        </span>

                                                    </td>


                                                    <!-- BRAND -->

                                                    <td>

                                                        <span class="text-muted">

                                                            <%= product.brand?.name || "-" %>

                                                        </span>

                                                    </td>


                                                    <!-- VENDOR -->

                                                    <td>

                                                        <span class="text-muted">

                                                            <%= product.vendor?.storeName || "-" %>

                                                        </span>

                                                    </td>


                                                    <!-- STORE -->

                                                    <td>

                                                        <span class="store-name">

                                                            <%= product.store?.storeName || "-" %>

                                                        </span>

                                                    </td>


                                                    <!-- PRICE -->

                                                    <td class="text-center">

                                                        <span class="price">

                                                            ₹ <%= Number(product.price || 0).toLocaleString("en-IN") %>

                                                        </span>

                                                    </td>


                                                    <!-- STOCK -->

                                                    <td class="text-center">

                                                        <span class="stock-badge">

                                                            <i class="fa fa-cube mr-1"></i>

                                                            <%= product.stock || 0 %>

                                                        </span>

                                                    </td>


                                                    <!-- ACTION -->

                                                    <td class="text-center">

                                                        <div class="action-buttons">


                                                            <!-- VIEW -->

                                                            <a href="/admin/product/details/<%= product._id %>"
                                                                class="btn btn-info btn-sm action-btn"
                                                                title="View Product">

                                                                <i class="fa fa-eye"></i>

                                                            </a>


                                                            <!-- APPROVE -->

                                                            <a href="/admin/product/approve/<%= product._id %>"
                                                                class="btn btn-success btn-sm action-btn"
                                                                title="Approve Product"
                                                                onclick="return confirm('Approve this product?')">

                                                                <i class="fa fa-check"></i>

                                                            </a>


                                                            <!-- REJECT -->

                                                            <a href="/admin/product/reject/<%= product._id %>"
                                                                class="btn btn-danger btn-sm action-btn"
                                                                title="Reject Product"
                                                                onclick="return confirm('Reject this product?')">

                                                                <i class="fa fa-times"></i>

                                                            </a>

                                                        </div>

                                                    </td>

                                                </tr>

                                                <% }) %>


                                                    <% } else { %>


                                                        <!-- NO PRODUCTS -->

                                                        <tr>

                                                            <td colspan="10" class="text-center py-5">

                                                                <div class="empty-state">

                                                                    <i class="fa fa-inbox"></i>

                                                                    <h5 class="mt-3">

                                                                        No Pending Products Found

                                                                    </h5>

                                                                    <p class="text-muted mb-0">

                                                                        There are no products waiting for approval.

                                                                    </p>

                                                                </div>

                                                            </td>

                                                        </tr>


                                                        <% } %>

                                    </tbody>

                                </table>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- TABLE CSS -->

            <style>
                .pending-product-table {

                    width: 100%;

                    table-layout: fixed;

                    margin-bottom: 0;

                }


                .pending-product-table thead th {

                    vertical-align: middle;

                    padding: 14px 10px;

                    font-size: 14px;

                    white-space: nowrap;

                }


                .pending-product-table tbody td {

                    padding: 14px 10px;

                    vertical-align: middle;

                }


                /* PRODUCT IMAGE */

                .product-thumb {

                    width: 64px;

                    height: 64px;

                    object-fit: cover;

                    border-radius: 8px;

                    display: block;

                    margin: auto;

                    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.10);

                }


                /* NO IMAGE */

                .no-image {

                    width: 64px;

                    height: 64px;

                    background: #f5f5f5;

                    border-radius: 8px;

                    display: flex;

                    align-items: center;

                    justify-content: center;

                    margin: auto;

                    color: #999;

                    font-size: 22px;

                }


                /* PRODUCT NAME */

                .product-name {

                    font-weight: 600;

                    color: #5f6f82;

                    line-height: 1.3;

                    word-wrap: break-word;

                    overflow-wrap: break-word;

                }


                /* STORE */

                .store-name {

                    color: #667085;

                    line-height: 1.3;

                    word-wrap: break-word;

                }


                /* PRICE */

                .price {

                    font-weight: 600;

                    color: #4f5d73;

                    white-space: nowrap;

                    font-size: 15px;

                }


                /* STOCK */

                .stock-badge {

                    display: inline-block;

                    background: #ff9b4a;

                    color: #fff;

                    padding: 5px 8px;

                    border-radius: 5px;

                    font-size: 12px;

                    font-weight: 600;

                    white-space: nowrap;

                }


                /* ACTION BUTTONS */

                .action-buttons {

                    display: flex;

                    justify-content: center;

                    align-items: center;

                    gap: 5px;

                }


                .action-btn {

                    width: 34px;

                    height: 34px;

                    padding: 0;

                    display: inline-flex;

                    align-items: center;

                    justify-content: center;

                    border-radius: 5px;

                }


                /* EMPTY */

                .empty-state {

                    padding: 30px;

                    color: #999;

                }


                .empty-state>i {

                    font-size: 45px;

                    color: #bbb;

                }


                /* RESPONSIVE */

                @media (max-width: 1200px) {

                    .pending-product-table {

                        min-width: 1200px;

                    }

                }
            </style>


            <%- include("../layouts/footer") %>

                <%- include("../layouts/scripts") %>