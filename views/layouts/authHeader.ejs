<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <title>

        <%= typeof title !=="undefined" ? title : "VendorHub Authentication" %>

    </title>

    <!-- Bootstrap -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css">

    <!-- Google Font -->

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- Animate CSS -->

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">

    <!-- Custom CSS -->

    <link rel="stylesheet" href="/css/auth.css">

    <style>
        * {

            margin: 0;

            padding: 0;

            box-sizing: border-box;

        }

        body {

            font-family: 'Poppins', sans-serif;

            min-height: 100vh;

            background: linear-gradient(135deg,
                    #A8E063 0%,
                    #8BC34A 40%,
                    #7CB342 70%,
                    #FBC02D 100%);

            overflow-x: hidden;

        }


        .auth-section {

            min-height: 100vh;

            display: flex;

            align-items: center;

            justify-content: center;

            padding: 40px;

        }

        .auth-card {

            border: none;

            border-radius: 25px;

            overflow: hidden;

            backdrop-filter: blur(20px);

            background: rgba(255, 255, 255, .15);

            box-shadow: 0 25px 60px rgba(0, 0, 0, .25);

        }

        .auth-section {

            min-height: 100vh;

            display: flex;

            align-items: center;

            justify-content: center;

            padding: 40px 15px;

        }

        .auth-card {

            border: none;

            border-radius: 20px;

            overflow: hidden;

            box-shadow: 0 10px 35px rgba(0, 0, 0, .15);

        }

        .left-side {

            background: linear-gradient(135deg,
                    #81C784 0%,
                    #66BB6A 40%,
                    #8BC34A 70%,
                    #FFB74D 100%);



            color: #fff;

            display: flex;

            justify-content: center;

            align-items: center;

            flex-direction: column;

            padding: 60px;

            position: relative;

            overflow: hidden;

        }

        .logo-box {

            width: 260px;

            height: 260px;

            border-radius: 30px;

            display: flex;

            justify-content: center;

            align-items: center;

            background: rgba(255, 255, 255, .18);

            backdrop-filter: blur(8px);

            box-shadow: 0 15px 40px rgba(0, 0, 0, .15);

        }

        .left-side::before {

            content: "";

            position: absolute;

            width: 350px;

            height: 350px;

            background: rgba(255, 255, 255, .10);

            border-radius: 50%;

            top: -120px;

            right: -80px;

        }

        .left-side::after {

            content: "";

            position: absolute;

            width: 250px;

            height: 250px;

            background: rgba(255, 255, 255, .08);

            border-radius: 50%;

            bottom: -100px;

            left: -70px;

        }

        .left-side h2 {

            font-size: 38px;

            font-weight: 700;

        }

        .left-side p {

            margin-top: 20px;

            line-height: 30px;

            opacity: .95;

        }

        .left-side img {

            width: 260px;

            margin-bottom: 25px;

            filter: drop-shadow(0 15px 30px rgba(0, 0, 0, .25));

        }

        .left-side h2 {

            font-size: 50px;

            font-weight: 700;

            margin-bottom: 15px;

            color: #ffffff;

            text-shadow: 2px 2px 10px rgba(0, 0, 0, .25);

        }

        .left-side p {

            max-width: 420px;

            text-align: center;

            font-size: 18px;

            line-height: 30px;

            color: #f8f8f8;

        }

        .right-side {

            background: white;

            padding: 55px;

        }

        .form-control:focus,
        .form-select:focus {

            border-color: #66BB6A;

            box-shadow: 0 0 0 .2rem rgba(102, 187, 106, .25);

        }

        .password-toggle {

            background: linear-gradient(135deg,
                    #66BB6A,
                    #43A047);

            color: white;

            border: none;

            cursor: pointer;

        }

        .password-toggle:hover {

            background: linear-gradient(135deg,
                    #4CAF50,
                    #2E7D32);

        }

        .logo {

            font-size: 40px;

            font-weight: 700;

            color: #41b42b;

        }

        .input-group-text {

            background: linear-gradient(135deg,
                    #66BB6A,
                    #43A047);

            color: #fff;

            border: none;

            width: 60px;

            display: flex;

            justify-content: center;

            align-items: center;

            font-size: 18px;

        }

        a {

            color: #43A047;

            font-weight: 600;

        }

        a:hover {

            color: #2E7D32;

        }

        .btn-primary {

            background: linear-gradient(135deg,
                    #66BB6A,
                    #43A047);

            border: none;

            border-radius: 12px;

            font-weight: 600;

        }

        .btn-primary:hover {

            background: linear-gradient(135deg,
                    #4CAF50,
                    #2E7D32);

            transform: translateY(-2px);

        }

        .toast-success {

            background: #43A047 !important;

        }

        .toast-error {

            background: #E53935 !important;

        }

        @media(max-width:991px) {

            .left-side {

                display: none;

            }

        }
    </style>

</head>

<body>

    <section class="auth-section">

        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-10">

                    <div class="card auth-card">

                        <div class="row g-0">

                            <!-- Left Side -->

                            <div class="col-lg-6 left-side">

                                <img src="/images/auth/logo1.png" alt="VendorHub Logo" class="img-fluid"
                                    style="width: 350px; height: auto;">

                                <h2>

                                    VendorHub

                                </h2>

                                <p>

                                    Welcome to VendorHub Multi Vendor
                                    E-Commerce Platform.

                                    Buy, Sell and Manage your business
                                    from one powerful dashboard.

                                </p>

                            </div>

                            <!-- Right Side -->

                            <div class="col-lg-6 right-side">

                                <div class="text-center mb-4">

                                    <<div class="logo animate__animated animate__bounceIn">

                                        <i class="fas fa-store"></i>

                                        VendorHub

                                </div>

                            </div>

                            <% if(typeof error !=="undefined" ){ %>

                                <div class="alert alert-danger">

                                    <%= error %>

                                </div>

                                <% } %>

                                    <% if(typeof success !=="undefined" ){ %>

                                        <div class="alert alert-success">

                                            <%= success %>

                                        </div>

                                        <% } %>