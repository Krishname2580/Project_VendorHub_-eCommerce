<%- include("../layouts/header",{title:title}) %>

    <%- include("../layouts/navbar") %>

        <%- include("../layouts/sidebar") %>

            <div class="main-content">

                <div class="container-fluid py-4">

                    <div class="card shadow-lg border-0 rounded-4">

                        <div class="card-header text-white d-flex justify-content-between align-items-center"
                            style="background:linear-gradient(90deg,#198754,#20c997);">

                            <h3 class="mb-0">

                                <i class="fas fa-box-open me-2"></i>

                                Product Details

                            </h3>

                            <a href="/vendor/product/list" class="btn btn-light">

                                <i class="fas fa-arrow-left"></i>

                                Back

                            </a>

                        </div>

                        <div class="card-body">

                            <div class="row">

                                <!-- Thumbnail -->

                                <div class="col-md-4 text-center">

                                    <img src="<%= product.thumbnail ? product.thumbnail : '/images/no-image.png' %>"
                                        class="img-fluid rounded shadow" style="max-height:300px;object-fit:cover;">

                                </div>

                                <!-- Product Info -->

                                <div class="col-md-8">

                                    <table class="table table-bordered">

                                        <tr>

                                            <th width="220">Product Name</th>

                                            <td>
                                                <%= product.name %>
                                            </td>

                                        </tr>

                                        <tr>

                                            <th>Category</th>

                                            <td>
                                                <%= product.category ? product.category.name : "-" %>
                                            </td>

                                        </tr>

                                        <tr>

                                            <th>Brand</th>

                                            <td>
                                                <%= product.brand ? product.brand.name : "-" %>
                                            </td>

                                        </tr>

                                        <tr>

                                            <th>Store</th>

                                            <td>
                                                <%= product.store ? product.store.storeName : "-" %>
                                            </td>

                                        </tr>

                                        <tr>

                                            <th>Price</th>

                                            <td>

                                                ₹ <%= product.price %>

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>Discount Price</th>

                                            <td>

                                                ₹ <%= product.discountPrice %>

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>Stock</th>

                                            <td>

                                                <%= product.stock %>

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>SKU</th>

                                            <td>

                                                <%= product.sku %>

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>Weight</th>

                                            <td>

                                                <%= product.weight || "-" %> Kg

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>Dimensions</th>

                                            <td>

                                                <%= product.dimensions.length || 0 %> ×
                                                    <%= product.dimensions.width || 0 %> ×
                                                        <%= product.dimensions.height || 0 %>

                                            </td>

                                        </tr>

                                        <tr>

                                            <th>Status</th>

                                            <td>

                                                <% if(product.status=="Approved" ){ %>

                                                    <span class="badge bg-success fs-6">

                                                        Approved

                                                    </span>

                                                    <% }else if(product.status=="Pending" ){ %>

                                                        <span class="badge bg-warning text-dark fs-6">

                                                            Pending

                                                        </span>

                                                        <% }else{ %>

                                                            <span class="badge bg-danger fs-6">

                                                                Rejected

                                                            </span>

                                                            <% } %>

                                            </td>

                                        </tr>

                                    </table>

                                </div>

                            </div>

                            <!-- Description -->

                            <div class="mt-4">

                                <h5>

                                    Description

                                </h5>

                                <div class="border rounded p-3 bg-light">

                                    <%= product.description %>

                                </div>

                            </div>

                            <!-- Product Images -->

                            <div class="mt-4">

                                <h5>

                                    Product Gallery

                                </h5>

                                <div class="row">

                                    <% if(product.images.length>0){ %>

                                        <% product.images.forEach(image=>{ %>

                                            <div class="col-md-3 mb-3">

                                                <img src="<%= image.imageUrl %>" class="img-fluid rounded shadow"
                                                    style="height:180px;width:100%;object-fit:cover;">

                                            </div>

                                            <% }) %>

                                                <% }else{ %>

                                                    <div class="col-12">

                                                        <p class="text-muted">

                                                            No product images uploaded.

                                                        </p>

                                                    </div>

                                                    <% } %>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            <%- include("../layouts/footer") %>
            </div>

