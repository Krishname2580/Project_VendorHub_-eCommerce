<%- include("../layouts/header", { title: title }) %>

<%- include("../layouts/navbar") %>

<%- include("../layouts/sidebar") %>

<div class="main-content">

    <div class="container-fluid py-4">

        <div class="card shadow border-0 rounded-4">

            <div class="card-header d-flex justify-content-between align-items-center text-white"
                style="background:linear-gradient(90deg,#198754,#20c997);">

                <h3 class="mb-0">

                    <i class="fas fa-check-circle me-2"></i>

                    Approved Products

                </h3>

                <a href="/vendor/product/add" class="btn btn-light">

                    <i class="fas fa-plus-circle"></i>

                    Add Product

                </a>

            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-success">

                            <tr>

                                <th>#</th>

                                <th>Image</th>

                                <th>Name</th>

                                <th>Category</th>

                                <th>Brand</th>

                                <th>Price</th>

                                <th>Stock</th>

                                <th>Status</th>

                                <th width="180">Action</th>

                            </tr>

                        </thead>

                        <tbody>

                            <% if(products && products.length > 0){ %>

                                <% products.forEach((product,index)=>{ %>

                                    <tr>

                                        <td>

                                            <%= index+1 %>

                                        </td>

                                        <td>

                                            <img src="<%= product.thumbnail || '/images/no-image.png' %>"
                                                style="width:70px;height:70px;object-fit:cover;border-radius:8px;">

                                        </td>

                                        <td>

                                            <strong>

                                                <%= product.name %>

                                            </strong>

                                        </td>

                                        <td>

                                            <%= product.category ? product.category.name : "-" %>

                                        </td>

                                        <td>

                                            <%= product.brand ? product.brand.name : "-" %>

                                        </td>

                                        <td>

                                            ₹ <%= product.price %>

                                        </td>

                                        <td>

                                            <%= product.stock %>

                                        </td>

                                        <td>

                                            <span class="badge bg-success">

                                                Approved

                                            </span>

                                        </td>

                                        <td>

                                            <a href="/vendor/product/details/<%= product._id %>"
                                                class="btn btn-info btn-sm">

                                                <i class="fas fa-eye"></i>

                                            </a>

                                            <a href="/vendor/product/edit/<%= product._id %>"
                                                class="btn btn-primary btn-sm">

                                                <i class="fas fa-edit"></i>

                                            </a>

                                            <a href="/vendor/product/delete/<%= product._id %>"
                                                class="btn btn-danger btn-sm"
                                                onclick="return confirm('Delete this product?')">

                                                <i class="fas fa-trash"></i>

                                            </a>

                                        </td>

                                    </tr>

                                <% }) %>

                            <% } else { %>

                                <tr>

                                    <td colspan="9" class="text-center py-5">

                                        <i class="fas fa-check-circle fa-3x text-success mb-3"></i>

                                        <h5>No Approved Products Found</h5>

                                    </td>

                                </tr>

                            <% } %>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>

<%- include("../layouts/footer") %>