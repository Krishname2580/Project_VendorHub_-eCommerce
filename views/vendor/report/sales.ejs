<%- include("../layouts/header", { title: "Sales Report" }) %>

<%- include("../layouts/navbar") %>

<%- include("../layouts/sidebar") %>

<div class="main-content">

    <div class="container-fluid py-4">

        <!-- HEADER -->

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h2 class="fw-bold">

                    <i class="fas fa-chart-line text-success me-2"></i>

                    Sales Report

                </h2>

                <p class="text-muted mb-0">
                    View your complete vendor sales history.
                </p>

            </div>

            <button
                onclick="window.print()"
                class="btn btn-primary">

                <i class="fas fa-print me-2"></i>
                Print

            </button>

        </div>


        <!-- NAVIGATION -->

        <div class="mb-4">

            <a href="/vendor/report/dashboard"
               class="btn btn-dark">

                <i class="fas fa-chart-pie me-1"></i>
                Dashboard

            </a>

            <a href="/vendor/report/sales"
               class="btn btn-success">

                <i class="fas fa-chart-line me-1"></i>
                Sales

            </a>

            <a href="/vendor/orders"
               class="btn btn-primary">

                <i class="fas fa-shopping-cart me-1"></i>
                Orders

            </a>

            <a href="/vendor/report/products"
               class="btn btn-warning">

                <i class="fas fa-box me-1"></i>
                Products

            </a>

        </div>


        <!-- SUMMARY CARDS -->

        <div class="row mb-4">

            <div class="col-md-4 mb-3">

                <div class="card shadow-sm border-0">

                    <div class="card-body">

                        <div class="d-flex justify-content-between">

                            <div>

                                <small class="text-muted">
                                    Total Sales
                                </small>

                                <h3 class="fw-bold text-success mt-2">

                                    ₹ <%= Number(totalSales || 0).toLocaleString("en-IN") %>

                                </h3>

                            </div>

                            <div class="summary-icon sales-icon">

                                <i class="fas fa-indian-rupee-sign"></i>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <div class="col-md-4 mb-3">

                <div class="card shadow-sm border-0">

                    <div class="card-body">

                        <div class="d-flex justify-content-between">

                            <div>

                                <small class="text-muted">
                                    Items Sold
                                </small>

                                <h3 class="fw-bold text-primary mt-2">

                                    <%= totalQuantity || 0 %>

                                </h3>

                            </div>

                            <div class="summary-icon quantity-icon">

                                <i class="fas fa-box"></i>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <div class="col-md-4 mb-3">

                <div class="card shadow-sm border-0">

                    <div class="card-body">

                        <div class="d-flex justify-content-between">

                            <div>

                                <small class="text-muted">
                                    Sales Records
                                </small>

                                <h3 class="fw-bold text-dark mt-2">

                                    <%= sales ? sales.length : 0 %>

                                </h3>

                            </div>

                            <div class="summary-icon order-icon">

                                <i class="fas fa-file-invoice"></i>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- SALES TABLE -->

        <div class="card shadow border-0">

            <div class="card-header bg-success text-white">

                <div class="d-flex justify-content-between align-items-center">

                    <h5 class="mb-0">

                        <i class="fas fa-list me-2"></i>

                        Sales History

                    </h5>

                    <span class="badge bg-light text-success">

                        <%= sales ? sales.length : 0 %> Records

                    </span>

                </div>

            </div>


            <div class="card-body p-0">

                <% if (sales && sales.length > 0) { %>

                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th>#</th>

                                    <th>Date</th>

                                    <th>Customer</th>

                                    <th>Product</th>

                                    <th>Quantity</th>

                                    <th>Price</th>

                                    <th>Total</th>

                                    <th>Status</th>

                                </tr>

                            </thead>


                            <tbody>

                                <% sales.forEach((sale, index) => { %>

                                    <tr>

                                        <td>

                                            <span class="fw-bold">
                                                <%= index + 1 %>
                                            </span>

                                        </td>


                                        <td>

                                            <%= sale.createdAt
                                                ? new Date(
                                                    sale.createdAt
                                                ).toLocaleDateString("en-IN")
                                                : "-" %>

                                        </td>


                                        <td>

                                            <% if (
                                                sale.order &&
                                                sale.order.customer
                                            ) { %>

                                                <strong>

                                                    <%= sale.order.customer.name || "Customer" %>

                                                </strong>

                                            <% } else { %>

                                                <span class="text-muted">
                                                    Customer
                                                </span>

                                            <% } %>

                                        </td>


                                        <td>

                                            <% if (sale.product) { %>

                                                <strong>

                                                    <%= sale.product.name || "Product" %>

                                                </strong>

                                            <% } else { %>

                                                <span class="text-muted">
                                                    Product unavailable
                                                </span>

                                            <% } %>

                                        </td>


                                        <td>

                                            <span class="badge bg-primary">

                                                <%= sale.quantity || 0 %>

                                            </span>

                                        </td>


                                        <td>

                                            ₹ <%= Number(
                                                sale.price || 0
                                            ).toLocaleString("en-IN") %>

                                        </td>


                                        <td>

                                            <strong class="text-success">

                                                ₹ <%= Number(
                                                    sale.total || 0
                                                ).toLocaleString("en-IN") %>

                                            </strong>

                                        </td>


                                        <td>

                                            <% const status =
                                                sale.order &&
                                                sale.order.orderStatus
                                                    ? sale.order.orderStatus
                                                    : "Pending"; %>


                                            <% if (
                                                status === "Delivered"
                                            ) { %>

                                                <span class="badge bg-success">

                                                    <i class="fas fa-check me-1"></i>

                                                    Delivered

                                                </span>

                                            <% } else if (
                                                status === "Cancelled"
                                            ) { %>

                                                <span class="badge bg-danger">

                                                    Cancelled

                                                </span>

                                            <% } else { %>

                                                <span class="badge bg-warning text-dark">

                                                    <%= status %>

                                                </span>

                                            <% } %>

                                        </td>

                                    </tr>

                                <% }) %>

                            </tbody>


                            <!-- GRAND TOTAL -->

                            <tfoot>

                                <tr class="table-success">

                                    <th colspan="6"
                                        class="text-end">

                                        Grand Total

                                    </th>

                                    <th colspan="2">

                                        ₹ <%= Number(
                                            totalSales || 0
                                        ).toLocaleString("en-IN") %>

                                    </th>

                                </tr>

                            </tfoot>

                        </table>

                    </div>

                <% } else { %>


                    <!-- EMPTY -->

                    <div class="text-center py-5">

                        <i class="fas fa-chart-line fa-4x text-muted mb-3"></i>

                        <h4>
                            No Sales Found
                        </h4>

                        <p class="text-muted">
                            You don't have any sales records yet.
                        </p>

                    </div>


                <% } %>

            </div>

        </div>

    </div>

</div>


<style>

    .main-content {
        min-height: 100vh;
    }


    .card {
        border-radius: 12px;
        overflow: hidden;
    }


    .summary-icon {

        width: 50px;
        height: 50px;

        border-radius: 12px;

        display: flex;

        align-items: center;
        justify-content: center;

        font-size: 20px;

    }


    .sales-icon {

        background: #e8f8ef;
        color: #198754;

    }


    .quantity-icon {

        background: #e8f0ff;
        color: #0d6efd;

    }


    .order-icon {

        background: #f1f1f1;
        color: #555;

    }


    .table th,
    .table td {

        vertical-align: middle;

        white-space: nowrap;

    }


    .table thead th {

        font-weight: 600;

    }


    .table tbody tr {

        transition: 0.2s ease;

    }


    .table tbody tr:hover {

        background: #f8fff9;

    }


    @media print {

        .admin-sidebar,
        .sidebar,
        .navbar,
        .header-content,
        .btn {

            display: none !important;

        }


        .main-content {

            margin: 0 !important;

            padding: 0 !important;

            width: 100% !important;

        }


        .card {

            box-shadow: none !important;

        }

    }

</style>


<%- include("../layouts/footer") %>

<%- include("../layouts/scripts") %>