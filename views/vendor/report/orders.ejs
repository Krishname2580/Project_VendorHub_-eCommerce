<%- include("../layouts/header", { title: "Orders Report" }) %>

<%- include("../layouts/navbar") %>

<%- include("../layouts/sidebar") %>


<div class="main-content">

    <div class="container-fluid py-4">

        <!-- ================= HEADER ================= -->

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h2 class="fw-bold">

                    <i class="fas fa-shopping-bag text-primary me-2"></i>

                    Orders Report

                </h2>

                <p class="text-muted mb-0">
                    View all orders containing your products.
                </p>

            </div>


            <button
                onclick="window.print()"
                class="btn btn-primary">

                <i class="fas fa-print me-2"></i>

                Print

            </button>

        </div>


        <!-- ================= REPORT NAVIGATION ================= -->

        <div class="mb-4">

            <a
                href="/vendor/report/dashboard"
                class="btn btn-dark">

                <i class="fas fa-chart-pie me-1"></i>
                Dashboard

            </a>


            <a
                href="/vendor/report/sales"
                class="btn btn-success">

                <i class="fas fa-chart-line me-1"></i>
                Sales

            </a>


            <a
                href="/vendor/report/orders"
                class="btn btn-primary">

                <i class="fas fa-shopping-bag me-1"></i>
                Orders

            </a>


            <a
                href="/vendor/report/products"
                class="btn btn-warning">

                <i class="fas fa-box me-1"></i>
                Products

            </a>

        </div>


        <!-- ================= ORDERS CARD ================= -->

        <div class="card shadow border-0">

            <div class="card-header bg-primary text-white">

                <div class="d-flex justify-content-between align-items-center">

                    <h5 class="mb-0">

                        <i class="fas fa-shopping-bag me-2"></i>

                        Vendor Orders

                    </h5>


                    <span class="badge bg-light text-primary">

                        <%= orders ? orders.length : 0 %> Orders

                    </span>

                </div>

            </div>


            <div class="card-body">


                <% if (orders && orders.length > 0) { %>


                    <div class="table-responsive">

                        <table class="table table-bordered table-hover align-middle">

                            <thead class="table-light">

                                <tr>

                                    <th>#</th>

                                    <th>Order No</th>

                                    <th>Date</th>

                                    <th>Customer</th>

                                    <th>Product</th>

                                    <th>Quantity</th>

                                    <th>Price</th>

                                    <th>Total</th>

                                    <th>Status</th>

                                </tr>

                            </thead>


                            <tbody>


                                <% let rowNumber = 1; %>


                                <% orders.forEach(order => { %>


                                    <% if (order.items && order.items.length > 0) { %>


                                        <% order.items.forEach(item => { %>


                                            <tr>


                                                <!-- NUMBER -->

                                                <td>

                                                    <%= rowNumber++ %>

                                                </td>


                                                <!-- ORDER NUMBER -->

                                                <td>

                                                    <strong>

                                                        <%= order.orderNumber || order._id %>

                                                    </strong>

                                                </td>


                                                <!-- DATE -->

                                                <td>

                                                    <%= order.createdAt
                                                        ? new Date(order.createdAt).toLocaleDateString()
                                                        : "-" %>

                                                </td>


                                                <!-- CUSTOMER -->

                                                <td>

                                                    <% if (order.customer) { %>

                                                        <div class="fw-semibold">

                                                            <%= order.customer.name || "Customer" %>

                                                        </div>

                                                        <% if (order.customer.email) { %>

                                                            <small class="text-muted">

                                                                <%= order.customer.email %>

                                                            </small>

                                                        <% } %>

                                                    <% } else { %>

                                                        <span class="text-muted">

                                                            Customer unavailable

                                                        </span>

                                                    <% } %>

                                                </td>


                                                <!-- PRODUCT -->

                                                <td>

                                                    <% if (item.product) { %>

                                                        <strong>

                                                            <%= item.product.name || "Product" %>

                                                        </strong>

                                                    <% } else { %>

                                                        <span class="text-muted">

                                                            Product unavailable

                                                        </span>

                                                    <% } %>

                                                </td>


                                                <!-- QUANTITY -->

                                                <td>

                                                    <%= item.quantity || 0 %>

                                                </td>


                                                <!-- PRICE -->

                                                <td>

                                                    ₹ <%= Number(item.price || 0).toLocaleString("en-IN") %>

                                                </td>


                                                <!-- TOTAL -->

                                                <td class="fw-bold text-success">

                                                    ₹ <%= Number(item.total || 0).toLocaleString("en-IN") %>

                                                </td>


                                                <!-- STATUS -->

                                                <td>


                                                    <% if (order.orderStatus === "Pending") { %>

                                                        <span class="badge bg-warning text-dark">

                                                            Pending

                                                        </span>


                                                    <% } else if (order.orderStatus === "Confirmed") { %>

                                                        <span class="badge bg-primary">

                                                            Confirmed

                                                        </span>


                                                    <% } else if (order.orderStatus === "Packed") { %>

                                                        <span class="badge bg-info text-dark">

                                                            Packed

                                                        </span>


                                                    <% } else if (order.orderStatus === "Shipped") { %>

                                                        <span class="badge bg-secondary">

                                                            Shipped

                                                        </span>


                                                    <% } else if (order.orderStatus === "Delivered") { %>

                                                        <span class="badge bg-success">

                                                            Delivered

                                                        </span>


                                                    <% } else if (order.orderStatus === "Cancelled") { %>

                                                        <span class="badge bg-danger">

                                                            Cancelled

                                                        </span>


                                                    <% } else if (order.orderStatus === "Returned") { %>

                                                        <span class="badge bg-dark">

                                                            Returned

                                                        </span>


                                                    <% } else { %>

                                                        <span class="badge bg-secondary">

                                                            <%= order.orderStatus || "Unknown" %>

                                                        </span>

                                                    <% } %>


                                                </td>


                                            </tr>


                                        <% }) %>


                                    <% } %>


                                <% }) %>


                            </tbody>

                        </table>

                    </div>


                <% } else { %>


                    <!-- ================= EMPTY ================= -->

                    <div class="text-center py-5">

                        <div class="empty-icon mb-3">

                            <i class="fas fa-shopping-bag"></i>

                        </div>


                        <h4 class="fw-bold">

                            No Orders Found

                        </h4>


                        <p class="text-muted">

                            You don't have any orders containing your products yet.

                        </p>


                        <a
                            href="/vendor/report/dashboard"
                            class="btn btn-primary">

                            <i class="fas fa-chart-pie me-1"></i>

                            Back to Dashboard

                        </a>

                    </div>


                <% } %>


            </div>

        </div>

    </div>

</div>


<!-- ================= CUSTOM CSS ================= -->

<style>


    .main-content {

        min-height: 100vh;

    }


    .card {

        border: none;

        border-radius: 14px;

        overflow: hidden;

    }


    .card-header {

        padding: 16px 20px;

    }


    .table {

        margin-bottom: 0;

    }


    .table th {

        font-weight: 600;

        white-space: nowrap;

        vertical-align: middle;

    }


    .table td {

        vertical-align: middle;

    }


    .table-hover tbody tr {

        transition: 0.2s ease;

    }


    .table-hover tbody tr:hover {

        background: #f7f9ff;

    }


    .badge {

        padding: 7px 11px;

        border-radius: 6px;

        font-size: 11px;

    }


    .empty-icon {

        width: 90px;

        height: 90px;

        margin: auto;

        border-radius: 50%;

        background: #f1f4ff;

        color: #4e73df;

        display: flex;

        align-items: center;

        justify-content: center;

        font-size: 38px;

    }


    @media print {


        .admin-sidebar,
        .sidebar,
        .navbar,
        .header-content,
        .btn,
        .sidebar-brand {

            display: none !important;

        }


        .main-content {

            margin: 0 !important;

            padding: 0 !important;

            width: 100% !important;

        }


        .card {

            box-shadow: none !important;

        }


        .card-header {

            background: #ffffff !important;

            color: #000000 !important;

            border-bottom: 2px solid #000;

        }


        .table {

            width: 100%;

        }

    }


</style>


<%- include("../layouts/footer") %>

<%- include("../layouts/scripts") %>