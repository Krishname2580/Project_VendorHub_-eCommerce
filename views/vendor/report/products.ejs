<%- include("../layouts/header",{title:"Products Report"}) %>

    <%- include("../layouts/navbar") %>

        <%- include("../layouts/sidebar") %>

            <div class="main-content">

                <div class="container-fluid py-4">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <h2>

                            <i class="fas fa-box text-warning me-2"></i>

                            Products Report

                        </h2>

                        <button onclick="window.print()" class="btn btn-primary">

                            <i class="fas fa-print me-2"></i>

                            Print

                        </button>

                    </div>

                    <!-- Navigation -->

                    <div class="mb-4">

                        <a href="/vendor/report/dashboard" class="btn btn-dark">

                            Dashboard

                        </a>

                        <a href="/vendor/report/sales" class="btn btn-success">

                            Sales

                        </a>

                        <a href="/vendor/report/orders" class="btn btn-primary">

                            Orders

                        </a>

                        <a href="/vendor/report/products" class="btn btn-warning">

                            Products

                        </a>

                    </div>

                    <div class="card shadow border-0">

                        <div class="card-header bg-warning text-dark">

                            <h5 class="mb-0">

                                Product Report

                            </h5>

                        </div>

                        <div class="card-body">

                            <% if(products.length){ %>

                                <div class="table-responsive">

                                    <table class="table table-bordered table-hover align-middle">

                                        <thead class="table-light">

                                            <tr>

                                                <th>#</th>

                                                <th>Image</th>

                                                <th>Name</th>

                                                <th>Category</th>

                                                <th>Brand</th>

                                                <th>Price</th>

                                                <th>Discount</th>

                                                <th>Stock</th>

                                                <th>Status</th>

                                            </tr>

                                        </thead>

                                        <tbody>

                                            <% products.forEach((product,index)=>{ %>

                                                <tr>

                                                    <td>

                                                        <%= index+1 %>

                                                    </td>

                                                    <td>

                                                        <% if(product.thumbnail){ %>

                                                            <img src="<%= product.thumbnail %>" width="60" height="60"
                                                                class="rounded shadow-sm">

                                                            <% }else{ %>

                                                                <img src="/images/no-image.png" width="60" height="60">

                                                                <% } %>

                                                    </td>

                                                    <td>

                                                        <strong>

                                                            <%= product.name %>

                                                        </strong>

                                                    </td>

                                                    <td>

                                                        <%= product.category?.name || "-" %>

                                                    </td>

                                                    <td>

                                                        <%= product.brand?.name || "-" %>

                                                    </td>

                                                    <td>

                                                        ₹ <%= product.price %>

                                                    </td>

                                                    <td>

                                                        ₹ <%= product.discountPrice %>

                                                    </td>

                                                    <td>

                                                        <% if(product.stock>0){ %>

                                                            <span class="badge bg-success">

                                                                <%= product.stock %>

                                                            </span>

                                                            <% }else{ %>

                                                                <span class="badge bg-danger">

                                                                    Out of Stock

                                                                </span>

                                                                <% } %>

                                                    </td>

                                                    <td>

                                                        <% if(product.status=="Approved" ){ %>

                                                            <span class="badge bg-success">

                                                                Approved

                                                            </span>

                                                            <% }else if(product.status=="Pending" ){ %>

                                                                <span class="badge bg-warning">

                                                                    Pending

                                                                </span>

                                                                <% }else{ %>

                                                                    <span class="badge bg-danger">

                                                                        Rejected

                                                                    </span>

                                                                    <% } %>

                                                    </td>

                                                </tr>

                                                <% }) %>

                                        </tbody>

                                    </table>

                                </div>

                                <% }else{ %>

                                    <div class="text-center py-5">

                                        <i class="fas fa-box-open fa-5x text-muted mb-3"></i>

                                        <h3>

                                            No Products Found

                                        </h3>

                                    </div>

                                    <% } %>

                        </div>

                    </div>

                </div>

            </div>

            <style>
                .card {

                    border-radius: 12px;

                }

                .table td,
                .table th {

                    vertical-align: middle;

                }

                .table img {

                    object-fit: cover;

                }

                @media print {

                    .sidebar,
                    .navbar,
                    .btn {

                        display: none !important;

                    }

                    .main-content {

                        margin: 0;

                        padding: 0;

                    }

                }
            </style>

            <%- include("../layouts/footer") %>

                <%- include("../layouts/scripts") %>