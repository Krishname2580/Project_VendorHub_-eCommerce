<%- include("../layouts/header",{title:"Messages"}) %>

    <%- include("../layouts/navbar") %>

        <%- include("../layouts/sidebar") %>


            <div class="main-content">

                <div class="container-fluid py-4">


                    <!-- ================= HEADER ================= -->

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div>

                            <h2 class="fw-bold mb-1">

                                <i class="fas fa-envelope text-primary me-2"></i>

                                Inbox

                            </h2>

                            <p class="text-muted mb-0">

                                Manage your received messages

                            </p>

                        </div>


                        <div class="d-flex gap-2">

                            <% if(typeof unreadMessageCount !=='undefined' && unreadMessageCount> 0){ %>

                                <a href="/vendor/message/read-all"
                                   class="btn btn-success">

                                    <i class="fas fa-check-double me-1"></i>

                                    Mark All Read

                                </a>

                                <% } %>


                                    <a href="/vendor/dashboard"
                                       class="btn btn-secondary">

                                        <i class="fas fa-arrow-left me-1"></i>

                                        Back

                                    </a>

                        </div>

                    </div>



                    <!-- ================= MESSAGE CARD ================= -->

                    <div class="card shadow border-0 rounded-4 overflow-hidden">


                        <div class="card-header bg-primary text-white py-3">

                            <div class="d-flex justify-content-between align-items-center">

                                <h5 class="mb-0 fw-bold">

                                    <i class="fas fa-inbox me-2"></i>

                                    Received Messages

                                </h5>


                                <span class="badge bg-light text-primary">

                                    <%= messages ? messages.length : 0 %>

                                    Messages

                                </span>

                            </div>

                        </div>



                        <div class="card-body p-0">


                            <% if(messages && messages.length> 0){ %>


                                <div class="table-responsive">

                                    <table class="table table-hover align-middle mb-0">


                                        <thead class="table-light">

                                            <tr>

                                                <th width="70" class="text-center">
                                                    #
                                                </th>

                                                <th>
                                                    From
                                                </th>

                                                <th>
                                                    Subject
                                                </th>

                                                <th>
                                                    Message
                                                </th>

                                                <th class="text-center">
                                                    Status
                                                </th>

                                                <th>
                                                    Date
                                                </th>

                                                <th width="190" class="text-center">
                                                    Action
                                                </th>

                                            </tr>

                                        </thead>


                                        <tbody>


                                            <% messages.forEach((message,index)=>{ %>


                                                <tr class="<%= !message.isRead ? 'unread-message' : '' %>">


                                                    <!-- NUMBER -->

                                                    <td class="text-center">

                                                        <span class="message-number">

                                                            <%= index + 1 %>

                                                        </span>

                                                    </td>



                                                    <!-- SENDER -->

                                                    <td>

                                                        <div class="d-flex align-items-center">


                                                            <div class="sender-icon">

                                                                <i class="fas fa-user"></i>

                                                            </div>


                                                            <div>

                                                                <% if(message.sender){ %>

                                                                    <strong class="sender-name">

                                                                        <%= message.sender.name %>

                                                                    </strong>

                                                                    <br>

                                                                    <small class="text-muted">

                                                                        <%= message.sender.email %>

                                                                    </small>

                                                                    <% }else{ %>

                                                                        <span class="text-muted">

                                                                            Unknown Sender

                                                                        </span>

                                                                        <% } %>

                                                            </div>

                                                        </div>

                                                    </td>



                                                    <!-- SUBJECT -->

                                                    <td>

                                                        <strong>

                                                            <%= message.subject || "No Subject" %>

                                                        </strong>

                                                        <% if(!message.isRead){ %>

                                                            <span class="new-message">

                                                                NEW

                                                            </span>

                                                            <% } %>

                                                    </td>



                                                    <!-- MESSAGE -->

                                                    <td>

                                                        <span class="message-preview">

                                                            <%= message.message %>

                                                        </span>

                                                    </td>



                                                    <!-- STATUS -->

                                                    <td class="text-center">


                                                        <% if(message.isRead){ %>

                                                            <span class="message-status read">

                                                                <i class="fas fa-check-circle me-1"></i>

                                                                Read

                                                            </span>

                                                            <% }else{ %>

                                                                <span class="message-status unread">

                                                                    <i class="fas fa-circle me-1"></i>

                                                                    Unread

                                                                </span>

                                                                <% } %>

                                                    </td>



                                                    <!-- DATE -->

                                                    <td>

                                                        <div class="message-date">

                                                            <%= new Date(message.createdAt).toLocaleDateString() %>

                                                        </div>

                                                        <small class="text-muted">

                                                            <%= new Date(message.createdAt).toLocaleTimeString() %>

                                                        </small>

                                                    </td>



                                                    <!-- ACTION -->

                                                    <td>

                                                        <div class="message-actions">


                                                            <!-- VIEW -->

                                                            <a href="/vendor/message/details/<%= message._id %>"
                                                               class="btn btn-primary btn-sm"
                                                               title="View Message">

                                                                <i class="fas fa-eye"></i>

                                                                View

                                                            </a>



                                                            <!-- READ -->

                                                            <% if(!message.isRead){ %>

                                                                <a href="/vendor/message/read/<%= message._id %>"
                                                                   class="btn btn-success btn-sm"
                                                                   title="Mark as Read">

                                                                    <i class="fas fa-check"></i>

                                                                </a>

                                                                <% } %>



                                                                    <!-- DELETE -->

                                                                    <a href="/vendor/message/delete/<%= message._id %>"
                                                                       class="btn btn-danger btn-sm"
                                                                       title="Delete Message"
                                                                       onclick="return confirm('Delete this message?')">

                                                                        <i class="fas fa-trash"></i>

                                                                    </a>


                                                        </div>

                                                    </td>


                                                </tr>


                                                <% }) %>


                                        </tbody>


                                    </table>

                                </div>


                                <% }else{ %>


                                    <!-- ================= EMPTY ================= -->

                                    <div class="text-center py-5">

                                        <div class="empty-message-icon">

                                            <i class="fas fa-envelope-open-text"></i>

                                        </div>

                                        <h4 class="fw-bold mt-3">

                                            No Messages Found

                                        </h4>

                                        <p class="text-muted mb-0">

                                            You haven't received any messages yet.

                                        </p>

                                    </div>


                                    <% } %>


                        </div>

                    </div>

                </div>

            </div>



            <!-- ================= CSS ================= -->

            <style>


                .rounded-4 {

                    border-radius: 15px !important;

                }


                /* ================= UNREAD ================= */

                .unread-message {

                    background: #f5f8ff !important;

                    border-left: 4px solid #0d6efd;

                }


                .unread-message:hover {

                    background: #edf3ff !important;

                }


                /* ================= NUMBER ================= */

                .message-number {

                    width: 30px;

                    height: 30px;

                    display: inline-flex;

                    align-items: center;

                    justify-content: center;

                    border-radius: 50%;

                    background: #f1f3f5;

                    font-size: 13px;

                    font-weight: 600;

                }


                /* ================= SENDER ================= */

                .sender-icon {

                    width: 40px;

                    height: 40px;

                    min-width: 40px;

                    border-radius: 10px;

                    background: #e7f0ff;

                    color: #0d6efd;

                    display: flex;

                    align-items: center;

                    justify-content: center;

                    margin-right: 10px;

                }


                .sender-name {

                    font-size: 14px;

                }


                /* ================= NEW ================= */

                .new-message {

                    display: inline-block;

                    margin-left: 6px;

                    padding: 3px 6px;

                    border-radius: 5px;

                    background: #dc3545;

                    color: #fff;

                    font-size: 9px;

                    font-weight: 700;

                }


                /* ================= MESSAGE ================= */

                .message-preview {

                    display: block;

                    max-width: 280px;

                    white-space: nowrap;

                    overflow: hidden;

                    text-overflow: ellipsis;

                    color: #666;

                    font-size: 13px;

                }


                /* ================= STATUS ================= */

                .message-status {

                    display: inline-flex;

                    align-items: center;

                    padding: 6px 10px;

                    border-radius: 20px;

                    font-size: 11px;

                    font-weight: 600;

                    white-space: nowrap;

                }


                .message-status.read {

                    color: #198754;

                    background: #e8f7ee;

                }


                .message-status.unread {

                    color: #dc3545;

                    background: #fff0f1;

                }


                /* ================= DATE ================= */

                .message-date {

                    font-size: 13px;

                    font-weight: 600;

                }


                /* ================= ACTIONS ================= */

                .message-actions {

                    display: flex;

                    justify-content: center;

                    align-items: center;

                    gap: 5px;

                }


                .message-actions .btn {

                    border-radius: 6px;

                    font-size: 12px;

                }


                /* ================= EMPTY ================= */

                .empty-message-icon {

                    width: 90px;

                    height: 90px;

                    margin: auto;

                    border-radius: 50%;

                    background: #f1f3f5;

                    color: #adb5bd;

                    display: flex;

                    align-items: center;

                    justify-content: center;

                    font-size: 38px;

                }


                /* ================= TABLE ================= */

                .table th {

                    font-size: 13px;

                    font-weight: 700;

                    white-space: nowrap;

                    padding: 15px 12px;

                }


                .table td {

                    padding: 15px 12px;

                }


                /* ================= MOBILE ================= */

                @media(max-width: 768px) {

                    .message-preview {

                        max-width: 180px;

                    }


                    .message-actions {

                        flex-wrap: wrap;

                    }


                    .sender-icon {

                        width: 35px;

                        height: 35px;

                        min-width: 35px;

                    }

                }


                /* ================= PRINT ================= */

                @media print {

                    .sidebar,
                    .navbar,
                    .btn {

                        display: none !important;

                    }


                    .main-content {

                        margin: 0 !important;

                        padding: 0 !important;

                    }


                    .card {

                        box-shadow: none !important;

                    }

                }

            </style>



            <%- include("../layouts/footer") %>

                <%- include("../layouts/scripts") %>