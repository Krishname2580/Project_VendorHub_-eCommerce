<%- include("../layouts/header", { title: "Coupons" }) %>

    <%- include("../layouts/navbar") %>

        <%- include("../layouts/sidebar") %>

            <div class="container-fluid p-4">

                <div class="card shadow">

                    <div class="card-header d-flex justify-content-between align-items-center">

                        <h4>My Coupons</h4>

                        <a href="/vendor/coupons/add" class="btn btn-primary">

                            <i class="fas fa-plus"></i>

                            Add Coupon

                        </a>

                    </div>

                    <div class="card-body">

                        <table class="table table-bordered table-hover">

                            <thead class="table-dark">

                                <tr>

                                    <th>#</th>

                                    <th>Coupon Code</th>

                                    <th>Type</th>

                                    <th>Value</th>

                                    <th>Minimum Order</th>

                                    <th>Expiry Date</th>

                                    <th>Status</th>

                                    <th>Actions</th>

                                </tr>

                            </thead>

                            <tbody>

                                <% if(coupons.length){ %>

                                    <% coupons.forEach((coupon,index)=>{ %>

                                        <tr>

                                            <td>
                                                <%= index+1 %>
                                            </td>

                                            <td>

                                                <strong>

                                                    <%= coupon.code %>

                                                </strong>

                                            </td>

                                            <td>

                                                <%= coupon.discountType %>

                                            </td>

                                            <td>

                                                <% if(coupon.discountType==="Percentage" ){ %>

                                                    <%= coupon.discountValue %> %

                                                        <% }else{ %>

                                                            ₹ <%= coupon.discountValue %>

                                                                <% } %>

                                            </td>

                                            <td>

                                                ₹ <%= coupon.minimumOrderAmount %>

                                            </td>

                                            <td>

                                                <%= coupon.expiryDate.toDateString() %>

                                            </td>

                                            <td>

                                                <% if(coupon.status){ %>

                                                    <span class="badge bg-success">

                                                        Active

                                                    </span>

                                                    <% }else{ %>

                                                        <span class="badge bg-danger">

                                                            Inactive

                                                        </span>

                                                        <% } %>

                                            </td>

                                            <td>

                                                <a href="/vendor/coupons/edit/<%= coupon._id %>"
                                                    class="btn btn-warning btn-sm">

                                                    <i class="fas fa-edit"></i>

                                                </a>

                                                <a href="/vendor/coupons/delete/<%= coupon._id %>"
                                                    onclick="return confirm('Delete Coupon?')"
                                                    class="btn btn-danger btn-sm">

                                                    <i class="fas fa-trash"></i>

                                                </a>

                                            </td>

                                        </tr>

                                        <% }) %>

                                            <% } else { %>

                                                <tr>

                                                    <td colspan="8" class="text-center">

                                                        No Coupons Available

                                                    </td>

                                                </tr>

                                                <% } %>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

            <%- include("../layouts/footer") %>

                <%- include("../layouts/scripts") %>