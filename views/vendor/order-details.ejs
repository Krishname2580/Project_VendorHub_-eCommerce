<%- include('layouts/header') %>

    <%- include("layouts/navbar") %>

        <%- include("layouts/sidebar") %>
            <div class="main-content">
                <style>
                    .order-page {
                        padding: 30px;
                        background: #f5f7fb;
                        min-height: calc(100vh - 80px);
                    }

                    .order-grid {
                        display: grid;
                        grid-template-columns: minmax(0, 1fr) 380px;
                        gap: 24px;
                        align-items: start;
                    }

                    .order-card {
                        background: #fff;
                        border-radius: 16px;
                        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
                        overflow: hidden;
                    }

                    .order-card-header {
                        padding: 22px 26px;
                        border-bottom: 1px solid #eee;
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                    }

                    .order-card-header h3 {
                        margin: 0;
                        font-size: 22px;
                        font-weight: 700;
                        color: #1f2937;
                    }

                    .order-count {
                        background: #1677ff;
                        color: white;
                        padding: 8px 15px;
                        border-radius: 8px;
                        font-size: 14px;
                        font-weight: 600;
                    }

                    .product-table {
                        width: 100%;
                        border-collapse: collapse;
                    }

                    .product-table th {
                        padding: 16px 26px;
                        background: #f8fafc;
                        color: #111827;
                        font-weight: 700;
                        border-bottom: 1px solid #ddd;
                    }

                    .product-table td {
                        padding: 18px 26px;
                        border-bottom: 1px solid #eee;
                        vertical-align: middle;
                    }

                    .product-info {
                        display: flex;
                        align-items: center;
                        gap: 18px;
                    }

                    .product-image {
                        width: 65px;
                        height: 65px;
                        object-fit: contain;
                        border-radius: 8px;
                        border: 1px solid #eee;
                        background: #fff;
                        padding: 5px;
                    }

                    .product-name {
                        font-size: 16px;
                        font-weight: 600;
                        color: #475569;
                        margin-bottom: 6px;
                    }

                    .product-sku {
                        font-size: 13px;
                        color: #64748b;
                    }

                    .price {
                        font-weight: 500;
                        color: #111827;
                        white-space: nowrap;
                    }

                    .quantity {
                        display: inline-flex;
                        align-items: center;
                        justify-content: center;
                        min-width: 44px;
                        height: 34px;
                        border: 1px solid #dbe2ea;
                        border-radius: 8px;
                        background: #f8fafc;
                        font-weight: 600;
                    }

                    .item-total {
                        font-weight: 700;
                        color: #111827;
                        white-space: nowrap;
                    }

                    /* Summary */

                    .summary-card {
                        background: #fff;
                        border-radius: 16px;
                        padding: 26px;
                        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
                    }

                    .summary-card h3 {
                        margin: 0 0 26px;
                        font-size: 22px;
                        font-weight: 700;
                        color: #1f2937;
                    }

                    .summary-row {
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                        padding: 11px 0;
                        color: #64748b;
                        font-size: 15px;
                    }

                    .summary-row strong {
                        color: #111827;
                    }

                    .discount {
                        color: #009b67 !important;
                    }

                    .summary-total {
                        border-top: 1px solid #ddd;
                        margin-top: 10px;
                        padding-top: 18px;
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                    }

                    .summary-total span:first-child {
                        font-size: 20px;
                        font-weight: 700;
                        color: #111827;
                    }

                    .summary-total span:last-child {
                        font-size: 22px;
                        font-weight: 800;
                        color: #1677ff;
                    }

                    /* Customer information */

                    .customer-card {
                        margin-top: 24px;
                        background: #fff;
                        border-radius: 16px;
                        padding: 26px;
                        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
                    }

                    .customer-card h3 {
                        margin-bottom: 20px;
                        font-size: 21px;
                        font-weight: 700;
                    }

                    .customer-grid {
                        display: grid;
                        grid-template-columns: repeat(2, 1fr);
                        gap: 15px 30px;
                    }

                    .customer-item label {
                        display: block;
                        font-size: 13px;
                        color: #64748b;
                        margin-bottom: 4px;
                    }

                    .customer-item p {
                        margin: 0;
                        color: #1f2937;
                        font-weight: 500;
                    }

                    /* Status */

                    .status-card {
                        margin-top: 24px;
                        background: #fff;
                        border-radius: 16px;
                        padding: 26px;
                        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);

                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                        gap: 30px;
                    }

                    .status-info h3 {
                        margin: 0 0 6px;
                        font-size: 21px;
                        font-weight: 700;
                    }

                    .status-info p {
                        margin: 0;
                        color: #64748b;
                    }

                    .status-form {
                        display: flex;
                        align-items: center;
                        gap: 12px;
                        min-width: 450px;
                    }

                    .status-form select {
                        height: 50px;
                        border: 1px solid #dbe2ea;
                        border-radius: 8px;
                        padding: 0 15px;
                        flex: 1;
                        font-size: 15px;
                        background: #fff;
                    }

                    .update-btn {
                        height: 50px;
                        padding: 0 25px;
                        border: none;
                        border-radius: 8px;
                        background: #1677ff;
                        color: white;
                        font-weight: 600;
                        cursor: pointer;
                    }

                    .update-btn:hover {
                        background: #0965df;
                    }

                    /* Responsive */

                    @media (max-width: 1100px) {
                        .order-grid {
                            grid-template-columns: 1fr;
                        }

                        .summary-card {
                            width: 100%;
                        }
                    }

                    @media (max-width: 768px) {

                        .order-page {
                            padding: 15px;
                        }

                        .product-table {
                            min-width: 700px;
                        }

                        .order-card {
                            overflow-x: auto;
                        }

                        .customer-grid {
                            grid-template-columns: 1fr;
                        }

                        .status-card {
                            flex-direction: column;
                            align-items: stretch;
                        }

                        .status-form {
                            min-width: 0;
                            width: 100%;
                        }
                    }
                </style>


                <div class="order-page">

                    <!-- =========================
         TOP GRID
    ========================== -->

                    <div class="order-grid">

                        <!-- =========================
             PRODUCTS
        ========================== -->

                        <div class="order-card">

                            <div class="order-card-header">

                                <h3>
                                    <i class="fas fa-box text-primary me-2"></i>
                                    Your Products
                                </h3>

                                <span class="order-count">
                                    <%= vendorItems.length %> Item(s)
                                </span>

                            </div>


                            <div class="table-responsive">

                                <table class="product-table">

                                    <thead>

                                        <tr>

                                            <th class="text-start">
                                                Product
                                            </th>

                                            <th>
                                                Price
                                            </th>

                                            <th>
                                                Quantity
                                            </th>

                                            <th>
                                                Total
                                            </th>

                                        </tr>

                                    </thead>


                                    <tbody>

                                        <% vendorItems.forEach(item=> { %>

                                            <tr>

                                                <td>

                                                    <div class="product-info">

                                                        <img src="<%= item.product?.images?.[0]?.imageUrl || item.product?.thumbnail || '/images/no-image.png' %>"
                                                            class="product-image"
                                                            alt="<%= item.product?.name || 'Product' %>">

                                                        <div>

                                                            <div class="product-name">
                                                                <%= item.product?.name || 'Product unavailable' %>
                                                            </div>

                                                            <% if (item.product?.sku) { %>

                                                                <div class="product-sku">
                                                                    SKU: <%= item.product.sku %>
                                                                </div>

                                                                <% } %>

                                                        </div>

                                                    </div>

                                                </td>


                                                <td>

                                                    <span class="price">
                                                        ₹<%= Number(item.price || item.product?.price || 0).toFixed(2)
                                                            %>
                                                    </span>

                                                </td>


                                                <td>

                                                    <span class="quantity">
                                                        <%= item.quantity %>
                                                    </span>

                                                </td>


                                                <td>

                                                    <span class="item-total">

                                                        ₹<%= Number( item.total || ((item.price || item.product?.price
                                                            || 0) * item.quantity) ).toFixed(2) %>

                                                    </span>

                                                </td>

                                            </tr>

                                            <% }) %>

                                    </tbody>

                                </table>

                            </div>

                        </div>


                        <!-- =========================
             ORDER SUMMARY
        ========================== -->

                        <div class="summary-card">

                            <h3>
                                Order Summary
                            </h3>


                            <div class="summary-row">

                                <span>Subtotal</span>

                                <strong>
                                    ₹<%= Number(order.subtotal || 0).toFixed(2) %>
                                </strong>

                            </div>


                            <div class="summary-row">

                                <span>Discount</span>

                                <strong class="discount">

                                    - ₹<%= Number(order.discount || 0).toFixed(2) %>

                                </strong>

                            </div>


                            <div class="summary-row">

                                <span>Shipping</span>

                                <strong>
                                    ₹<%= Number(order.shippingCharge || 0).toFixed(2) %>
                                </strong>

                            </div>


                            <% if (order.tax) { %>

                                <div class="summary-row">

                                    <span>Tax</span>

                                    <strong>
                                        ₹<%= Number(order.tax).toFixed(2) %>
                                    </strong>

                                </div>

                                <% } %>


                                    <div class="summary-total">

                                        <span>Total</span>

                                        <span>
                                            ₹<%= Number(order.totalAmount || 0).toFixed(2) %>
                                        </span>

                                    </div>

                        </div>

                    </div>


                    <!-- =========================
         CUSTOMER DETAILS
    ========================== -->

                    <div class="customer-card">

                        <h3>
                            <i class="fas fa-user text-primary me-2"></i>
                            Customer Details
                        </h3>


                        <div class="customer-grid">

                            <div class="customer-item">

                                <label>Customer Name</label>

                                <p>
                                    <%= order.firstName || '' %>
                                        <%= order.lastName || '' %>
                                </p>

                            </div>


                            <div class="customer-item">

                                <label>Email</label>

                                <p>
                                    <%= order.email || order.customer?.email || '-' %>
                                </p>

                            </div>


                            <div class="customer-item">

                                <label>Phone</label>

                                <p>
                                    <%= order.phone || '-' %>
                                </p>

                            </div>


                            <div class="customer-item">

                                <label>Payment Method</label>

                                <p>
                                    <%= order.paymentMethod || 'COD' %>
                                </p>

                            </div>


                            <div class="customer-item">

                                <label>Shipping Address</label>

                                <p>
                                    <%= order.address || '-' %>,
                                        <%= order.city || '' %>,
                                            <%= order.state || '' %>,
                                                <%= order.country || '' %>
                                                    - <%= order.pincode || '' %>
                                </p>

                            </div>


                            <div class="customer-item">

                                <label>Order Date</label>

                                <p>

                                    <%= order.createdAt ? new Date(order.createdAt).toLocaleDateString('en-IN') : '-' %>

                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- =========================
         UPDATE STATUS
    ========================== -->

                    <div class="status-card">

                        <div class="status-info">

                            <h3>
                                Update Order Status
                            </h3>

                            <p>
                                Change the status of this order.
                            </p>

                        </div>


                        <form action="/vendor/orders/<%= order._id %>/status" method="POST" class="status-form">

                            <select name="status" required>

                                <% const statuses=[ "Pending" , "Confirmed" , "Packed" , "Shipped" , "Delivered"
                                    , "Cancelled" , "Returned" ]; %>


                                    <% statuses.forEach(status=> { %>

                                        <option value="<%= status %>" <%=order.orderStatus===status ? 'selected' : '' %>
                                            >
                                            <%= status %>
                                        </option>

                                        <% }) %>

                            </select>


                            <button type="submit" class="update-btn">

                                <i class="fas fa-save me-2"></i>
                                Update

                            </button>

                        </form>

                    </div>

                </div>


                <%- include('layouts/footer') %>
            </div>