<%- include("../layouts/header", { title: title }) %>

    <%- include("../layouts/navbar") %>

        <%- include("../layouts/sidebar") %>

            <div class="main-content">

                <div class="container-fluid py-4">

                    <div class="card shadow-lg border-0 rounded-4">

                        <div class="card-header bg-warning text-dark py-3">

                            <h3 class="mb-0">
                                <i class="fas fa-edit me-2"></i>
                                Edit Store
                            </h3>

                        </div>

                        <div class="card-body">

                            <form action="/vendor/store/update" method="POST" enctype="multipart/form-data">

                                <div class="row">

                                    <!-- Store Name -->

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label fw-bold">
                                            Store Name
                                        </label>

                                        <input type="text" name="storeName" class="form-control"
                                            value="<%= store.storeName %>" required>

                                    </div>

                                    <!-- Logo -->

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label fw-bold">
                                            Store Logo
                                        </label>

                                        <input type="file" name="logo" class="form-control" accept="image/*">

                                        <div class="mt-3">

                                            <% if(store.logo){ %>

                                                <img src="<%= store.logo %>" class="img-thumbnail rounded-circle shadow"
                                                    style="width:120px;height:120px;object-fit:cover;">

                                                <% } else { %>

                                                    <img src="/images/auth/user.png"
                                                        class="img-thumbnail rounded-circle shadow"
                                                        style="width:120px;height:120px;object-fit:cover;">

                                                    <% } %>

                                        </div>

                                    </div>

                                    <!-- Banner -->

                                    <div class="col-md-12 mb-4">

                                        <label class="form-label fw-bold">
                                            Store Banner
                                        </label>

                                        <input type="file" name="banner" class="form-control" accept="image/*">

                                        <div class="mt-3">

                                            <% if(store.banner){ %>

                                                <img src="<%= store.banner %>" class="img-fluid rounded shadow"
                                                    style="width:100%;max-height:220px;object-fit:cover;">

                                                <% } else { %>

                                                    <img src="/images/default-banner.jpg"
                                                        class="img-fluid rounded shadow"
                                                        style="width:100%;max-height:220px;object-fit:cover;">

                                                    <% } %>

                                        </div>

                                    </div>

                                    <!-- Address -->

                                    <div class="col-md-12 mb-3">

                                        <label class="form-label fw-bold">
                                            Store Address
                                        </label>

                                        <textarea name="address" rows="3"
                                            class="form-control"><%= store.address || "" %></textarea>

                                    </div>

                                    <!-- Description -->

                                    <div class="col-md-12 mb-3">

                                        <label class="form-label fw-bold">
                                            Store Description
                                        </label>

                                        <textarea name="description" rows="5"
                                            class="form-control"><%= store.description || "" %></textarea>

                                    </div>

                                </div>

                                <div class="text-end">

                                    <a href="/vendor/store" class="btn btn-secondary me-2">

                                        <i class="fas fa-arrow-left me-1"></i>

                                        Back

                                    </a>

                                    <button type="submit" class="btn btn-success px-4">

                                        <i class="fas fa-save me-2"></i>

                                        Update Store

                                    </button>

                                </div>

                            </form>

                        </div>

                    </div>

                </div>

            </div>

            <%- include("../layouts/footer") %>