<%- include("../layouts/header", { title: title }) %>

    <%- include("../layouts/navbar") %>

        <%- include("../layouts/sidebar") %>

            <div class="main-content">

                <div class="container-fluid py-4">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <h2 class="fw-bold text-primary">
                            <i class="fas fa-store me-2"></i> My Store
                        </h2>

                        <a href="/vendor/store/edit" class="btn btn-success shadow-sm">
                            <i class="fas fa-edit me-1"></i> Edit Store
                        </a>

                    </div>

                    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                        <!-- Banner -->

                        <div style="height:250px; overflow:hidden;">

                            <% if(store.banner){ %>

                                <img src="<%= store.banner %>" class="w-100 h-100" style="object-fit:cover;">

                                <% } else { %>

                                    <img src="/images/default-banner.jpg" class="w-100 h-100" style="object-fit:cover;">

                                    <% } %>

                        </div>

                        <div class="card-body">

                            <div class="row align-items-center">

                                <div class="col-lg-3 text-center">

                                    <% if(store.logo){ %>

                                        <img src="<%= store.logo %>"
                                            class="rounded-circle shadow border border-4 border-white"
                                            style="width:180px;height:180px;object-fit:cover;margin-top:-90px;background:#fff;">

                                        <% } else { %>

                                            <img src="/images/auth/user.png"
                                                class="rounded-circle shadow border border-4 border-white"
                                                style="width:180px;height:180px;object-fit:cover;margin-top:-90px;background:#fff;">

                                            <% } %>

                                </div>

                                <div class="col-lg-9">

                                    <h2 class="fw-bold mb-2">

                                        <%= store.storeName %>

                                    </h2>

                                    <p class="text-muted">

                                        <%= store.description || "No description available." %>

                                    </p>

                                </div>

                            </div>

                            <hr>

                            <div class="row g-4">

                                <div class="col-md-6">

                                    <div class="card border-0 bg-light shadow-sm h-100">

                                        <div class="card-body">

                                            <h5 class="text-success">

                                                <i class="fas fa-map-marker-alt me-2"></i>

                                                Address

                                            </h5>

                                            <p class="mb-0">

                                                <%= store.address || "Not Added" %>

                                            </p>

                                        </div>

                                    </div>

                                </div>

                                <div class="col-md-6">

                                    <div class="card border-0 bg-light shadow-sm h-100">

                                        <div class="card-body">

                                            <h5 class="text-primary">

                                                <i class="fas fa-user me-2"></i>

                                                Vendor Information

                                            </h5>

                                            <p>

                                                <strong>Name :</strong>

                                                <%= vendor.user ? vendor.user.name : "-" %>

                                            </p>

                                            <p>

                                                <strong>Email :</strong>

                                                <%= vendor.user ? vendor.user.email : "-" %>

                                            </p>

                                            <p>

                                                <strong>Phone :</strong>

                                                <%= vendor.user ? vendor.user.phone : "-" %>

                                            </p>

                                        </div>

                                    </div>

                                </div>

                            </div>

                            <hr>

                            <div class="row text-center">

                                <div class="col-md-3">

                                    <div class="card shadow-sm border-0">

                                        <div class="card-body">

                                            <i class="fas fa-box fa-2x text-primary mb-2"></i>

                                            <h4>0</h4>

                                            <small>Total Products</small>

                                        </div>

                                    </div>

                                </div>

                                <div class="col-md-3">

                                    <div class="card shadow-sm border-0">

                                        <div class="card-body">

                                            <i class="fas fa-shopping-cart fa-2x text-success mb-2"></i>

                                            <h4>0</h4>

                                            <small>Total Orders</small>

                                        </div>

                                    </div>

                                </div>

                                <div class="col-md-3">

                                    <div class="card shadow-sm border-0">

                                        <div class="card-body">

                                            <i class="fas fa-star fa-2x text-warning mb-2"></i>

                                            <h4>0</h4>

                                            <small>Reviews</small>

                                        </div>

                                    </div>

                                </div>

                                <div class="col-md-3">

                                    <div class="card shadow-sm border-0">

                                        <div class="card-body">

                                            <i class="fas fa-wallet fa-2x text-danger mb-2"></i>

                                            <h4>₹0</h4>

                                            <small>Total Earnings</small>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>