<%- include("../layouts/header", { title: title }) %>

    <%- include("../layouts/navbar") %>

        <%- include("../layouts/sidebar") %>

            <div class="main-content">

                <div class="container-fluid py-4">

                    <div class="card shadow-lg border-0 rounded-4">

                        <div class="card-header bg-primary text-white py-3">

                            <h3 class="mb-0">
                                <i class="fas fa-store me-2"></i>
                                Create Store
                            </h3>

                        </div>

                        <div class="card-body">

                            <form action="/vendor/store/create" method="POST" enctype="multipart/form-data">

                                <div class="row">

                                    <!-- Store Name -->

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label fw-bold">
                                            Store Name
                                        </label>

                                        <input type="text" name="storeName" class="form-control"
                                            placeholder="Enter Store Name" required>

                                    </div>

                                    <!-- Logo -->

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label fw-bold">
                                            Store Logo
                                        </label>

                                        <input type="file" name="logo" class="form-control" accept="image/*">

                                    </div>

                                    <!-- Banner -->

                                    <div class="col-md-12 mb-3">

                                        <label class="form-label fw-bold">
                                            Store Banner
                                        </label>

                                        <input type="file" name="banner" class="form-control" accept="image/*">

                                    </div>

                                    <!-- Address -->

                                    <div class="col-md-12 mb-3">

                                        <label class="form-label fw-bold">
                                            Store Address
                                        </label>

                                        <textarea name="address" rows="3" class="form-control"
                                            placeholder="Enter Store Address"></textarea>

                                    </div>

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label fw-bold">
                                            Store Mobile Number
                                        </label>

                                        <input type="text" name="phone" class="form-control"
                                            placeholder="Enter Store Mobile Number">

                                    </div>

                                    <!-- Description -->

                                    <div class="col-md-12 mb-3">

                                        <label class="form-label fw-bold">
                                            Store Description
                                        </label>

                                        <textarea name="description" rows="4" class="form-control"
                                            placeholder="Write about your store..."></textarea>

                                    </div>

                                </div>

                                <div class="text-end">

                                    <button class="btn btn-success px-4">

                                        <i class="fas fa-save me-2"></i>

                                        Create Store

                                    </button>

                                </div>

                            </form>

                        </div>

                    </div>

                </div>

            </div>

            <%- include("../layouts/footer") %>