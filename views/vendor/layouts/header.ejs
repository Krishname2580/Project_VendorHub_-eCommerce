<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= title || "Vendor Panel" %>
    </title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css">

    <!-- Animate CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <!-- Vendor CSS -->
    <link rel="stylesheet" href="/css/vendor.css">

    <!-- Favicon -->
    <link rel="icon" href="/images/favicon.png">

</head>
<script>

document.addEventListener("DOMContentLoaded", function () {

    const searchInput = document.getElementById("dashboardSearch");
    const searchButton = document.getElementById("searchButton");

    if (!searchInput || !searchButton) {
        return;
    }


    function performSearch() {

        const searchValue = searchInput.value.trim().toLowerCase();

        if (!searchValue) {
            return;
        }

        /*
         * Search through dashboard/sidebar links
         */

        const links = document.querySelectorAll(
            ".sidebar a, .metismenu a, .navigation a"
        );

        let found = false;

        links.forEach(function (link) {

            const text = link.innerText
                .trim()
                .toLowerCase();

            if (!found && text.includes(searchValue)) {

                found = true;

                link.click();

            }

        });


        if (!found) {

            alert("No matching page found.");

        }

    }


    searchButton.addEventListener(
        "click",
        performSearch
    );


    searchInput.addEventListener(
        "keydown",
        function (event) {

            if (event.key === "Enter") {

                event.preventDefault();

                performSearch();

            }

        }
    );

});

</script>
<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>
<body>

<style>
    /* =========================================
   DASHBOARD SEARCH
========================================= */

.dashboard-search {
    position: relative;
    width: 320px;
    height: 42px;
    display: flex;
    align-items: center;
}

.dashboard-search .form-control {
    width: 100%;
    height: 42px;

    padding: 0 48px 0 16px;

    border: 1px solid #e1e5eb;
    border-radius: 8px;

    background: #ffffff;
    color: #333;

    font-size: 14px;

    outline: none;

    box-shadow: none;

    transition: all 0.25s ease;
}

.dashboard-search .form-control::placeholder {
    color: #999;
}

.dashboard-search .form-control:focus {
    border-color: #4e73df;

    box-shadow: 0 0 0 3px rgba(78, 115, 223, 0.10);
}


/* Search Button */

.search-btn {
    position: absolute;

    right: 5px;
    top: 5px;

    width: 32px;
    height: 32px;

    border: none;
    border-radius: 6px;

    background: #4e73df;
    color: #ffffff;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;

    transition: all 0.2s ease;
}

.search-btn:hover {
    background: #365fc7;
    color: #ffffff;
}

.search-btn:active {
    transform: scale(0.95);
}


/* =========================================
   MOBILE SEARCH
========================================= */

@media (max-width: 767px) {

    .dashboard-search {
        width: 200px;
    }

}

@media (max-width: 480px) {

    .dashboard-search {
        width: 150px;
    }

    .dashboard-search .form-control {
        font-size: 12px;
    }

}

/* =========================================
   VENDOR PROFILE
========================================= */

.profile-btn {
    cursor: pointer;
    padding: 5px 10px;
    border-radius: 10px;
    color: #333;
    transition: all 0.2s ease;
}

.profile-btn:hover {
    background: #f5f7fb;
}

.profile-image {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #eeeeee;
}

.profile-info h6 {
    font-size: 14px;
    font-weight: 600;
    color: #ded6d6;
}

.profile-info small {
    font-size: 11px;
    color: #888;
}


/* =========================================
   PROFILE DROPDOWN
========================================= */

.profile-btn::after {
    margin-left: 8px;
}

.dropdown-menu {
    min-width: 190px;
    padding: 8px;
    border-radius: 10px;
}

.dropdown-item {
    padding: 10px 12px;
    border-radius: 7px;
    font-size: 14px;
}

.dropdown-item:hover {
    background: #f4f6ff;
}

.dropdown-item i {
    width: 18px;
    text-align: center;
}
</style>