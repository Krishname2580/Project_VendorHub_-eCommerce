<%- include("../layouts/header",{title:"Notification Details"}) %>

    <%- include("../layouts/navbar") %>

        <%- include("../layouts/sidebar") %>

            <div class="main-content">

                <div class="container-fluid py-4">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <h2>

                            <i class="fas fa-envelope-open-text text-primary me-2"></i>

                            Notification Details

                        </h2>

                        <a href="/vendor/notification/list" class="btn btn-secondary">

                            Back

                        </a>

                    </div>

                    <div class="card shadow">

                        <div class="card-header bg-primary text-white">

                            <h4>

                                <%= notification.title %>

                            </h4>

                        </div>

                        <div class="card-body">

                            <p>

                                <strong>Type :</strong>

                                <span class="badge bg-info">

                                    <%= notification.type %>

                                </span>

                            </p>

                            <hr>

                            <p>

                                <%= notification.message %>

                            </p>

                            <hr>

                            <p>

                                <strong>Status :</strong>

                                <% if(notification.isRead){ %>

                                    <span class="badge bg-success">

                                        Read

                                    </span>

                                    <% }else{ %>

                                        <span class="badge bg-danger">

                                            Unread

                                        </span>

                                        <% } %>

                            </p>

                            <p>

                                <strong>Date :</strong>

                                <%= notification.createdAt.toLocaleString() %>

                            </p>

                        </div>

                        <div class="card-footer">

                            <a href="/vendor/notification/delete/<%= notification._id %>"
                                onclick="return confirm('Delete notification?')" class="btn btn-danger">

                                Delete

                            </a>

                        </div>

                    </div>

                </div>

            </div>

            <%- include("../layouts/footer") %>

                <%- include("../layouts/scripts") %>