<%- include("../layouts/header",{title:"Notifications"}) %>

    <%- include("../layouts/navbar") %>

        <%- include("../layouts/sidebar") %>

            <div class="main-content">

                <div class="container-fluid py-4">

                    <!-- ================= HEADER ================= -->

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div>

                            <h2 class="fw-bold mb-1">

                                <i class="fas fa-bell text-warning me-2"></i>

                                Notifications

                            </h2>

                            <p class="text-muted mb-0">

                                View your latest orders and system updates.

                            </p>

                        </div>

                        <% if(notifications && notifications.some(n=> !n.isRead)){ %>

                            <a href="/vendor/notification/read-all"
                               class="btn btn-success">

                                <i class="fas fa-check-double me-2"></i>

                                Mark All Read

                            </a>

                            <% } %>

                    </div>


                    <!-- ================= NOTIFICATION CARD ================= -->

                    <div class="card shadow-sm border-0 notification-card">

                        <div class="card-header bg-white border-0 py-3">

                            <div class="d-flex justify-content-between align-items-center">

                                <h5 class="mb-0 fw-bold">

                                    <i class="fas fa-list me-2 text-primary"></i>

                                    Notification List

                                </h5>

                                <span class="badge bg-primary">

                                    <%= notifications ? notifications.length : 0 %>
                                    Notifications

                                </span>

                            </div>

                        </div>


                        <div class="card-body p-0">

                            <% if(notifications && notifications.length){ %>

                                <div class="table-responsive">

                                    <table class="table table-hover align-middle mb-0">

                                        <thead class="table-light">

                                            <tr>

                                                <th class="text-center">
                                                    #
                                                </th>

                                                <th>
                                                    Notification
                                                </th>

                                                <th>
                                                    Message
                                                </th>

                                                <th class="text-center">
                                                    Type
                                                </th>

                                                <th class="text-center">
                                                    Status
                                                </th>

                                                <th class="text-center">
                                                    Date
                                                </th>

                                                <th class="text-center" width="230">
                                                    Action
                                                </th>

                                            </tr>

                                        </thead>


                                        <tbody>

                                            <% notifications.forEach((notification,index)=>{ %>

                                                <tr class="<%= !notification.isRead ? 'unread-notification' : '' %>">

                                                    <!-- Number -->

                                                    <td class="text-center">

                                                        <span class="notification-number">

                                                            <%= index + 1 %>

                                                        </span>

                                                    </td>


                                                    <!-- Title -->

                                                    <td>

                                                        <div class="d-flex align-items-center">

                                                            <div class="notification-icon
                                                                <%= notification.isRead ? 'read-icon' : 'unread-icon' %>">

                                                                <% if(notification.type === "order"){ %>

                                                                    <i class="fas fa-shopping-bag"></i>

                                                                    <% }else if(notification.type === "product"){ %>

                                                                        <i class="fas fa-box"></i>

                                                                        <% }else if(notification.type === "vendor"){ %>

                                                                            <i class="fas fa-store"></i>

                                                                            <% }else if(notification.type === "customer"){ %>

                                                                                <i class="fas fa-user"></i>

                                                                                <% }else{ %>

                                                                                    <i class="fas fa-bell"></i>

                                                                                    <% } %>

                                                            </div>

                                                            <div>

                                                                <strong class="notification-title">

                                                                    <%= notification.title %>

                                                                </strong>

                                                                <% if(!notification.isRead){ %>

                                                                    <span class="new-label">

                                                                        NEW

                                                                    </span>

                                                                    <% } %>

                                                            </div>

                                                        </div>

                                                    </td>


                                                    <!-- Message -->

                                                    <td>

                                                        <span class="notification-message">

                                                            <%= notification.message %>

                                                        </span>

                                                    </td>


                                                    <!-- Type -->

                                                    <td class="text-center">

                                                        <% if(notification.type === "order"){ %>

                                                            <span class="badge bg-primary">

                                                                <i class="fas fa-shopping-cart me-1"></i>

                                                                Order

                                                            </span>

                                                            <% }else if(notification.type === "product"){ %>

                                                                <span class="badge bg-info">

                                                                    <i class="fas fa-box me-1"></i>

                                                                    Product

                                                                </span>

                                                                <% }else if(notification.type === "vendor"){ %>

                                                                    <span class="badge bg-warning text-dark">

                                                                        <i class="fas fa-store me-1"></i>

                                                                        Vendor

                                                                    </span>

                                                                    <% }else if(notification.type === "customer"){ %>

                                                                        <span class="badge bg-success">

                                                                            <i class="fas fa-user me-1"></i>

                                                                            Customer

                                                                        </span>

                                                                        <% }else{ %>

                                                                            <span class="badge bg-secondary">

                                                                                <i class="fas fa-cog me-1"></i>

                                                                                System

                                                                            </span>

                                                                            <% } %>

                                                    </td>


                                                    <!-- Status -->

                                                    <td class="text-center">

                                                        <% if(notification.isRead){ %>

                                                            <span class="status-badge read">

                                                                <i class="fas fa-check-circle me-1"></i>

                                                                Read

                                                            </span>

                                                            <% }else{ %>

                                                                <span class="status-badge unread">

                                                                    <i class="fas fa-circle me-1"></i>

                                                                    Unread

                                                                </span>

                                                                <% } %>

                                                    </td>


                                                    <!-- Date -->

                                                    <td class="text-center">

                                                        <div class="notification-date">

                                                            <i class="far fa-calendar-alt me-1"></i>

                                                            <%= new Date(notification.createdAt).toLocaleDateString() %>

                                                        </div>

                                                    </td>


                                                    <!-- Actions -->

                                                    <td class="text-center">

                                                        <div class="notification-actions">

                                                            <!-- View -->

                                                            <a href="/vendor/notification/details/<%= notification._id %>"
                                                               class="btn btn-primary btn-sm"
                                                               title="View Notification">

                                                                <i class="fas fa-eye"></i>

                                                                View

                                                            </a>


                                                            <!-- Mark Read -->

                                                            <% if(!notification.isRead){ %>

                                                                <a href="/vendor/notification/read/<%= notification._id %>"
                                                                   class="btn btn-success btn-sm"
                                                                   title="Mark as Read">

                                                                    <i class="fas fa-check"></i>

                                                                </a>

                                                                <% } %>


                                                            <!-- Delete -->

                                                            <a href="/vendor/notification/delete/<%= notification._id %>"
                                                               onclick="return confirm('Delete this notification?')"
                                                               class="btn btn-danger btn-sm"
                                                               title="Delete Notification">

                                                                <i class="fas fa-trash"></i>

                                                            </a>

                                                        </div>

                                                    </td>

                                                </tr>

                                                <% }) %>

                                        </tbody>

                                    </table>

                                </div>


                                <% }else{ %>


                                    <!-- ================= EMPTY ================= -->

                                    <div class="text-center py-5">

                                        <div class="empty-notification-icon">

                                            <i class="fas fa-bell-slash"></i>

                                        </div>

                                        <h4 class="fw-bold mt-3">

                                            No Notifications

                                        </h4>

                                        <p class="text-muted">

                                            You don't have any notifications yet.

                                        </p>

                                    </div>


                                    <% } %>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================= CSS ================= -->

            <style>

                .notification-card {

                    border-radius: 15px;

                    overflow: hidden;

                }


                /* Notification table */

                .notification-card .table th {

                    font-size: 13px;

                    font-weight: 700;

                    color: #555;

                    padding: 15px 12px;

                    white-space: nowrap;

                }


                .notification-card .table td {

                    padding: 15px 12px;

                }


                /* Unread notification */

                .unread-notification {

                    background: #f7f9ff !important;

                    border-left: 4px solid #0d6efd;

                }


                .unread-notification:hover {

                    background: #eef4ff !important;

                }


                /* Number */

                .notification-number {

                    width: 30px;

                    height: 30px;

                    display: inline-flex;

                    align-items: center;

                    justify-content: center;

                    border-radius: 50%;

                    background: #f1f3f5;

                    font-weight: 600;

                    font-size: 13px;

                }


                /* Notification icon */

                .notification-icon {

                    width: 42px;

                    height: 42px;

                    min-width: 42px;

                    border-radius: 10px;

                    display: flex;

                    align-items: center;

                    justify-content: center;

                    margin-right: 12px;

                    font-size: 17px;

                }


                .unread-icon {

                    background: #e7f0ff;

                    color: #0d6efd;

                }


                .read-icon {

                    background: #f1f3f5;

                    color: #777;

                }


                /* Title */

                .notification-title {

                    font-size: 14px;

                    color: #222;

                }


                /* New label */

                .new-label {

                    display: inline-block;

                    margin-left: 7px;

                    padding: 3px 6px;

                    border-radius: 5px;

                    background: #dc3545;

                    color: white;

                    font-size: 9px;

                    font-weight: 700;

                    vertical-align: middle;

                }


                /* Message */

                .notification-message {

                    display: block;

                    max-width: 300px;

                    color: #666;

                    font-size: 13px;

                    white-space: nowrap;

                    overflow: hidden;

                    text-overflow: ellipsis;

                }


                /* Status */

                .status-badge {

                    display: inline-flex;

                    align-items: center;

                    padding: 6px 10px;

                    border-radius: 20px;

                    font-size: 11px;

                    font-weight: 600;

                }


                .status-badge.read {

                    background: #e8f7ee;

                    color: #198754;

                }


                .status-badge.unread {

                    background: #fff0f1;

                    color: #dc3545;

                }


                /* Date */

                .notification-date {

                    font-size: 12px;

                    color: #777;

                    white-space: nowrap;

                }


                /* Actions */

                .notification-actions {

                    display: flex;

                    align-items: center;

                    justify-content: center;

                    gap: 5px;

                }


                .notification-actions .btn {

                    border-radius: 6px;

                    font-size: 12px;

                }


                /* Empty state */

                .empty-notification-icon {

                    width: 90px;

                    height: 90px;

                    margin: auto;

                    border-radius: 50%;

                    background: #f1f3f5;

                    display: flex;

                    align-items: center;

                    justify-content: center;

                    color: #adb5bd;

                    font-size: 38px;

                }


                /* Mobile */

                @media(max-width: 768px) {

                    .notification-message {

                        max-width: 180px;

                    }

                    .notification-actions {

                        flex-wrap: wrap;

                    }

                    .notification-icon {

                        width: 36px;

                        height: 36px;

                        min-width: 36px;

                    }

                }


                /* Print */

                @media print {

                    .sidebar,
                    .navbar,
                    .btn {

                        display: none !important;

                    }

                    .main-content {

                        margin: 0 !important;

                        padding: 0 !important;

                    }

                    .notification-card {

                        box-shadow: none !important;

                    }

                }

            </style>


            <%- include("../layouts/footer") %>

                <%- include("../layouts/scripts") %>