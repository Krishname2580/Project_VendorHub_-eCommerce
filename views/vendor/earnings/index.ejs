<%- include("../layouts/header", { title: "Earnings Dashboard" }) %>

    <%- include("../layouts/navbar") %>

        <%- include("../layouts/sidebar") %>

            <div class="container-fluid p-4">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <h3>Vendor Earnings</h3>

                    <a href="/vendor/payouts/request" class="btn btn-success">

                        <i class="fas fa-wallet"></i>

                        Request Payout

                    </a>

                </div>

                <!-- Summary Cards -->

                <div class="row">

                    <div class="col-lg-3 col-md-6 mb-3">

                        <div class="card bg-primary text-white shadow">

                            <div class="card-body">

                                <h6>Total Earnings</h6>

                                <h3>

                                    ₹ <%= totalEarnings %>

                                </h3>

                            </div>

                        </div>

                    </div>

                    <div class="col-lg-3 col-md-6 mb-3">

                        <div class="card bg-success text-white shadow">

                            <div class="card-body">

                                <h6>Today's Earnings</h6>

                                <h3>

                                    ₹ <%= todayEarnings %>

                                </h3>

                            </div>

                        </div>

                    </div>

                    <div class="col-lg-3 col-md-6 mb-3">

                        <div class="card bg-warning text-dark shadow">

                            <div class="card-body">

                                <h6>This Month</h6>

                                <h3>

                                    ₹ <%= monthlyEarnings %>

                                </h3>

                            </div>

                        </div>

                    </div>

                    <div class="col-lg-3 col-md-6 mb-3">

                        <div class="card bg-danger text-white shadow">

                            <div class="card-body">

                                <h6>Pending Amount</h6>

                                <h3>

                                    ₹ <%= pendingAmount %>

                                </h3>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Second Row -->

                <div class="row mt-2">

                    <div class="col-lg-4">

                        <div class="card shadow">

                            <div class="card-body text-center">

                                <h5>Withdrawn</h5>

                                <h2 class="text-success">

                                    ₹ <%= withdrawnAmount %>

                                </h2>

                            </div>

                        </div>

                    </div>

                    <div class="col-lg-4">

                        <div class="card shadow">

                            <div class="card-body text-center">

                                <h5>Available Balance</h5>

                                <h2 class="text-primary">

                                    ₹ <%= availableBalance %>

                                </h2>

                            </div>

                        </div>

                    </div>

                    <div class="col-lg-4">

                        <div class="card shadow">

                            <div class="card-body text-center">

                                <h5>Total Orders</h5>

                                <h2>

                                    <%= totalOrders %>

                                </h2>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Earnings Chart -->

                <div class="card shadow mt-4">

                    <div class="card-header">

                        Monthly Earnings

                    </div>

                    <div class="card-body">

                        <canvas id="earningChart"></canvas>

                    </div>

                </div>

                <!-- Recent Transactions -->

                <div class="card shadow mt-4">

                    <div class="card-header">

                        Recent Transactions

                    </div>

                    <div class="card-body">

                        <table class="table table-bordered">

                            <thead class="table-dark">

                                <tr>

                                    <th>Date</th>

                                    <th>Order</th>

                                    <th>Customer</th>

                                    <th>Amount</th>

                                    <th>Status</th>

                                </tr>

                            </thead>

                            <tbody>

                                <% if(transactions.length){ %>

                                    <% transactions.forEach(transaction=>{ %>

                                        <tr>

                                            <td>

                                                <%= transaction.createdAt.toDateString() %>

                                            </td>

                                            <td>

                                                <%= transaction.orderNumber %>

                                            </td>

                                            <td>

                                                <%= transaction.customer.name %>

                                            </td>

                                            <td>

                                                ₹ <%= transaction.totalAmount %>

                                            </td>

                                            <td>

                                                <span class="badge bg-success">

                                                    <%= transaction.paymentStatus %>

                                                </span>

                                            </td>

                                        </tr>

                                        <% }) %>

                                            <% } else { %>

                                                <tr>

                                                    <td colspan="5" class="text-center">

                                                        No Transactions Found

                                                    </td>

                                                </tr>

                                                <% } %>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

            <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

            <script>

                const ctx = document.getElementById("earningChart");

                new Chart(ctx, {

                    type: "bar",

                    data: {

                        labels: JSON.stringify(monthLabels),

                        datasets: [{

                            label: "Monthly Earnings",

                            data: JSON.stringify(monthValues)

                        }]

                    },

                    options: {

                        responsive: true

                    }

                });

            </script>

            <%- include("../layouts/footer") %>

                <%- include("../layouts/scripts") %>