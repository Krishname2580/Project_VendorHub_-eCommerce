<%- include('layouts/header') %>

    <!-- ============================= -->
    <!-- Checkout Page Header -->
    <!-- ============================= -->
    <div class="container-fluid page-header py-5">
        <h1 class="text-center text-white display-6">
            Checkout Page
        </h1>

        <ol class="breadcrumb justify-content-center mb-0">
            <li class="breadcrumb-item">
                <a href="/customer/home">Home</a>
            </li>

            <li class="breadcrumb-item">
                <a href="/customer/cart">Cart</a>
            </li>

            <li class="breadcrumb-item active text-white">
                Checkout
            </li>
        </ol>
    </div>


    <!-- ============================= -->
    <!-- Services -->
    <!-- ============================= -->
    <div class="container-fluid px-0">

        <div class="row g-0">

            <div class="col-6 col-md-4 col-lg-2 border-start border-end">
                <div class="p-4">
                    <div class="d-flex align-items-center">
                        <i class="fa fa-sync-alt fa-2x text-primary"></i>

                        <div class="ms-3">
                            <h6 class="text-uppercase mb-2">
                                Free Return
                            </h6>

                            <p class="mb-0">
                                30 days money back guarantee
                            </p>
                        </div>
                    </div>
                </div>
            </div>


            <div class="col-6 col-md-4 col-lg-2 border-end">
                <div class="p-4">
                    <div class="d-flex align-items-center">
                        <i class="fab fa-telegram-plane fa-2x text-primary"></i>

                        <div class="ms-3">
                            <h6 class="text-uppercase mb-2">
                                Free Shipping
                            </h6>

                            <p class="mb-0">
                                Free shipping on selected orders
                            </p>
                        </div>
                    </div>
                </div>
            </div>


            <div class="col-6 col-md-4 col-lg-2 border-end">
                <div class="p-4">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-life-ring fa-2x text-primary"></i>

                        <div class="ms-3">
                            <h6 class="text-uppercase mb-2">
                                Support 24/7
                            </h6>

                            <p class="mb-0">
                                We support you 24 hours
                            </p>
                        </div>
                    </div>
                </div>
            </div>


            <div class="col-6 col-md-4 col-lg-2 border-end">
                <div class="p-4">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-credit-card fa-2x text-primary"></i>

                        <div class="ms-3">
                            <h6 class="text-uppercase mb-2">
                                Secure Payment
                            </h6>

                            <p class="mb-0">
                                Secure payment methods
                            </p>
                        </div>
                    </div>
                </div>
            </div>


            <div class="col-6 col-md-4 col-lg-2 border-end">
                <div class="p-4">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-lock fa-2x text-primary"></i>

                        <div class="ms-3">
                            <h6 class="text-uppercase mb-2">
                                Secure
                            </h6>

                            <p class="mb-0">
                                Your information is protected
                            </p>
                        </div>
                    </div>
                </div>
            </div>


            <div class="col-6 col-md-4 col-lg-2 border-end">
                <div class="p-4">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-headset fa-2x text-primary"></i>

                        <div class="ms-3">
                            <h6 class="text-uppercase mb-2">
                                Online Service
                            </h6>

                            <p class="mb-0">
                                Customer support available
                            </p>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>


    <!-- ============================= -->
    <!-- Checkout -->
    <!-- ============================= -->
    <div class="container-fluid bg-light overflow-hidden py-5">

        <div class="container py-5">

            <% if (!cartItems || cartItems.length===0) { %>

                <!-- Empty Cart -->
                <div class="text-center py-5">

                    <i class="fa fa-shopping-cart fa-5x text-primary mb-4"></i>

                    <h2 class="mb-3">
                        Your Cart is Empty
                    </h2>

                    <p class="text-muted mb-4">
                        Please add products to your cart before checkout.
                    </p>

                    <a href="/product" class="btn btn-primary rounded-pill px-5 py-3">
                        Continue Shopping
                    </a>

                </div>

                <% } else { %>


                    <form id="checkoutForm" action="/customer/checkout/place-order" method="POST">

                        <div class="row g-5">


                            <!-- ============================= -->
                            <!-- Billing Details -->
                            <!-- ============================= -->

                            <div class="col-md-12 col-lg-6">

                                <div class="bg-white rounded p-4 shadow-sm">

                                    <h2 class="mb-4">
                                        <i class="fa fa-user text-primary me-2"></i>
                                        Billing Details
                                    </h2>


                                    <div class="row">

                                        <!-- First Name -->
                                        <div class="col-md-6">

                                            <div class="form-item mb-3">

                                                <label class="form-label">
                                                    First Name <sup>*</sup>
                                                </label>

                                                <input type="text" name="firstName" class="form-control"
                                                    value="<%= customer?.firstName || '' %>" required>

                                            </div>

                                        </div>


                                        <!-- Last Name -->
                                        <div class="col-md-6">

                                            <div class="form-item mb-3">

                                                <label class="form-label">
                                                    Last Name <sup>*</sup>
                                                </label>

                                                <input type="text" name="lastName" class="form-control"
                                                    value="<%= customer?.lastName || '' %>" required>

                                            </div>

                                        </div>

                                    </div>


                                    <!-- Email -->
                                    <div class="form-item mb-3">

                                        <label class="form-label">
                                            Email Address <sup>*</sup>
                                        </label>

                                        <input type="email" name="email" class="form-control"
                                            value="<%= customer?.email || '' %>" required>

                                    </div>


                                    <!-- Mobile -->
                                    <div class="form-item mb-3">

                                        <label class="form-label">
                                            Mobile Number <sup>*</sup>
                                        </label>

                                        <input type="tel" name="phone" class="form-control"
                                            value="<%= customer?.phone || '' %>" required>

                                    </div>


                                    <!-- Address -->
                                    <div class="form-item mb-3">

                                        <label class="form-label">
                                            Address <sup>*</sup>
                                        </label>

                                        <textarea name="address" class="form-control" rows="3"
                                            placeholder="House Number, Street Name"
                                            required><%= customer?.address || '' %></textarea>

                                    </div>


                                    <div class="row">

                                        <!-- City -->
                                        <div class="col-md-6">

                                            <div class="form-item mb-3">

                                                <label class="form-label">
                                                    City <sup>*</sup>
                                                </label>

                                                <input type="text" name="city" class="form-control" required>

                                            </div>

                                        </div>


                                        <!-- State -->
                                        <div class="col-md-6">

                                            <div class="form-item mb-3">

                                                <label class="form-label">
                                                    State <sup>*</sup>
                                                </label>

                                                <input type="text" name="state" class="form-control" required>

                                            </div>

                                        </div>

                                    </div>


                                    <div class="row">

                                        <!-- Country -->
                                        <div class="col-md-6">

                                            <div class="form-item mb-3">

                                                <label class="form-label">
                                                    Country <sup>*</sup>
                                                </label>

                                                <input type="text" name="country" class="form-control" value="India"
                                                    required>

                                            </div>

                                        </div>


                                        <!-- Pincode -->
                                        <div class="col-md-6">

                                            <div class="form-item mb-3">

                                                <label class="form-label">
                                                    Pincode <sup>*</sup>
                                                </label>

                                                <input type="text" name="pincode" class="form-control" required>

                                            </div>

                                        </div>

                                    </div>


                                    <!-- Order Notes -->
                                    <div class="form-item mb-3">

                                        <label class="form-label">
                                            Order Notes
                                        </label>

                                        <textarea name="orderNotes" class="form-control" rows="4"
                                            placeholder="Special instructions for your order"></textarea>

                                    </div>

                                </div>

                            </div>



                            <!-- ============================= -->
                            <!-- Order Summary -->
                            <!-- ============================= -->

                            <div class="col-md-12 col-lg-6">

                                <div class="bg-white rounded p-4 shadow-sm">

                                    <h2 class="mb-4">
                                        <i class="fa fa-shopping-bag text-primary me-2"></i>
                                        Your Order
                                    </h2>


                                    <!-- Products -->
                                    <div class="table-responsive">

                                        <table class="table align-middle">

                                            <thead>

                                                <tr>

                                                    <th>
                                                        Product
                                                    </th>

                                                    <th class="text-center">
                                                        Qty
                                                    </th>

                                                    <th class="text-end">
                                                        Total
                                                    </th>

                                                </tr>

                                            </thead>


                                            <tbody>

                                                <% cartItems.forEach(item=> { %>

                                                    <tr>

                                                        <!-- Product -->
                                                        <td>

                                                            <div class="d-flex align-items-center">

                                                                <img src="<%= item.product.images?.[0]?.imageUrl || item.product.thumbnail || '/img/no-image.png' %>"
                                                                    class="rounded"
                                                                    style="width:65px;height:65px;object-fit:contain;"
                                                                    alt="<%= item.product.name %>">

                                                                <div class="ms-3">

                                                                    <h6 class="mb-1">
                                                                        <%= item.product.name %>
                                                                    </h6>

                                                                    <small class="text-muted">

                                                                        ₹<%= item.product.discountPrice> 0
                                                                            ? item.product.discountPrice
                                                                            : item.product.price %>

                                                                    </small>

                                                                </div>

                                                            </div>

                                                        </td>


                                                        <!-- Quantity -->
                                                        <td class="text-center">

                                                            <span class="badge bg-primary rounded-pill px-3 py-2">

                                                                <%= item.quantity %>

                                                            </span>

                                                        </td>


                                                        <!-- Item Total -->
                                                        <td class="text-end">

                                                            ₹<%= ( (item.product.discountPrice> 0
                                                                ? item.product.discountPrice
                                                                : item.product.price)
                                                                * item.quantity
                                                                ).toFixed(2) %>

                                                        </td>

                                                    </tr>

                                                    <% }) %>

                                            </tbody>

                                        </table>

                                    </div>


                                    <hr>


                                    <!-- Subtotal -->
                                    <div class="d-flex justify-content-between mb-3">

                                        <h6 class="mb-0">
                                            Subtotal
                                        </h6>

                                        <strong>
                                            ₹<%= total.toFixed(2) %>
                                        </strong>

                                    </div>


                                    <!-- Shipping -->
                                    <div class="d-flex justify-content-between mb-3">

                                        <h6 class="mb-0">
                                            Shipping
                                        </h6>

                                        <strong>

                                            <% if (total>= 500) { %>

                                                <span class="text-success">
                                                    FREE
                                                </span>

                                                <% } else { %>

                                                    ₹<%= shipping.toFixed(2) %>

                                                        <% } %>

                                        </strong>

                                    </div>


                                    <!-- Grand Total -->
                                    <div class="border-top pt-3 mt-3">

                                        <div class="d-flex justify-content-between">

                                            <h4>
                                                Grand Total
                                            </h4>

                                            <h4 class="text-primary">

                                                ₹<%= grandTotal.toFixed(2) %>

                                            </h4>

                                        </div>

                                    </div>


                                    <!-- ============================= -->
                                    <!-- Payment Method -->
                                    <!-- ============================= -->

                                    <div class="mt-4">

                                        <h5 class="mb-3">
                                            Payment Method
                                        </h5>


                                        <!-- COD -->
                                        <div class="form-check border rounded p-3 mb-2">

                                            <input class="form-check-input ms-0 me-2" type="radio" name="paymentMethod"
                                                id="cod" value="COD" required>

                                            <label class="form-check-label" for="cod">

                                                <i class="fa fa-money-bill-wave text-success me-2"></i>

                                                Cash On Delivery

                                            </label>

                                        </div>


                                        <!-- Bank -->
                                        <!-- <div class="form-check border rounded p-3 mb-2">

                                            <input class="form-check-input ms-0 me-2" type="radio" name="paymentMethod"
                                                id="bank" value="Bank">

                                            <label class="form-check-label" for="bank">

                                                <i class="fa fa-university text-primary me-2"></i>

                                                Direct Bank Transfer

                                            </label>

                                        </div> -->


                                        <!-- Online -->
                                        <div class="form-check border rounded p-3 mb-2">

                                            <input class="form-check-input ms-0 me-2" type="radio" name="paymentMethod"
                                                id="online" value="Razorpay">

                                            <label class="form-check-label" for="online">

                                                <i class="fa fa-credit-card text-primary me-2"></i>

                                                Online Payment

                                            </label>

                                        </div>

                                    </div>


                                    <!-- Place Order -->
                                    <div class="mt-4">

                                        <button type="submit" class="btn btn-primary rounded-pill py-3 w-100">

                                            <i class="fa fa-lock me-2"></i>

                                            Place Order

                                        </button>

                                    </div>


                                    <!-- Back Cart -->
                                    <div class="text-center mt-3">

                                        <a href="/customer/cart" class="text-decoration-none">

                                            <i class="fa fa-arrow-left me-1"></i>

                                            Back to Cart

                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </form>

                    <% } %>

        </div>

    </div>


    <!-- ============================= -->
    <!-- Checkout Page End -->
    <!-- ============================= -->

    <%- include('layouts/footer') %>

    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>

const checkoutForm =
    document.getElementById("checkoutForm");


checkoutForm.addEventListener(
    "submit",
    async function (e) {

        e.preventDefault();


        const paymentMethod =
            document.querySelector(
                'input[name="paymentMethod"]:checked'
            );


        if (!paymentMethod) {

            alert(
                "Please select a payment method"
            );

            return;

        }


        // ==========================================
        // COD
        // ==========================================

        if (
            paymentMethod.value === "COD"
        ) {

            checkoutForm.submit();

            return;

        }


        // ==========================================
        // RAZORPAY
        // ==========================================

        if (
            paymentMethod.value === "Razorpay"
        ) {

            try {

                const formData =
                    new FormData(checkoutForm);


                const data =
                    Object.fromEntries(
                        formData.entries()
                    );


                // ==========================================
                // CREATE RAZORPAY ORDER
                // ==========================================

                const response =
                    await fetch(
                        "/customer/checkout/create-razorpay-order",
                        {

                            method: "POST",

                            headers: {

                                "Content-Type":
                                    "application/json"

                            },

                            body:
                                JSON.stringify(data)

                        }
                    );


                const result =
                    await response.json();


                if (!result.success) {

                    alert(
                        result.message ||
                        "Unable to start payment"
                    );

                    return;

                }


                // ==========================================
                // RAZORPAY OPTIONS
                // ==========================================

                const options = {

                    key:
                        result.key,

                    amount:
                        result.amount,

                    currency:
                        result.currency,

                    name:
                        "VendorHUB",

                    description:
                        "Order Payment",

                    order_id:
                        result.razorpayOrderId,


                    prefill: {

                        name:
                            result.customer.name,

                        email:
                            result.customer.email,

                        contact:
                            result.customer.phone

                    },


                    theme: {

                        color:
                            "#0F766E"

                    },


                    handler:
                        async function (
                            razorpayResponse
                        ) {


                            // ==========================================
                            // VERIFY PAYMENT
                            // ==========================================

                            const verifyResponse =
                                await fetch(
                                    "/customer/checkout/verify-razorpay-payment",
                                    {

                                        method: "POST",

                                        headers: {

                                            "Content-Type":
                                                "application/json"

                                        },

                                        body:
                                            JSON.stringify({

                                                razorpay_payment_id:
                                                    razorpayResponse
                                                        .razorpay_payment_id,

                                                razorpay_order_id:
                                                    razorpayResponse
                                                        .razorpay_order_id,

                                                razorpay_signature:
                                                    razorpayResponse
                                                        .razorpay_signature,

                                                orderId:
                                                    result.orderId

                                            })

                                    }
                                );


                            const verifyResult =
                                await verifyResponse.json();


                            if (
                                verifyResult.success
                            ) {

                                window.location.href =
                                    "/customer/order-success/" +
                                    verifyResult.orderId;

                            } else {

                                alert(
                                    verifyResult.message ||
                                    "Payment verification failed"
                                );

                            }

                        },


                    modal: {

                        ondismiss:
                            function () {

                                console.log(
                                    "Razorpay payment window closed"
                                );

                            }

                    }

                };


                const razorpay =
                    new Razorpay(options);


                razorpay.on(
                    "payment.failed",
                    function (response) {

                        console.log(
                            "Payment Failed:",
                            response.error
                        );


                        alert(
                            "Payment failed. Please try again."
                        );

                    }
                );


                razorpay.open();


            } catch (error) {

                console.error(
                    "Payment Error:",
                    error
                );


                alert(
                    "Unable to process payment"
                );

            }

        }

    }
);

</script>