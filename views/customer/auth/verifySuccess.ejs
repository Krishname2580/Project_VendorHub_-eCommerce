<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Email Verified</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <style>
        body {
            background: #f5f7fb;
        }

        .verify-card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, .08);
        }

        .success-icon {
            width: 120px;
            height: 120px;
            background: #22c55e;
            color: #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: auto;
            font-size: 55px;
        }

        .btn-login {
            border-radius: 10px;
            padding: 12px 30px;
            font-weight: 600;
        }
    </style>

</head>

<body>

    <div class="container py-5">

        <div class="row justify-content-center">

            <div class="col-lg-6">

                <div class="card verify-card">

                    <div class="card-body text-center p-5">

                        <div class="success-icon mb-4">

                            <i class="fas fa-check"></i>

                        </div>

                        <h2 class="fw-bold">

                            Email Verified Successfully

                        </h2>

                        <p class="text-muted mt-3">

                            Congratulations! Your VendorHub customer account has been verified successfully.

                        </p>

                        <p class="text-muted">

                            You can now log in and start shopping from your favorite vendors.

                        </p>

                        <a href="/customer/login" class="btn btn-primary btn-login mt-3">

                            <i class="fas fa-sign-in-alt me-2"></i>

                            Login Now

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>