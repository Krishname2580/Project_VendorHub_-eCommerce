<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Reset Password</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <style>
        body {
            background: #f5f7fb;
        }

        .reset-card {
            border: none;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 15px 40px rgba(0, 0, 0, .08);
        }

        .left-side {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: #fff;
            padding: 60px;
        }

        .form-control {
            height: 50px;
            border-radius: 10px;
        }

        .btn-reset {
            height: 50px;
            border-radius: 10px;
            font-weight: 600;
        }

        .password-box {
            position: relative;
        }

        .toggle-password {
            position: absolute;
            top: 50%;
            right: 15px;
            transform: translateY(-50%);
            cursor: pointer;
            color: #666;
        }
    </style>

</head>

<body>

    <div class="container py-5">

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="card reset-card">

                    <div class="row g-0">

                        <div class="col-lg-5 left-side d-flex flex-column justify-content-center">

                            <h2>Create New Password</h2>

                            <p class="mt-3">

                                Your new password must be secure and different from your previous password.

                            </p>

                        </div>

                        <div class="col-lg-7">

                            <div class="p-5">

                                <h3 class="mb-4">

                                    Reset Password

                                </h3>

                                <% if(typeof message !=="undefined" ){ %>

                                    <div class="alert alert-danger">

                                        <%= message %>

                                    </div>

                                    <% } %>

                                        <form method="POST">

                                            <div class="mb-3">

                                                <label>New Password</label>

                                                <div class="password-box">

                                                    <input type="password" id="password" name="password"
                                                        class="form-control" required>

                                                    <i class="fas fa-eye toggle-password" id="togglePassword"></i>

                                                </div>

                                            </div>

                                            <div class="mb-4">

                                                <label>Confirm Password</label>

                                                <div class="password-box">

                                                    <input type="password" id="confirmPassword" name="confirmPassword"
                                                        class="form-control" required>

                                                    <i class="fas fa-eye toggle-password" id="toggleConfirm"></i>

                                                </div>

                                            </div>

                                            <button class="btn btn-primary w-100 btn-reset">

                                                <i class="fas fa-key me-2"></i>

                                                Reset Password

                                            </button>

                                        </form>

                                        <hr>

                                        <p class="text-center">

                                            <a href="/customer/login">

                                                Back to Login

                                            </a>

                                        </p>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <script>

        function toggle(inputId, iconId) {

            const input = document.getElementById(inputId);

            const icon = document.getElementById(iconId);

            icon.addEventListener("click", () => {

                if (input.type === "password") {

                    input.type = "text";

                    icon.classList.replace("fa-eye", "fa-eye-slash");

                } else {

                    input.type = "password";

                    icon.classList.replace("fa-eye-slash", "fa-eye");

                }

            });

        }

        toggle("password", "togglePassword");

        toggle("confirmPassword", "toggleConfirm");

    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>