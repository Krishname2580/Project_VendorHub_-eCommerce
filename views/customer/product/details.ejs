<%- include("../layouts/header",{title:title}) %>

    <%- include("../layouts/navbar") %>

        <div class="container py-5">

            <div class="row">

                <!-- Product Images -->

                <div class="col-lg-5">

                    <div class="card shadow-sm">

                        <img src="<%= product.thumbnail %>" class="img-fluid rounded"
                            style="height:450px;object-fit:contain;">

                    </div>

                    <% if(product.images && product.images.length){ %>

                        <div class="row mt-3">

                            <% product.images.forEach(image=>{ %>

                                <div class="col-3 mb-3">

                                    <img src="<%= image.imageUrl %>" class="img-fluid border rounded"
                                        style="height:90px;width:100%;object-fit:cover;">

                                </div>

                                <% }) %>

                        </div>

                        <% } %>

                </div>

                <!-- Product Details -->

                <div class="col-lg-7">

                    <h2 class="fw-bold">

                        <%= product.name %>

                    </h2>

                    <p class="text-muted">

                        Brand :
                        <strong>

                            <%= product.brand ? product.brand.name : "N/A" %>

                        </strong>

                    </p>

                    <p>

                        Category :

                        <span class="badge bg-primary">

                            <%= product.category.name %>

                        </span>

                    </p>

                    <hr>

                    <h2 class="text-success">

                        ₹ <%= product.price %>

                    </h2>

                    <% if(product.discountPrice>0){ %>

                        <h5 class="text-danger">

                            Discount Price :
                            ₹ <%= product.discountPrice %>

                        </h5>

                        <% } %>

                            <p>

                                <strong>

                                    Stock :

                                </strong>

                                <% if(product.stock>0){ %>

                                    <span class="text-success">

                                        In Stock

                                    </span>

                                    <% }else{ %>

                                        <span class="text-danger">

                                            Out of Stock

                                        </span>

                                        <% } %>

                            </p>

                            <hr>

                            <h5>

                                Description

                            </h5>

                            <p>

                                <%= product.description %>

                            </p>

                            <% if(product.features && product.features.length){ %>

                                <h5 class="mt-4">

                                    Features

                                </h5>

                                <ul>

                                    <% product.features.forEach(feature=>{ %>

                                        <li>

                                            <%= feature %>

                                        </li>

                                        <% }) %>

                                </ul>

                                <% } %>

                                    <div class="mt-4 d-flex gap-3">

                                        <a href="/customer/cart/add/<%= product._id %>" class="btn btn-primary">

                                            <i class="fas fa-shopping-cart me-2"></i>

                                            Add To Cart

                                        </a>

                                        <a href="/customer/wishlist/add/<%= product._id %>"
                                            class="btn btn-outline-danger">

                                            <i class="far fa-heart me-2"></i>

                                            Wishlist

                                        </a>

                                        

                                    </div>

                </div>

            </div>

            <!-- Related Products -->

            <div class="mt-5">

                <h3 class="mb-4">

                    Related Products

                </h3>

                <div class="row">

                    <% relatedProducts.forEach(item=>{ %>

                        <div class="col-md-3 mb-4">

                            <div class="card h-100 shadow-sm">

                                <img src="<%= item.thumbnail %>" class="card-img-top"
                                    style="height:220px;object-fit:cover;">

                                <div class="card-body">

                                    <h6>

                                        <%= item.name %>

                                    </h6>

                                    <h5 class="text-success">

                                        ₹ <%= item.price %>

                                    </h5>

                                </div>

                                <div class="card-footer bg-white">

                                    <a href="/customer/product/<%= item._id %>" class="btn btn-outline-primary w-100">

                                        View Product

                                    </a>

                                </div>

                            </div>

                        </div>

                        <% }) %>

                </div>

            </div>

        </div>

        <%- include("../layouts/footer") %>