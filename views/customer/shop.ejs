<%- include('layouts/header') %>

<!-- ==========================================
     SHOP HEADER
========================================== -->

<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">
        Shop
    </h1>

    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item">
            <a href="/customer/home" class="text-white">
                Home
            </a>
        </li>

        <li class="breadcrumb-item active text-white">
            Shop
        </li>
    </ol>
</div>


<!-- ==========================================
     SHOP CONTENT
========================================== -->

<div class="container-fluid py-5">

    <div class="container py-4">

        <div class="row g-4">

            <!-- ==========================================
                 SIDEBAR
            =========================================== -->

            <div class="col-lg-3">

                <!-- SEARCH -->

                <div class="filter-box mb-4">

                    <h4 class="filter-title">
                        <i class="fa fa-search text-primary me-2"></i>
                        Search Products
                    </h4>

                    <form action="/shop" method="GET">

                        <% if (activeCategory) { %>

                            <input
                                type="hidden"
                                name="category"
                                value="<%= activeCategory %>"
                            >

                        <% } %>


                        <% if (color) { %>

                            <input
                                type="hidden"
                                name="color"
                                value="<%= color %>"
                            >

                        <% } %>


                        <% if (maxPrice && Number(maxPrice) < 50000) { %>

                            <input
                                type="hidden"
                                name="maxPrice"
                                value="<%= maxPrice %>"
                            >

                        <% } %>


                        <input
                            type="hidden"
                            name="sort"
                            value="<%= sort || '' %>"
                        >


                        <div class="input-group">

                            <input
                                type="text"
                                name="q"
                                class="form-control"
                                placeholder="Search products..."
                                value="<%= searchQuery || '' %>"
                            >

                            <button
                                type="submit"
                                class="btn btn-primary"
                            >
                                <i class="fa fa-search"></i>
                            </button>

                        </div>

                    </form>

                </div>


                <!-- ==========================================
                     CATEGORIES
                =========================================== -->

                <div class="filter-box mb-4">

                    <h4 class="filter-title">
                        <i class="fa fa-list text-primary me-2"></i>
                        Categories
                    </h4>


                    <div class="category-list">

                        <!-- ALL PRODUCTS -->

                        <a
                            href="/shop"
                            class="category-item <%= !activeCategory ? 'active' : '' %>"
                        >

                            <span>

                                <i class="fa fa-th-large me-2"></i>

                                All Products

                            </span>

                            <% if (!activeCategory) { %>

                                <i class="fa fa-check"></i>

                            <% } %>

                        </a>


                        <!-- CATEGORY LOOP -->

                        <% if (categories && categories.length > 0) { %>

                            <% categories.forEach(function(category) { %>

                                <a
                                    href="/shop?category=<%= category._id %>"
                                    class="category-item <%= String(activeCategory) === String(category._id) ? 'active' : '' %>"
                                >

                                    <span>

                                        <i class="fa fa-tag me-2"></i>

                                        <%= category.name %>

                                    </span>


                                    <% if (
                                        String(activeCategory) ===
                                        String(category._id)
                                    ) { %>

                                        <i class="fa fa-check"></i>

                                    <% } %>

                                </a>

                            <% }); %>

                        <% } else { %>

                            <p class="text-muted text-center mb-0">
                                No categories found.
                            </p>

                        <% } %>

                    </div>

                </div>


                <!-- ==========================================
                     PRICE FILTER
                =========================================== -->

                <div class="filter-box mb-4">

                    <h4 class="filter-title">

                        <i class="fa fa-filter text-primary me-2"></i>

                        Price Filter

                    </h4>


                    <form action="/shop" method="GET">

                        <!-- Preserve category -->

                        <% if (activeCategory) { %>

                            <input
                                type="hidden"
                                name="category"
                                value="<%= activeCategory %>"
                            >

                        <% } %>


                        <!-- Preserve search -->

                        <% if (searchQuery) { %>

                            <input
                                type="hidden"
                                name="q"
                                value="<%= searchQuery %>"
                            >

                        <% } %>


                        <!-- Preserve color -->

                        <% if (color) { %>

                            <input
                                type="hidden"
                                name="color"
                                value="<%= color %>"
                            >

                        <% } %>


                        <!-- Preserve sort -->

                        <% if (sort) { %>

                            <input
                                type="hidden"
                                name="sort"
                                value="<%= sort %>"
                            >

                        <% } %>


                        <input
                            type="range"
                            class="form-range"
                            id="rangeInput"
                            name="maxPrice"
                            min="0"
                            max="50000"
                            step="100"
                            value="<%= maxPrice ? Number(maxPrice) : 50000 %>"
                            oninput="
                                document.getElementById('amount').innerText =
                                '₹' + Number(this.value).toLocaleString('en-IN')
                            "
                        >


                        <div class="price-range-text">

                            <span>
                                ₹0
                            </span>

                            <output
                                id="amount"
                                class="fw-bold text-primary"
                            >
                                ₹<%= Number(maxPrice || 50000).toLocaleString('en-IN') %>
                            </output>

                            <span>
                                ₹50,000
                            </span>

                        </div>


                        <button
                            type="submit"
                            class="btn btn-primary rounded-pill w-100 mt-3"
                        >

                            <i class="fa fa-filter me-2"></i>

                            Apply Price

                        </button>

                    </form>

                </div>


                <!-- ==========================================
                     COLOR FILTER
                =========================================== -->

                <div class="filter-box mb-4">

                    <h4 class="filter-title">

                        <i class="fa fa-palette text-primary me-2"></i>

                        Select By Color

                    </h4>


                    <div class="color-list">


                        <!-- GOLD -->

                        <a
                            href="/shop?color=Gold"
                            class="<%= color === 'Gold' ? 'selected' : '' %>"
                        >

                            <span class="color-dot gold"></span>

                            Gold

                        </a>


                        <!-- GREEN -->

                        <a
                            href="/shop?color=Green"
                            class="<%= color === 'Green' ? 'selected' : '' %>"
                        >

                            <span class="color-dot green"></span>

                            Green

                        </a>


                        <!-- WHITE -->

                        <a
                            href="/shop?color=White"
                            class="<%= color === 'White' ? 'selected' : '' %>"
                        >

                            <span class="color-dot white"></span>

                            White

                        </a>


                        <!-- BLACK -->

                        <a
                            href="/shop?color=Black"
                            class="<%= color === 'Black' ? 'selected' : '' %>"
                        >

                            <span class="color-dot black"></span>

                            Black

                        </a>


                    </div>

                </div>


                <!-- ==========================================
                     CLEAR FILTERS
                =========================================== -->

                <div class="filter-box">

                    <a
                        href="/shop"
                        class="btn btn-outline-danger rounded-pill w-100"
                    >

                        <i class="fa fa-times me-2"></i>

                        Clear All Filters

                    </a>

                </div>

            </div>


            <!-- ==========================================
                 PRODUCTS SECTION
            =========================================== -->

            <div class="col-lg-9">


                <!-- ==========================================
                     TOP BAR
                =========================================== -->

                <div class="shop-topbar mb-4">

                    <div>

                        <h4 class="mb-1">
                            Our Products
                        </h4>

                        <small class="text-muted">

                            <% if (totalProducts > 0) { %>

                                Showing

                                <%= ((currentPageNumber - 1) * limit) + 1 %>

                                -

                                <%= Math.min(
                                    currentPageNumber * limit,
                                    totalProducts
                                ) %>

                                of

                                <%= totalProducts %>

                                products

                            <% } else { %>

                                No products found

                            <% } %>

                        </small>

                    </div>


                    <!-- SORT -->

                    <form
                        action="/shop"
                        method="GET"
                        class="sort-form"
                    >

                        <% if (activeCategory) { %>

                            <input
                                type="hidden"
                                name="category"
                                value="<%= activeCategory %>"
                            >

                        <% } %>


                        <% if (searchQuery) { %>

                            <input
                                type="hidden"
                                name="q"
                                value="<%= searchQuery %>"
                            >

                        <% } %>


                        <% if (color) { %>

                            <input
                                type="hidden"
                                name="color"
                                value="<%= color %>"
                            >

                        <% } %>


                        <% if (maxPrice && Number(maxPrice) < 50000) { %>

                            <input
                                type="hidden"
                                name="maxPrice"
                                value="<%= maxPrice %>"
                            >

                        <% } %>


                        <label class="text-muted">
                            Sort:
                        </label>


                        <select
                            name="sort"
                            class="form-select"
                            onchange="this.form.submit()"
                        >

                            <option
                                value=""
                                <%= !sort ? 'selected' : '' %>
                            >
                                Latest
                            </option>


                            <option
                                value="price-low"
                                <%= sort === 'price-low' ? 'selected' : '' %>
                            >
                                Price: Low to High
                            </option>


                            <option
                                value="price-high"
                                <%= sort === 'price-high' ? 'selected' : '' %>
                            >
                                Price: High to Low
                            </option>


                            <option
                                value="name"
                                <%= sort === 'name' ? 'selected' : '' %>
                            >
                                Name A-Z
                            </option>

                        </select>

                    </form>

                </div>


                <!-- ==========================================
                     ACTIVE FILTERS
                =========================================== -->

                <% if (
                    activeCategory ||
                    searchQuery ||
                    color ||
                    (maxPrice && Number(maxPrice) < 50000)
                ) { %>


                    <div class="active-filter-box mb-4">

                        <div class="d-flex flex-wrap gap-2 align-items-center">

                            <strong>
                                Active Filters:
                            </strong>


                            <% if (searchQuery) { %>

                                <span class="filter-badge">

                                    <i class="fa fa-search me-1"></i>

                                    <%= searchQuery %>

                                </span>

                            <% } %>


                            <% if (activeCategory) { %>

                                <span class="filter-badge">

                                    <i class="fa fa-tag me-1"></i>

                                    Category Selected

                                </span>

                            <% } %>


                            <% if (color) { %>

                                <span class="filter-badge">

                                    <i class="fa fa-circle me-1"></i>

                                    <%= color %>

                                </span>

                            <% } %>


                            <% if (
                                maxPrice &&
                                Number(maxPrice) < 50000
                            ) { %>

                                <span class="filter-badge">

                                    <i class="fa fa-rupee-sign me-1"></i>

                                    Under ₹<%= Number(maxPrice).toLocaleString('en-IN') %>

                                </span>

                            <% } %>


                            <a
                                href="/shop"
                                class="btn btn-sm btn-outline-danger rounded-pill"
                            >

                                Clear

                            </a>

                        </div>

                    </div>

                <% } %>


                <!-- ==========================================
                     PRODUCT GRID
                =========================================== -->

                <% if (products && products.length > 0) { %>


                    <div class="row g-4">


                        <% products.forEach(function(product) { %>


                            <div class="col-md-6 col-xl-4">


                                <div class="card product-card h-100 border-0 shadow-sm">


                                    <!-- IMAGE -->

                                    <div
                                        class="product-image-container position-relative"
                                    >

                                        <a
                                            href="/customer/product/<%= product._id %>"
                                        >

                                            <img
                                                src="<%= product.images?.[0]?.imageUrl || product.thumbnail || '/img/no-image.png' %>"
                                                class="product-image"
                                                alt="<%= product.name %>"
                                            >

                                        </a>


                                        <!-- DISCOUNT -->

                                        <% if (
                                            product.discountPrice &&
                                            product.price &&
                                            product.discountPrice < product.price
                                        ) { %>


                                            <span class="sale-badge">
                                                SALE
                                            </span>


                                            <%
                                                const discountPercentage =
                                                    Math.round(
                                                        (
                                                            (
                                                                product.price -
                                                                product.discountPrice
                                                            ) /
                                                            product.price
                                                        ) * 100
                                                    );
                                            %>


                                            <span class="discount-badge">

                                                -<%= discountPercentage %>%

                                            </span>


                                        <% } %>

                                    </div>


                                    <!-- BODY -->

                                    <div class="card-body d-flex flex-column p-4">


                                        <!-- CATEGORY -->

                                        <% if (product.category) { %>

                                            <small class="product-category">

                                                <i class="fa fa-tag me-1"></i>

                                                <%= product.category.name %>

                                            </small>

                                        <% } %>


                                        <!-- NAME -->

                                        <h5 class="product-name">

                                            <a
                                                href="/customer/product/<%= product._id %>"
                                                class="text-decoration-none"
                                            >

                                                <%= product.name %>

                                            </a>

                                        </h5>


                                        <!-- DESCRIPTION -->

                                        <p class="text-muted small product-description">

                                            <%= product.description
                                                ? product.description.substring(0, 75)
                                                : 'Quality product available now.'
                                            %>

                                            <%= product.description &&
                                                product.description.length > 75
                                                ? '...'
                                                : ''
                                            %>

                                        </p>


                                        <!-- PRICE -->

                                        <div class="product-price mb-3">


                                            <% if (
                                                product.discountPrice &&
                                                product.price &&
                                                product.discountPrice < product.price
                                            ) { %>


                                                <span class="current-price">

                                                    ₹<%= Number(
                                                        product.discountPrice
                                                    ).toLocaleString('en-IN') %>

                                                </span>


                                                <span class="old-price">

                                                    ₹<%= Number(
                                                        product.price
                                                    ).toLocaleString('en-IN') %>

                                                </span>


                                            <% } else { %>


                                                <span class="current-price">

                                                    ₹<%= Number(
                                                        product.price
                                                    ).toLocaleString('en-IN') %>

                                                </span>


                                            <% } %>

                                        </div>


                                        <!-- BUTTONS -->

                                        <div class="mt-auto product-buttons">


                                            <a
                                                href="/customer/product/<%= product._id %>"
                                                class="btn btn-outline-primary rounded-pill"
                                            >

                                                <i class="fa fa-eye me-1"></i>

                                                View

                                            </a>


                                            <form
                                                action="/customer/cart/add"
                                                method="POST"
                                                class="flex-grow-1"
                                            >

                                                <input
                                                    type="hidden"
                                                    name="productId"
                                                    value="<%= product._id %>"
                                                >

                                                <input
                                                    type="hidden"
                                                    name="quantity"
                                                    value="1"
                                                >


                                                <button
                                                    type="submit"
                                                    class="btn btn-primary rounded-pill w-100"
                                                >

                                                    <i class="fa fa-shopping-cart me-1"></i>

                                                    Add

                                                </button>

                                            </form>

                                        </div>

                                    </div>

                                </div>

                            </div>


                        <% }); %>

                    </div>


                <% } else { %>


                    <!-- ==========================================
                         NO PRODUCTS
                    =========================================== -->

                    <div class="no-products text-center">

                        <i class="fa fa-shopping-bag fa-4x text-primary mb-4"></i>

                        <h3>
                            No Products Found
                        </h3>

                        <p class="text-muted">
                            We couldn't find products matching your filters.
                        </p>

                        <a
                            href="/shop"
                            class="btn btn-primary rounded-pill px-5"
                        >

                            <i class="fa fa-refresh me-2"></i>

                            View All Products

                        </a>

                    </div>


                <% } %>


                <!-- ==========================================
                     PAGINATION
                =========================================== -->

                <% if (totalPages && totalPages > 1) { %>


                    <div class="pagination-wrapper mt-5">

                        <ul class="pagination">


                            <!-- PREVIOUS -->

                            <% if (currentPageNumber > 1) { %>

                                <li class="page-item">

                                    <a
                                        class="page-link rounded-pill"
                                        href="/shop?page=<%= currentPageNumber - 1 %>&category=<%= encodeURIComponent(activeCategory || '') %>&q=<%= encodeURIComponent(searchQuery || '') %>&maxPrice=<%= maxPrice && Number(maxPrice) < 50000 ? maxPrice : '' %>&color=<%= encodeURIComponent(color || '') %>&sort=<%= encodeURIComponent(sort || '') %>"
                                    >

                                        <i class="fas fa-chevron-left me-1"></i>

                                        Previous

                                    </a>

                                </li>

                            <% } %>


                            <!-- PAGE NUMBERS -->

                            <% for (
                                let i = 1;
                                i <= totalPages;
                                i++
                            ) { %>


                                <li
                                    class="page-item
                                    <%= currentPageNumber === i ? 'active' : '' %>"
                                >

                                    <a
                                        class="page-link page-number"
                                        href="/shop?page=<%= i %>&category=<%= encodeURIComponent(activeCategory || '') %>&q=<%= encodeURIComponent(searchQuery || '') %>&maxPrice=<%= maxPrice && Number(maxPrice) < 50000 ? maxPrice : '' %>&color=<%= encodeURIComponent(color || '') %>&sort=<%= encodeURIComponent(sort || '') %>"
                                    >

                                        <%= i %>

                                    </a>

                                </li>


                            <% } %>


                            <!-- NEXT -->

                            <% if (currentPageNumber < totalPages) { %>

                                <li class="page-item">

                                    <a
                                        class="page-link rounded-pill"
                                        href="/shop?page=<%= currentPageNumber + 1 %>&category=<%= encodeURIComponent(activeCategory || '') %>&q=<%= encodeURIComponent(searchQuery || '') %>&maxPrice=<%= maxPrice && Number(maxPrice) < 50000 ? maxPrice : '' %>&color=<%= encodeURIComponent(color || '') %>&sort=<%= encodeURIComponent(sort || '') %>"
                                    >

                                        Next

                                        <i class="fas fa-chevron-right ms-1"></i>

                                    </a>

                                </li>

                            <% } %>


                        </ul>


                        <!-- PAGE INFO -->

                        <div class="text-center text-muted mt-3">

                            Page

                            <strong>
                                <%= currentPageNumber %>
                            </strong>

                            of

                            <strong>
                                <%= totalPages %>
                            </strong>

                        </div>

                    </div>


                <% } %>


            </div>

        </div>

    </div>

</div>


<!-- ==========================================
     CUSTOM CSS
========================================== -->

<style>

.filter-box {
    background: #f8f9fa;
    border-radius: 15px;
    padding: 22px;
    border: 1px solid #eeeeee;
}

.filter-title {
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 20px;
}


/* CATEGORY */

.category-list {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.category-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 11px 13px;
    border-radius: 8px;
    color: #333;
    text-decoration: none;
    transition: all 0.25s ease;
}

.category-item:hover {
    background: rgba(242, 139, 0, 0.1);
    color: #F28B00;
}

.category-item.active {
    background: #F28B00;
    color: #fff;
}


/* PRICE */

.price-range-text {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
}


/* COLORS */

.color-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.color-list a {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #333;
    text-decoration: none;
    padding: 7px 10px;
    border-radius: 8px;
    transition: 0.25s;
}

.color-list a:hover {
    background: rgba(242, 139, 0, 0.1);
    color: #F28B00;
}

.color-list a.selected {
    background: rgba(242, 139, 0, 0.15);
    color: #F28B00;
    font-weight: 600;
}

.color-dot {
    width: 17px;
    height: 17px;
    border-radius: 50%;
    display: inline-block;
    border: 1px solid #ddd;
}

.color-dot.gold {
    background: #ffd700;
}

.color-dot.green {
    background: #198754;
}

.color-dot.white {
    background: #fff;
}

.color-dot.black {
    background: #000;
}


/* TOP BAR */

.shop-topbar {
    background: #f8f9fa;
    border-radius: 15px;
    padding: 18px 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
}

.sort-form {
    display: flex;
    align-items: center;
    gap: 10px;
}

.sort-form .form-select {
    min-width: 190px;
}


/* ACTIVE FILTER */

.active-filter-box {
    padding: 14px 18px;
    background: #fff8ed;
    border: 1px solid #ffe1b3;
    border-radius: 12px;
}

.filter-badge {
    background: #F28B00;
    color: #fff;
    padding: 7px 13px;
    border-radius: 20px;
    font-size: 13px;
}


/* PRODUCT CARD */

.product-card {
    overflow: hidden;
    border-radius: 15px;
    transition: all 0.3s ease;
}

.product-card:hover {
    transform: translateY(-7px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.12) !important;
}


/* PRODUCT IMAGE */

.product-image-container {
    height: 245px;
    background: #f8f9fa;
    overflow: hidden;
}

.product-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 20px;
    transition: transform 0.4s ease;
}

.product-card:hover .product-image {
    transform: scale(1.07);
}


/* SALE BADGE */

.sale-badge {
    position: absolute;
    top: 15px;
    left: 15px;
    background: #dc3545;
    color: #fff;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
}

.discount-badge {
    position: absolute;
    top: 15px;
    right: 15px;
    background: #F28B00;
    color: #fff;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
}


/* PRODUCT DETAILS */

.product-category {
    color: #F28B00;
    font-weight: 600;
}

.product-name {
    margin-top: 8px;
    font-size: 18px;
    line-height: 1.35;
}

.product-name a {
    color: #222;
    transition: 0.2s;
}

.product-name a:hover {
    color: #F28B00;
}

.product-description {
    min-height: 45px;
}

.product-price {
    display: flex;
    align-items: center;
    gap: 10px;
}

.current-price {
    color: #F28B00;
    font-size: 20px;
    font-weight: 700;
}

.old-price {
    color: #999;
    text-decoration: line-through;
    font-size: 14px;
}


/* BUTTONS */

.product-buttons {
    display: flex;
    gap: 8px;
}

.product-buttons > a {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
}


/* NO PRODUCTS */

.no-products {
    background: #f8f9fa;
    border-radius: 15px;
    padding: 70px 30px;
}


/* PAGINATION */

.pagination-wrapper {
    width: 100%;
    text-align: center;
}

.pagination {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    align-items: center;
    justify-content: center;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 7px;
}

.pagination .page-item {
    display: inline-flex !important;
    flex: 0 0 auto;
    margin: 0 !important;
}

.pagination .page-link {
    min-width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #F28B00;
    background: #fff;
    border: 1px solid #F28B00;
    text-decoration: none;
    transition: all 0.25s ease;
}

.pagination .page-number {
