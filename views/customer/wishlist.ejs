<%- include("./layouts/header") %>

<div class="container-fluid py-5">

    <div class="container">

        <!-- ==============================
             HEADER
        =============================== -->

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h2 class="fw-bold mb-1">

                    <i class="fas fa-heart text-danger me-2"></i>

                    My Wishlist

                </h2>

                <p class="text-muted mb-0">

                    Products you saved for later

                </p>

            </div>

            <a
                href="/shop"
                class="btn btn-primary rounded-pill px-4"
            >

                <i class="fas fa-shopping-bag me-2"></i>

                Continue Shopping

            </a>

        </div>


        <!-- ==============================
             WISHLIST
        =============================== -->

        <% if (wishlist && wishlist.length > 0) { %>

            <div class="row g-4">

                <% wishlist.forEach(item => { %>

                    <% if (item.product) { %>

                        <div class="col-lg-3 col-md-4 col-sm-6">

                            <div class="card wishlist-card h-100 border-0 shadow-sm">

                                <!-- Product Image -->

                                <div class="wishlist-image-wrapper">

                                    <a
                                        href="/product/<%= item.product._id %>"
                                    >

                                        <img
                                            src="<%= item.product.thumbnail || '/images/product/default.jpg' %>"
                                            class="card-img-top wishlist-image"
                                            alt="<%= item.product.name %>"
                                        >

                                    </a>


                                    <!-- Remove -->

                                    <a
                                        href="/customer/wishlist/remove/<%= item.product._id %>"
                                        class="remove-wishlist"
                                        onclick="return confirm('Remove this product from wishlist?')"
                                        title="Remove"
                                    >

                                        <i class="fas fa-heart"></i>

                                    </a>

                                </div>


                                <!-- Product Details -->

                                <div class="card-body">

                                    <% if (item.product.brand) { %>

                                        <small class="text-muted">

                                            <%= item.product.brand.name %>

                                        </small>

                                    <% } %>


                                    <h5 class="product-name mt-1">

                                        <a
                                            href="/product/<%= item.product._id %>"
                                            class="text-decoration-none text-dark"
                                        >

                                            <%= item.product.name %>

                                        </a>

                                    </h5>


                                    <div class="mb-3">

                                        <span class="price">

                                            ₹ <%= Number(item.product.price || 0).toLocaleString("en-IN") %>

                                        </span>

                                    </div>


                                    <div class="d-flex gap-2">

                                        <a
                                            href="/product/<%= item.product._id %>"
                                            class="btn btn-primary btn-sm rounded-pill flex-grow-1"
                                        >

                                            <i class="fas fa-eye me-1"></i>

                                            View

                                        </a>


                                        <a
                                            href="/customer/wishlist/remove/<%= item.product._id %>"
                                            class="btn btn-outline-danger btn-sm rounded-circle"
                                            onclick="return confirm('Remove from wishlist?')"
                                            title="Remove"
                                        >

                                            <i class="fas fa-trash"></i>

                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>

                    <% } %>

                <% }) %>

            </div>

        <% } else { %>


            <!-- ==============================
                 EMPTY WISHLIST
            =============================== -->

            <div class="card border-0 shadow-sm">

                <div class="card-body text-center py-5">

                    <div class="empty-wishlist-icon mb-4">

                        <i class="far fa-heart"></i>

                    </div>

                    <h3 class="fw-bold">

                        Your Wishlist is Empty

                    </h3>

                    <p class="text-muted mb-4">

                        You haven't added any products to your wishlist yet.

                    </p>

                    <a
                        href="/shop"
                        class="btn btn-primary rounded-pill px-5 py-2"
                    >

                        <i class="fas fa-shopping-bag me-2"></i>

                        Start Shopping

                    </a>

                </div>

            </div>

        <% } %>

    </div>

</div>


<!-- ==============================
     STYLE
=============================== -->

<style>

    .wishlist-card {

        border-radius: 16px;

        overflow: hidden;

        transition: all 0.3s ease;

    }


    .wishlist-card:hover {

        transform: translateY(-5px);

        box-shadow: 0 10px 30px rgba(0,0,0,0.12) !important;

    }


    .wishlist-image-wrapper {

        position: relative;

        height: 230px;

        background: #f8f9fa;

        overflow: hidden;

    }


    .wishlist-image {

        width: 100%;

        height: 100%;

        object-fit: contain;

        padding: 15px;

        transition: transform 0.3s ease;

    }


    .wishlist-card:hover .wishlist-image {

        transform: scale(1.05);

    }


    .remove-wishlist {

        position: absolute;

        top: 12px;

        right: 12px;

        width: 38px;

        height: 38px;

        display: flex;

        align-items: center;

        justify-content: center;

        border-radius: 50%;

        background: #ffffff;

        color: #dc3545;

        text-decoration: none;

        box-shadow: 0 3px 10px rgba(0,0,0,0.12);

        transition: all 0.2s ease;

    }


    .remove-wishlist:hover {

        background: #dc3545;

        color: #ffffff;

        transform: scale(1.1);

    }


    .product-name {

        font-size: 16px;

        font-weight: 600;

        min-height: 42px;

    }


    .product-name a:hover {

        color: #0d6efd !important;

    }


    .price {

        font-size: 18px;

        font-weight: 700;

        color: #198754;

    }


    .empty-wishlist-icon {

        width: 100px;

        height: 100px;

        margin: auto;

        display: flex;

        align-items: center;

        justify-content: center;

        border-radius: 50%;

        background: #fff0f2;

        color: #dc3545;

        font-size: 45px;

    }

</style>


<%- include("./layouts/footer") %>

<%- include("./layouts/scripts") %>