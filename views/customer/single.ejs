<%- include('layouts/header') %>


    <!-- Single Page Header Start -->
    <div class="container-fluid page-header py-5">

        <h1 class="text-center text-white display-6 wow fadeInUp" data-wow-delay="0.1s">

            <%= product.name %>

        </h1>

        <ol class="breadcrumb justify-content-center mb-0 wow fadeInUp" data-wow-delay="0.3s">

            <li class="breadcrumb-item">
                <a href="/">Home</a>
            </li>

            <li class="breadcrumb-item">
                <a href="/shop">Shop</a>
            </li>

            <li class="breadcrumb-item active text-white">
                <%= product.name %>
            </li>

        </ol>

    </div>
    <!-- Single Page Header End -->



    <!-- Single Products Start -->
    <div class="container-fluid shop py-5">

        <div class="container py-5">

            <div class="row g-4">


                <!-- ========================= -->
                <!-- LEFT SIDEBAR -->
                <!-- ========================= -->

                <div class="col-lg-5 col-xl-3 wow fadeInUp" data-wow-delay="0.1s">


                    <!-- Search -->
                    <div class="input-group w-100 mx-auto d-flex mb-4">

                        <form action="/shop" method="GET" class="input-group">

                            <input type="search" name="q" class="form-control p-3" placeholder="keywords">

                            <button type="submit" class="input-group-text p-3">

                                <i class="fa fa-search"></i>

                            </button>

                        </form>

                    </div>



                    <!-- Categories -->
                    <div class="product-categories mb-4">

                        <h4>
                            Products Categories
                        </h4>

                        <ul class="list-unstyled">

                            <% if (typeof categories !=='undefined' && categories.length> 0) { %>

                                <% categories.forEach(function(category) { %>

                                    <li>

                                        <div class="categories-item">

                                            <a href="/shop?category=<%= category._id %>" class="text-dark">

                                                <i class="fas fa-apple-alt text-secondary me-2"></i>

                                                <%= category.name %>

                                            </a>

                                        </div>

                                    </li>

                                    <% }); %>

                                        <% } else { %>

                                            <li>

                                                <span class="text-muted">
                                                    No categories found
                                                </span>

                                            </li>

                                            <% } %>

                        </ul>

                    </div>



                    <!-- Select Color -->
                    <div class="additional-product mb-4">

                        <h4>
                            Select By Color
                        </h4>

                        <div class="additional-product-item">

                            <input type="radio" class="me-2" id="Categories-1" name="Categories-1">

                            <label for="Categories-1" class="text-dark">

                                Gold

                            </label>

                        </div>


                        <div class="additional-product-item">

                            <input type="radio" class="me-2" id="Categories-2" name="Categories-1">

                            <label for="Categories-2" class="text-dark">

                                Green

                            </label>

                        </div>


                        <div class="additional-product-item">

                            <input type="radio" class="me-2" id="Categories-3" name="Categories-1">

                            <label for="Categories-3" class="text-dark">

                                White

                            </label>

                        </div>

                    </div>



                    <!-- Featured Products -->
                    <div class="featured-product mb-4">

                        <h4 class="mb-3">
                            Featured products
                        </h4>


                        <div class="featured-product-item">

                            <div class="rounded me-4" style="width:100px;height:100px;">

                                <img src="/img/product-3.png" class="img-fluid rounded" alt="SmartPhone">

                            </div>

                            <div>

                                <h6 class="mb-2">
                                    SmartPhone
                                </h6>

                                <div class="d-flex mb-2">

                                    <i class="fa fa-star text-secondary"></i>
                                    <i class="fa fa-star text-secondary"></i>
                                    <i class="fa fa-star text-secondary"></i>
                                    <i class="fa fa-star text-secondary"></i>
                                    <i class="fa fa-star"></i>

                                </div>

                                <div class="d-flex mb-2">

                                    <h5 class="fw-bold me-2">
                                        ₹2,999
                                    </h5>

                                    <h5 class="text-danger text-decoration-line-through">
                                        ₹4,111
                                    </h5>

                                </div>

                            </div>

                        </div>



                        <div class="featured-product-item">

                            <div class="rounded me-4" style="width:100px;height:100px;">

                                <img src="/img/product-4.png" class="img-fluid rounded" alt="Smart Camera">

                            </div>

                            <div>

                                <h6 class="mb-2">
                                    Smart Camera
                                </h6>

                                <div class="d-flex mb-2">

                                    <i class="fa fa-star text-secondary"></i>
                                    <i class="fa fa-star text-secondary"></i>
                                    <i class="fa fa-star text-secondary"></i>
                                    <i class="fa fa-star text-secondary"></i>
                                    <i class="fa fa-star"></i>

                                </div>

                                <div class="d-flex mb-2">

                                    <h5 class="fw-bold me-2">
                                        ₹2,999
                                    </h5>

                                    <h5 class="text-danger text-decoration-line-through">
                                        ₹4,111
                                    </h5>

                                </div>

                            </div>

                        </div>



                        <div class="featured-product-item">

                            <div class="rounded me-4" style="width:100px;height:100px;">

                                <img src="/img/product-5.png" class="img-fluid rounded" alt="Camera Lens">

                            </div>

                            <div>

                                <h6 class="mb-2">
                                    Camera Lens
                                </h6>

                                <div class="d-flex mb-2">

                                    <i class="fa fa-star text-secondary"></i>
                                    <i class="fa fa-star text-secondary"></i>
                                    <i class="fa fa-star text-secondary"></i>
                                    <i class="fa fa-star text-secondary"></i>
                                    <i class="fa fa-star"></i>

                                </div>

                                <div class="d-flex mb-2">

                                    <h5 class="fw-bold me-2">
                                        ₹2,999
                                    </h5>

                                    <h5 class="text-danger text-decoration-line-through">
                                        ₹4,111
                                    </h5>

                                </div>

                            </div>

                        </div>



                        <div class="d-flex justify-content-center my-4">

                            <a href="/shop" class="btn btn-primary px-4 py-3 rounded-pill w-100">

                                View More

                            </a>

                        </div>

                    </div>



                    <!-- Sale Banner -->
                    <a href="/shop">

                        <div class="position-relative">

                            <img src="/img/product-banner-2.jpg" class="img-fluid w-100 rounded" alt="Sale">

                            <div class="text-center position-absolute d-flex flex-column align-items-center justify-content-center rounded p-4"
                                style="width:100%;height:100%;top:0;right:0;background:rgba(242,139,0,0.3);">

                                <h5 class="display-6 text-primary">
                                    SALE
                                </h5>

                                <h4 class="text-secondary">
                                    Get UP To 50% Off
                                </h4>

                                <a href="/shop" class="btn btn-primary rounded-pill px-4">

                                    Shop Now

                                </a>

                            </div>

                        </div>

                    </a>



                    <!-- Product Tags -->
                    <div class="product-tags my-4">

                        <h4 class="mb-3">
                            PRODUCT TAGS
                        </h4>

                        <div class="product-tags-items bg-light rounded p-3">

                            <a href="#" class="border rounded py-1 px-2 mb-2">
                                New
                            </a>

                            <a href="#" class="border rounded py-1 px-2 mb-2">
                                brand
                            </a>

                            <a href="#" class="border rounded py-1 px-2 mb-2">
                                black
                            </a>

                            <a href="#" class="border rounded py-1 px-2 mb-2">
                                white
                            </a>

                            <a href="#" class="border rounded py-1 px-2 mb-2">
                                tablets
                            </a>

                            <a href="#" class="border rounded py-1 px-2 mb-2">
                                phone
                            </a>

                            <a href="#" class="border rounded py-1 px-2 mb-2">
                                camera
                            </a>

                            <a href="#" class="border rounded py-1 px-2 mb-2">
                                drone
                            </a>

                        </div>

                    </div>

                </div>



                <!-- ========================= -->
                <!-- RIGHT SIDE PRODUCT -->
                <!-- ========================= -->

                <div class="col-lg-7 col-xl-9 wow fadeInUp" data-wow-delay="0.1s">


                    <div class="row g-4 single-product">


                        <!-- ========================= -->
                        <!-- PRODUCT IMAGE -->
                        <!-- ========================= -->

                        <div class="col-xl-6">

                            <div class="single-inner bg-light rounded">

                                <img src="<%= product.thumbnail || '/img/product-placeholder.png' %>"
                                    class="img-fluid rounded w-100" alt="<%= product.name %>">

                            </div>

                        </div>



                        <!-- ========================= -->
                        <!-- PRODUCT DETAILS -->
                        <!-- ========================= -->

                        <div class="col-xl-6">


                            <!-- Product Name -->
                            <h4 class="fw-bold mb-3">

                                <%= product.name %>

                            </h4>



                            <!-- Category -->
                            <p class="mb-3">

                                Category:

                                <% if (product.category && product.category.name) { %>

                                    <%= product.category.name %>

                                        <% } else { %>

                                            Uncategorized

                                            <% } %>

                            </p>



                            <!-- Price -->
                            <% if (product.discountPrice && product.discountPrice> 0 &&
                                product.discountPrice < product.price) { %>


                                    <div class="mb-3">

                                        <del class="me-2 fs-5">

                                            ₹<%= Number(product.price).toFixed(2) %>

                                        </del>

                                        <span class="text-primary fs-4">

                                            ₹<%= Number(product.discountPrice).toFixed(2) %>

                                        </span>

                                    </div>


                                    <% } else { %>


                                        <h5 class="fw-bold mb-3">

                                            ₹<%= Number(product.price).toFixed(2) %>

                                        </h5>


                                        <% } %>



                                            <!-- Rating -->
                                            <div class="d-flex mb-4">

                                                <i class="fa fa-star text-secondary"></i>
                                                <i class="fa fa-star text-secondary"></i>
                                                <i class="fa fa-star text-secondary"></i>
                                                <i class="fa fa-star text-secondary"></i>
                                                <i class="fa fa-star"></i>

                                            </div>



                                            <!-- Share Buttons -->
                                            <div class="mb-3">

                                                <div
                                                    class="btn btn-primary d-inline-block rounded text-white py-1 px-4 me-2">

                                                    <i class="fab fa-facebook-f me-1"></i>

                                                    Share

                                                </div>


                                                <div
                                                    class="btn btn-secondary d-inline-block rounded text-white py-1 px-4 ms-2">

                                                    <i class="fab fa-twitter ms-1"></i>

                                                    Share

                                                </div>

                                            </div>



                                            <!-- Product Information -->
                                            <div class="d-flex flex-column mb-3">

                                                <small>

                                                    Product ID:

                                                    <%= product._id %>

                                                </small>


                                                <small>

                                                    Available:

                                                    <% if (product.stock> 0) { %>

                                                        <strong class="text-primary">

                                                            <%= product.stock %> items in stock

                                                        </strong>

                                                        <% } else { %>

                                                            <strong class="text-danger">

                                                                Out of stock

                                                            </strong>

                                                            <% } %>

                                                </small>

                                            </div>



                                            <!-- Description -->
                                            <p class="mb-4">

                                                <%= product.description || 'No description available for this product.'
                                                    %>

                                            </p>



                                            <!-- Quantity -->
                                            <div class="input-group quantity mb-5" style="width:100px;">

                                                <div class="input-group-btn">

                                                    <button type="button"
                                                        class="btn btn-sm btn-minus rounded-circle bg-light border">

                                                        <i class="fa fa-minus"></i>

                                                    </button>

                                                </div>


                                                <input type="text"
                                                    class="form-control form-control-sm text-center border-0" value="1">


                                                <div class="input-group-btn">

                                                    <button type="button"
                                                        class="btn btn-sm btn-plus rounded-circle bg-light border">

                                                        <i class="fa fa-plus"></i>

                                                    </button>

                                                </div>

                                            </div>



                                            <!-- Add To Cart -->
                                            <% if (product.stock> 0) { %>

                                                <a href="/customer/cart/add/<%= product._id %>"
                                                    class="btn btn-primary border border-secondary rounded-pill px-4 py-2 mb-4">

                                                    <i class="fa fa-shopping-bag me-2 text-white"></i>

                                                    Add to cart

                                                </a>

                                                <% } else { %>

                                                    <button type="button"
                                                        class="btn btn-secondary rounded-pill px-4 py-2 mb-4" disabled>

                                                        Out of Stock

                                                    </button>

                                                    <% } %>


                        </div>



                        <!-- ========================= -->
                        <!-- DESCRIPTION / REVIEWS -->
                        <!-- ========================= -->

                        <div class="col-lg-12">

                            <nav>

                                <div class="nav nav-tabs mb-3">


                                    <button class="nav-link active border-white border-bottom-0" type="button"
                                        role="tab" data-bs-toggle="tab" data-bs-target="#nav-about">

                                        Description

                                    </button>


                                    <button class="nav-link border-white border-bottom-0" type="button" role="tab"
                                        data-bs-toggle="tab" data-bs-target="#nav-mission">

                                        Reviews

                                    </button>

                                </div>

                            </nav>



                            <div class="tab-content mb-5">


                                <!-- Description Tab -->
                                <div class="tab-pane active" id="nav-about" role="tabpanel">

                                    <p class="text-dark">

                                        <%= product.description || 'No description available.' %>

                                    </p>

                                </div>



                                <!-- Reviews Tab -->
                                <div class="tab-pane" id="nav-mission" role="tabpanel">

                                    <p class="text-muted">

                                        No reviews yet.

                                    </p>

                                </div>


                            </div>

                        </div>



                        <!-- ========================= -->
                        <!-- REVIEW FORM -->
                        <!-- ========================= -->

                        <div class="col-lg-12">

                            <form action="#">

                                <h4 class="mb-5 fw-bold">
                                    Leave a Reply
                                </h4>


                                <div class="row g-4">


                                    <div class="col-lg-6">

                                        <div class="border-bottom rounded">

                                            <input type="text" class="form-control border-0 me-4"
                                                placeholder="Your Name *">

                                        </div>

                                    </div>



                                    <div class="col-lg-6">

                                        <div class="border-bottom rounded">

                                            <input type="email" class="form-control border-0"
                                                placeholder="Your Email *">

                                        </div>

                                    </div>



                                    <div class="col-lg-12">

                                        <div class="border-bottom rounded my-4">

                                            <textarea class="form-control border-0" cols="30" rows="8"
                                                placeholder="Your Review *"></textarea>

                                        </div>

                                    </div>



                                    <div class="col-lg-12">

                                        <div class="d-flex justify-content-between py-3 mb-5">


                                            <div class="d-flex align-items-center">

                                                <p class="mb-0 me-3">
                                                    Please rate:
                                                </p>

                                                <div class="d-flex align-items-center" style="font-size:12px;">

                                                    <i class="fa fa-star text-muted"></i>
                                                    <i class="fa fa-star"></i>
                                                    <i class="fa fa-star"></i>
                                                    <i class="fa fa-star"></i>
                                                    <i class="fa fa-star"></i>

                                                </div>

                                            </div>


                                            <a href="#"
                                                class="btn btn-primary border border-secondary text-primary rounded-pill px-4 py-3">

                                                Post Comment

                                            </a>


                                        </div>

                                    </div>

                                </div>

                            </form>

                        </div>


                    </div>

                </div>

            </div>

        </div>

    </div>
    <!-- Single Products End -->



    <!-- ========================= -->
    <!-- RELATED PRODUCTS -->
    <!-- ========================= -->

    <div class="container-fluid related-product">

        <div class="container">


            <div class="mx-auto text-center pb-5" style="max-width:700px;">

                <h4
                    class="text-primary mb-4 border-bottom border-primary border-2 d-inline-block p-2 title-border-radius">

                    Related Products

                </h4>

                <p>

                    Explore more products from our store.

                </p>

            </div>



            <div class="row g-4">


                <% if (typeof relatedProducts !=='undefined' && relatedProducts.length> 0) { %>


                    <% relatedProducts.forEach(function(relatedProduct) { %>


                        <div class="col-md-6 col-lg-3">


                            <div class="product-item rounded">


                                <div class="product-item-inner border rounded">


                                    <div class="product-item-inner-item">


                                        <img src="<%= relatedProduct.thumbnail || '/img/product-placeholder.png' %>"
                                            class="img-fluid w-100 rounded-top" alt="<%= relatedProduct.name %>">


                                        <div class="product-details">

                                            <a href="/product/<%= relatedProduct.slug %>">

                                                <i class="fa fa-eye fa-1x"></i>

                                            </a>

                                        </div>


                                    </div>



                                    <div class="text-center rounded-bottom p-4">


                                        <% if (relatedProduct.category && relatedProduct.category.name) { %>

                                            <a href="/shop?category=<%= relatedProduct.category._id %>"
                                                class="d-block mb-2">

                                                <%= relatedProduct.category.name %>

                                            </a>

                                            <% } %>



                                                <a href="/product/<%= relatedProduct.slug %>" class="d-block h5">

                                                    <%= relatedProduct.name %>

                                                </a>



                                                <% if (relatedProduct.discountPrice && relatedProduct.discountPrice> 0
                                                    &&
                                                    relatedProduct.discountPrice < relatedProduct.price) { %>


                                                        <del class="me-2">

                                                            ₹<%= Number(relatedProduct.price).toFixed(2) %>

                                                        </del>


                                                        <span class="text-primary">

                                                            ₹<%= Number(relatedProduct.discountPrice).toFixed(2) %>

                                                        </span>


                                                        <% } else { %>


                                                            <span class="text-primary">

                                                                ₹<%= Number(relatedProduct.price).toFixed(2) %>

                                                            </span>


                                                            <% } %>


                                    </div>


                                </div>


                                <div class="text-center p-3">


                                    <% if (relatedProduct.stock> 0) { %>

                                        <a href="/customer/cart/add/<%= relatedProduct._id %>"
                                            class="btn btn-primary rounded-pill px-4">

                                            <i class="fas fa-shopping-cart me-2"></i>

                                            Add To Cart

                                        </a>

                                        <% } else { %>

                                            <span class="btn btn-secondary rounded-pill px-4">

                                                Out of Stock

                                            </span>

                                            <% } %>


                                </div>


                            </div>


                        </div>


                        <% }); %>


                            <% } else { %>


                                <div class="col-12 text-center">

                                    <p class="text-muted">
                                        No related products found.
                                    </p>

                                </div>


                                <% } %>


            </div>

        </div>

    </div>



    <%- include('layouts/footer') %>