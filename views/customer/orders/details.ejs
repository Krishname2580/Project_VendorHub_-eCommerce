<h2>Order Details</h2>

<h3>

    Order :

    <%= order.orderNumber %>

</h3>

<h3>

    Status :

    <%= order.orderStatus %>

</h3>

<table border="1">

    <tr>

        <th>Product</th>
        <th>Price</th>
        <th>Qty</th>
        <th>Total</th>

    </tr>

    <% orderItems.forEach(item=>{ %>

        <tr>

            <td>

                <%= item.product.name %>

            </td>

            <td>

                ₹ <%= item.price %>

            </td>

            <td>

                <%= item.quantity %>

            </td>

            <td>

                ₹ <%= item.total %>

            </td>

        </tr>

        <% }) %>

</table>
<a href="/invoice/<%= order._id %>" class="btn btn-success">

    Download Invoice

</a>